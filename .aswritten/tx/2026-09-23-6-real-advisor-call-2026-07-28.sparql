        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Without my input through my own lens, it breaks, it falls down. So that shows that the actual unique part is by my lens — is applying the lens, which I suppose is effectively what you've built there... it is the lens that controls all of that." ;
