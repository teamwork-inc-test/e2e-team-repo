        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "You're selling to an audience that wants something like this… they're looking for a solution. You're educating them on how it works and the benefits — not the use case." ;
                oa:prefix "t and memory.\n\n**Tina Team:** " ;
