        narr:context "Advisor Call — 2026-07-28" ;
        skos:note "Voicing network effect user perspective" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I want to have as written because you have as written and that makes my as written more valuable because you have it." ;
                oa:prefix "t, right?\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Freya Free:** Without my i" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
