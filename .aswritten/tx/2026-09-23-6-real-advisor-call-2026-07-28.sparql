        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Go on." ;
                oa:prefix "dge company.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** One of my" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2455"^^xsd:integer ;
                oa:end "2461"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

