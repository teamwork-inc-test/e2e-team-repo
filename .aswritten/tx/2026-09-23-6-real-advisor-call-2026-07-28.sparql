            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "The more calls and decisions that you have ingested into a graph, the graph itself is the moat, right? And like, yes, I'm letting someone store the data in their repo, but the read and manipulation layer is proprietary." ;
                oa:prefix "a new thing.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** I think t" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2951"^^xsd:integer ;
                oa:end "3170"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

