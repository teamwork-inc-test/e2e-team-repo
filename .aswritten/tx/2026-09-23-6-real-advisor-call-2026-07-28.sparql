        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Find a company that's actually a knowledge company that doesn't think of themselves as a knowledge company." ;
                oa:prefix "wn chaos.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** Go on.\n\n**Xa" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2330"^^xsd:integer ;
                oa:end "2437"^^xsd:integer ] ] ;
