        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I think that's true and I'm not disagreeing with that. I just think that like, like the, the core problem is like someone comes along and builds a better version of that, right?" ;
                oa:prefix "prietary.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Xavier Expert:** I want to" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3191"^^xsd:integer ;
                oa:end "3368"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

