        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "One of my operating theses is the telephone company always wins. The telephone company always wins because the telephone company sits in between. And it's impossible to disintermediate because they sit in between." ;
                oa:prefix "** Go on.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Xavier Expert:** If there'" ] ;
