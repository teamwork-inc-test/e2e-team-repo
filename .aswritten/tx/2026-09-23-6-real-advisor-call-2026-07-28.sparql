        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "If there's an incumbent, right, who has a beachhead already, there's nothing that prevents them from like doing a shitty job. But it's enough that like the intrinsic cost of switching would be too high to a new thing." ;
                oa:prefix " between.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** The more cal" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2716"^^xsd:integer ;
                oa:end "2933"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

