    narr:Expr_6RealAdvisorCall20260728_1 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeamowner ;
        narr:act "assertive" ;
        narr:animator narr:Actor_TanyaTeamowner ;
        narr:author narr:Actor_TanyaTeamowner ;
        narr:context "Context paragraph setting up the advisor call transcript" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Tanya Team has pulled three of her advisors onto one call before she starts fundraising, to settle who aswritten sells to first and what keeps them. Tina Team works sales and go-to-market with her; Xavier Expert is an operator who consults for mid-market businesses; Freya Free is a designer who has worked with her on the brand. Each has given Tanya a view on this separately; this is the first time the four of them are on one call." ;
                oa:prefix "xture's composed/ directory.\n\n" ;
                oa:suffix "\n\n# Advisor Call — Tanya Team," ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "422"^^xsd:integer ;
                oa:end "856"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

    narr:Expr_6RealAdvisorCall20260728_2 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I am just starting to fundraise. I'm looking for organizations that want to use the thing. One of the things I've been thinking a lot about is the pricing and whether all of that is too low or sort of how the positioning is here." ;
                oa:prefix "8\n2026-07-28\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** From a B2C pe" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "965"^^xsd:integer ;
                oa:end "1194"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

    narr:Expr_6RealAdvisorCall20260728_3 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "From a B2C perspective, to the single people who are building whole companies on their own. I think that's the angle." ;
                oa:prefix "ning is here.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tina Team:** Think about t" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1211"^^xsd:integer ;
                oa:end "1328"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

    narr:Expr_6RealAdvisorCall20260728_4 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Think about the numbers though, right? The numbers really work. B2C. Because if we take theory that every single person is now their own team." ;
                oa:prefix "'s the angle.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tanya Team:** Maybe that i" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1345"^^xsd:integer ;
                oa:end "1487"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

    narr:Expr_6RealAdvisorCall20260728_5 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Maybe that is the more direct distillation of the shift I'm having is just realizing that it's actually more of a B2C product than a B2B product. And there's still a top tier that's a B2B tier, but the bottom tiers are big and direct and like not that confusing." ;
                oa:prefix "ir own team.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Trying to" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1505"^^xsd:integer ;
                oa:end "1767"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

    narr:Expr_6RealAdvisorCall20260728_6 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Trying to go after tech companies is going to be hard because tech companies all think they've solved the problem." ;
                oa:prefix "onfusing.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** Yeah, I know" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1788"^^xsd:integer ;
                oa:end "1902"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

    narr:Expr_6RealAdvisorCall20260728_7 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Yeah, I know, right? The problem with most developers and entrepreneurs is they've already rolled their own bullshit." ;
                oa:prefix "the problem.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** People like m" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1920"^^xsd:integer ;
                oa:end "2037"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

    narr:Expr_6RealAdvisorCall20260728_8 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "expressive" ;
        narr:context "Advisor Call — 2026-07-28" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_6RealAdvisorCall20260728 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "People like me have 10 repos on the go with Claude right now and... all this tooling and different skills... I'm worried what's going to break or cross over." ;
                oa:prefix "own bullshit.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tina Team:** The more invo" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2054"^^xsd:integer ;
                oa:end "2211"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:57:01Z"^^xsd:dateTime .

    narr:Expr_6RealAdvisorCall20260728_9 a narr:Expression ;
