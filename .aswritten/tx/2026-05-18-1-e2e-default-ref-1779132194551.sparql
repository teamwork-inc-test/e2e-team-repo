INSERT DATA {
  GRAPH narr:Tx_20250825T120000Z {
    narr:Sample_DefaultRefTest_v53 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Tanya testing system behavior when git ref is omitted, confirming topic branch creation." ;
      narr:inputLength 113 .

    narr:Observation_TanyaOmittedRefQuote_v53 a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v53 ;
      skos:note "Tanya's direct assertion regarding topic branch creation on omitted ref." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 60 ;
        oa:end 111
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    narr:StyleObservation_Naming_v53 a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_DefaultRefTest_v53 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v53 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 98 ; oa:end 110 ] ;
        oa:hasSelector [ oa:exact "topic branch" ]
      ] .

    narr:StyleObservation_Tone_v53 a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v53 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v53 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 60 ; oa:end 111 ] ;
        oa:hasSelector [ oa:exact "Testing that omitted ref creates a topic branch." ]
      ] .

    narr:StyleObservation_Jargon_v53 a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v53 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v53 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 84 ; oa:end 87 ] ;
        oa:hasSelector [ oa:exact "ref" ]
      ] .

    narr:StyleMetrics_v53 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v53 ;
      narr:AverageSentenceLength 9 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal ;
