PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    dct:title "Tanya Sprint Retro extraction" ;
    prov:generated
      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Narrative_AsyncWidgetShipped,
      narr:Claim_VelocityRecord,
      narr:Claim_ZephyrKeyUnlock,
      narr:Observation_TanyaQuote,
      narr:StyleObs_DirectSpeakerAttribution,
      narr:StyleObs_TechnicalJargon,
      narr:StyleObs_CausalUnlockPhrasing,
      narr:StyleMetrics_TanyaSprintRetro .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength "198"^^xsd:integer ;
      dct:description "Sprint retrospective note attributed to Tanya, reporting shipped async decision widget, velocity of 23 points (highest this quarter), and Zephyr integration as key unlock." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes. Reviewer phone number redacted (PII)." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_AsyncWidgetShipped a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Shipping velocity milestone enabled by integration unlock" ;
      skos:broader narr:Proof ;
      skos:note "The team shipped the async decision widget in a sprint that achieved 23 points — the highest velocity this quarter — attributed to the Zephyr integration as the key enabling factor." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_VelocityRecord a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetShipped ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncWidgetShipped ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points, stated as highest this quarter. Single-speaker assertion; conviction level Stake pending corroboration." .

    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetShipped ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Narrative_AsyncWidgetShipped ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity milestone to the Zephyr integration as 'the key unlock'. Causal attribution from single speaker; conviction level Notion." .

    # ── Observation (grounded quote) ────────────────────────────
    narr:Observation_TanyaQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's verbatim retrospective statement covering shipped widget, velocity record, and Zephyr attribution." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "69"^^xsd:integer ;
        oa:end "197"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. Direct speaker attribution pattern
    narr:StyleObs_DirectSpeakerAttribution a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Speaker name followed by colon and quoted speech — a direct attribution pattern that grounds claims in a named individual." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "62"^^xsd:integer ;
          oa:end "75"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"We shipped" ;
          oa:prefix "\n\n" ;
          oa:suffix " the async decision widget."
        ]
      ] .

    # 2. Technical jargon density — product/engineering terminology
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Compact engineering vocabulary: 'async decision widget', 'Zephyr integration', 'velocity' (Agile metric). High jargon density for a short utterance." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "70"^^xsd:integer ;
          oa:end "107"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "the async decision widget" ;
          oa:prefix "We shipped " ;
          oa:suffix ". Velocity was 23 points"
        ]
      ] .

    # 3. Causal 'key unlock' phrasing — rhetorical attribution device
    narr:StyleObs_CausalUnlockPhrasing a narr:StyleObservation ;
      skos:broader narr:Metaphor ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "'The key unlock' is a metaphorical causal attribution phrase common in tech/product discourse, framing an integration as the enabling mechanism." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "154"^^xsd:integer ;
          oa:end "197"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The Zephyr integration was the key unlock." ;
          oa:prefix "highest this quarter. " ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "10"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.25"^^xsd:decimal ;
      skos:note "Three short declarative sentences averaging ~10 words each. 100% active voice. High jargon density (~25%) given 'async decision widget', 'velocity', 'Zephyr integration'. Register: informal spoken retrospective." .

  }
}