        narr:act "directive" ;
        narr:context "Cutover sequencing discussion" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Hold those for ten minutes. Sequencing first. Tina, you've been living in the site plan — where are we?" ;
                oa:prefix "u want them.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** Four sites. N" ] ;
