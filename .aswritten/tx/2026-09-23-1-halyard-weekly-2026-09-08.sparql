    narr:Expr_1HalyardWeekly20260908_5 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Cutover sequencing discussion" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Four sites. Northgate, Dockside, Ferry Road, and Clyde. Northgate is the smallest and the cleanest, Clyde is the one nobody wants to touch." ;
