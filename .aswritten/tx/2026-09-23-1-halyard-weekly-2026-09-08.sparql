        narr:context "Cutover sequencing discussion" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "And the question on the table is whether we take them together or one at a time." ;
                oa:prefix "ts to touch.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** That's the qu" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "861"^^xsd:integer ;
                oa:end "941"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_7 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Cutover sequencing discussion" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's the question." ;
                oa:prefix "ne at a time.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tanya Team:** Then let me " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "958"^^xsd:integer ;
                oa:end "978"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_8 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "declarative" ;
        narr:context "Cutover sequencing decision" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Then let me say where I've landed, because I don't think I'm going to move off it. We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one. No parallel cutovers, not even for the two small ones." ;
                oa:prefix "he question.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** I'm with you " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "996"^^xsd:integer ;
                oa:end "1251"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_9 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "expressive" ;
        narr:context "Cutover sequencing decision" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I'm with you on that." ;
                oa:prefix "o small ones.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Can I pus" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1268"^^xsd:integer ;
