            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "The vendor stays the system of record for reference data until the last site is live. Every site reads from the vendor's copy, we mirror it read-only, and we take ownership on the day Clyde goes green and not a day earlier." ;
