            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "This is the one I keep going round on. The vendor holds the reference tables — carrier codes, service levels, the zone map. We can take a copy at any point. The question is when we become the system of record for them." ;
