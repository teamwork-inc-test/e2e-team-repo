            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "So the position I want us to take is: during cutover, every reporting read comes off the replica. Not \"should\", not \"where possible\" — reporting does not touch the live system during a cutover window, full stop." ;
