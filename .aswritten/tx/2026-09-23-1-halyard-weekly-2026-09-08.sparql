            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Please." ;
                oa:prefix "y push here.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** The argum" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1451"^^xsd:integer ;
                oa:end "1458"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_12 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Debating parallel cutover vs sequential" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "The argument for taking Northgate and Ferry Road together is that they share a dispatch desk. If you split them, the desk runs two systems for however long the soak is, and that's the thing the desk supervisor has been shouting about since June." ;
                oa:prefix "* Please.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** It is. And I" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1479"^^xsd:integer ;
                oa:end "1724"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_13 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Debating parallel cutover vs sequential" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "It is. And I've thought about it, and I still think it's the wrong trade. Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ;
                oa:prefix " since June.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** That's a " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1742"^^xsd:integer ;
                oa:end "2005"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_14 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Debating parallel cutover vs sequential" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's a fair answer. I'd put it to them exactly that way — contained versus unbounded." ;
                oa:prefix "nd it to.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tina Team:** And the desk " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2026"^^xsd:integer ;
                oa:end "2113"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_15 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Debating parallel cutover vs sequential" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "And the desk supervisor's pain is a rota problem, which is solvable. A double cutover is a staffing problem and a data problem at the same time, which isn't." ;
                oa:prefix "us unbounded.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tanya Team:** Right. So: o" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2130"^^xsd:integer ;
                oa:end "2287"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_16 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Establishing soak duration" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Right. So: one at a time, with a soak." ;
                oa:prefix "which isn't.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** Agreed, and I" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2305"^^xsd:integer ;
                oa:end "2343"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_17 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "directive" ;
        narr:context "Establishing soak duration" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Agreed, and I want to put a number on the soak, because \"a soak\" without a number turns into three days the first time someone's under pressure. The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ;
                oa:prefix " with a soak.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tanya Team:** Say more abo" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2360"^^xsd:integer ;
                oa:end "2583"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_18 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "directive" ;
        narr:context "Establishing soak duration" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Say more about where two weeks comes from." ;
                oa:prefix "ld us to it.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** Dockside pilo" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2601"^^xsd:integer ;
                oa:end "2643"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_19 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Establishing soak duration" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Dockside pilot, back in the spring. We watched the exception queue after go-live and it didn't flatten out until day nine or ten. Two weeks gives you the flattening plus a few days to actually look at what flattened. Anything less and you're starting the next site while you're still finding out what the last one did." ;
                oa:prefix "s comes from.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tanya Team:** That's the r" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2660"^^xsd:integer ;
                oa:end "2978"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_20 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "declarative" ;
        narr:context "Establishing soak duration" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's the reasoning I wanted on the record. Two weeks, from the Dockside exception curve." ;
                oa:prefix "ast one did.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** I'll note" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2996"^^xsd:integer ;
                oa:end "3086"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_21 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Establishing soak duration" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I'll note that the exception curve is the only evidence we have for it. It's one site, one season." ;
                oa:prefix "on curve.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tina Team:** It's one site" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3107"^^xsd:integer ;
                oa:end "3205"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_22 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Establishing soak duration" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "It's one site, one season, and it's the only site we've actually done. I'd rather hold two weeks and shorten it with evidence than hold one week and discover we needed two." ;
                oa:prefix ", one season.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tanya Team:** Agreed. Xavi" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3222"^^xsd:integer ;
                oa:end "3394"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_23 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "directive" ;
        narr:context "Reporting replica during cutover" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Agreed. Xavier, replica numbers." ;
                oa:prefix " needed two.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Right. Du" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3412"^^xsd:integer ;
                oa:end "3444"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

    narr:Expr_1HalyardWeekly20260908_24 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Reporting replica during cutover" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Right. During a cutover window the live system is under load it has never seen — the migration job, the dual-write, and whatever the site is actually doing that day. Reporting on top of that is what took Dockside down for forty minutes." ;
                oa:prefix " numbers.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** I remember t" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3465"^^xsd:integer ;
                oa:end "3701"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T01:41:57Z"^^xsd:dateTime .

