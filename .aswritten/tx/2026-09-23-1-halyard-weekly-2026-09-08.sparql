        narr:act "question" ;
        narr:context "Debating parallel cutover vs sequential" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_1HalyardWeekly20260908 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Can I push on it for a second? Not because I disagree — because the steering group will push and I'd rather they push here." ;
                oa:prefix " on that.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** Please.\n\n**X" ] ;
