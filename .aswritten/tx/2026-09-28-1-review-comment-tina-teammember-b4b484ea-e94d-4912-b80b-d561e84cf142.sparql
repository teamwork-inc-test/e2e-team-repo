    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_5 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Can I say that I think this is the right correction and also that it costs us something? Two weeks was conservative in a place where being conservative was cheap. One week is defensible but it has no slack in it." ;
                oa:prefix "ments this change added:\n\n  > " ;
                oa:suffix "\n\n  > That's true. I'd rather " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1612"^^xsd:integer ;
                oa:end "1824"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_6 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's true. I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ;
                oa:prefix "t it has no slack in it.\n\n  > " ;
                oa:suffix "\n\n  > Agreed. I just want it o" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1830"^^xsd:integer ;
                oa:end "1962"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_7 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Agreed. I just want it on the record that the new number is tight, not safe." ;
                oa:prefix "ned out to be imaginary.\n\n  > " ;
                oa:suffix "\n\n  > Right. For the record th" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1968"^^xsd:integer ;
                oa:end "2044"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_8 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "declarative" ;
        narr:context "Halyard Cutover Review, 15 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Right. For the record then: the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ;
                oa:prefix "mber is tight, not safe.\n\n  > " ;
                oa:suffix "\n\n  > On the eighth I said the" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2050"^^xsd:integer ;
                oa:end "2204"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_9 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "directive" ;
        narr:context "Halyard Cutover Review, 15 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "On the eighth I said the soak between sites has to be two full weeks, and I said I'd hold us to it. That was wrong. I was wrong on the eighth and I want it struck from the plan." ;
                oa:prefix "d as superseded by this.\n\n  > " ;
                oa:suffix "\n\n  > I quoted the Dockside nu" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2210"^^xsd:integer ;
                oa:end "2387"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_10 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I quoted the Dockside number — the exception queue not flattening until day nine or ten. I went back through the Dockside logs on Friday because Xavier's comment about it being one site, one season was bothering me. The reason the queue took nine days to flatten at Dockside is that the old reconciliation job ran weekly and every run threw a fresh batch of exceptions. Two weeks was two reconciliation cycles. It was never about the site settling." ;
                oa:prefix "it struck from the plan.\n\n  > " ;
                oa:suffix "\n\n  > That job is gone. It was" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2393"^^xsd:integer ;
                oa:end "2841"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_11 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That job is gone. It was retired in July. Nothing in the new platform runs on a weekly cycle — reconciliation is continuous now. So the number I gave was measuring a job that doesn't exist any more, and I attached it to the soak as though it were a property of the site." ;
                oa:prefix "about the site settling.\n\n  > " ;
                oa:suffix "\n\n  > One week. Strip the reco" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2847"^^xsd:integer ;
                oa:end "3117"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_12 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "directive" ;
        narr:context "Halyard Cutover Review, 15 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "One week. Strip the reconciliation cycles out of the Dockside curve and the underlying exception rate is flat by day four. One week gives you the flattening plus three days to look at it, which is the same margin I was arguing for. One week is the soak, and please don't hold the plan to two weeks on my say-so, because I was wrong on the eighth." ;
                oa:prefix " a property of the site.\n\n  > " ;
                oa:suffix "\n\n- Statements this change rem" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3123"^^xsd:integer ;
                oa:end "3469"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_13 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "commissive" ;
        narr:context "Halyard Weekly, 8 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Agreed, and I want to put a number on the soak, because \"a soak\" without a number turns into three days the first time someone's under pressure. The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ;
                oa:prefix "nts this change removed:\n\n  > " ;
                oa:suffix "\n\n  > Dockside pilot, back in " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3510"^^xsd:integer ;
                oa:end "3733"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_14 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Weekly, 8 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Dockside pilot, back in the spring. We watched the exception queue after go-live and it didn't flatten out until day nine or ten. Two weeks gives you the flattening plus a few days to actually look at what flattened. Anything less and you're starting the next site while you're still finding out what the last one did." ;
                oa:prefix ", and I'd hold us to it.\n\n  > " ;
                oa:suffix "\n\n  > That's the reasoning I w" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3739"^^xsd:integer ;
                oa:end "4057"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_15 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Weekly, 8 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's the reasoning I wanted on the record. Two weeks, from the Dockside exception curve." ;
                oa:prefix "t what the last one did.\n\n  > " ;
                oa:suffix "\n\n  > It's one site, one seaso" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "4063"^^xsd:integer ;
                oa:end "4153"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_16 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Weekly, 8 Sep" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "It's one site, one season, and it's the only site we've actually done. I'd rather hold two weeks and shorten it with evidence than hold one week and discover we needed two." ;
                oa:prefix "ockside exception curve.\n\n  > " ;
                oa:suffix "\n\n### The position's statement" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "4159"^^xsd:integer ;
                oa:end "4331"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_17 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard Weekly, 8 Sep, line 53" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I'll note that the exception curve is the only evidence we have for it. It's one site, one season." ;
                oa:prefix "curve.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "5182"^^xsd:integer ;
                oa:end "5280"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_18 a narr:Expression ;
        narr:actor narr:Actor_FreyaFree ;
        narr:act "directive" ;
        narr:context "Halyard Ops Readiness, 15 Sep, line 51" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "The dates, as early as you can give them, and a commitment that a soak doesn't get shortened because a date slipped. If the soak gets eaten, my supervisors are back on the floor at the same time as the next cutover and we're in the same place by another route." ;
                oa:prefix "om me?\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "6137"^^xsd:integer ;
                oa:end "6397"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_19 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "commissive" ;
        narr:context "Halyard Ops Readiness, 15 Sep, line 53" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's fair and I'll hold it." ;
                oa:prefix "route.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "7124"^^xsd:integer ;
                oa:end "7153"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_20 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "directive" ;
        narr:context "Halyard Cutover Review, 15 Sep, line 17" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "On the eighth I said the soak between sites has to be two full weeks, and I said I'd hold us to it. That was wrong. I was wrong on the eighth and I want it struck from the plan." ;
                oa:prefix "ahead.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "7721"^^xsd:integer ;
                oa:end "7898"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_21 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep, line 21" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I quoted the Dockside number — the exception queue not flattening until day nine or ten. I went back through the Dockside logs on Friday because Xavier's comment about it being one site, one season was bothering me. The reason the queue took nine days to flatten at Dockside is that the old reconciliation job ran weekly and every run threw a fresh batch of exceptions. Two weeks was two reconciliation cycles. It was never about the site settling." ;
                oa:prefix "e why.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "8955"^^xsd:integer ;
                oa:end "9403"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_22 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep, line 25" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That job is gone. It was retired in July. Nothing in the new platform runs on a weekly cycle — reconciliation is continuous now. So the number I gave was measuring a job that doesn't exist any more, and I attached it to the soak as though it were a property of the site." ;
                oa:prefix " gone.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "10563"^^xsd:integer ;
                oa:end "10833"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_23 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "directive" ;
        narr:context "Halyard Cutover Review, 15 Sep, line 29" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "One week. Strip the reconciliation cycles out of the Dockside curve and the underlying exception rate is flat by day four. One week gives you the flattening plus three days to look at it, which is the same margin I was arguing for. One week is the soak, and please don't hold the plan to two weeks on my say-so, because I was wrong on the eighth." ;
                oa:prefix " soak?\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "11883"^^xsd:integer ;
                oa:end "12229"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_24 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep, line 37" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Can I say that I think this is the right correction and also that it costs us something? Two weeks was conservative in a place where being conservative was cheap. One week is defensible but it has no slack in it." ;
                oa:prefix "s had.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "13141"^^xsd:integer ;
                oa:end "13353"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_25 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep, line 39" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's true. I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ;
                oa:prefix "in it.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "14315"^^xsd:integer ;
                oa:end "14447"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_26 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard Cutover Review, 15 Sep, line 41" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Agreed. I just want it on the record that the new number is tight, not safe." ;
                oa:prefix "inary.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "15323"^^xsd:integer ;
                oa:end "15399"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_27 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "declarative" ;
        narr:context "Halyard Cutover Review, 15 Sep, line 51" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Right. For the record then: the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ;
                oa:prefix "ed so.\n\n  The statement:\n\n  > " ;
                oa:suffix "\n\n  The lines after it:\n\n  > *" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "16019"^^xsd:integer ;
                oa:end "16173"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-28T01:05:23Z"^^xsd:dateTime .

    narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_28 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "question" ;
        narr:context "Beside the position in narrative context" ;
