            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "how should multi-site cutovers be sequenced when operational containment conflicts with local site friction?" ;
                oa:prefix "d risk\n\n  - Beside it:\n\n    > " ;
                oa:suffix "\n\n- Stratum: cutover strategy\n" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
