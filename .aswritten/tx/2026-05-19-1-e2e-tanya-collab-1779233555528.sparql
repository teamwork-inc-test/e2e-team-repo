      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrUnlockVelocityRecord ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity outcome causally to the Zephyr integration ('was the key unlock'). Conviction is Stake rather than Boulder because causal attribution is asserted by one speaker without corroborating evidence." .

    # ── Observation (verbatim quote) ─────────────────────────────
    narr:Obs_TanyaVerbatimQuote a narr:Observation ;
