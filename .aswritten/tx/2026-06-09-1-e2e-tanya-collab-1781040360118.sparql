# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      dct:description "Sprint retrospective note from Tanya covering shipped async decision widget, velocity of 23 points (highest this quarter), and Zephyr integration as key unlock." ;
      narr:inputLength 220 .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting on delivery outcomes in retrospective. Reviewer contact redacted per PII policy." .

    # ── Narratives ──────────────────────────────────────────────
    narr:Narrative_AsyncDecisionWidgetShipped a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Async decision widget shipped" ;
      skos:broader narr:Outcomes ;
      skos:note "The team successfully shipped the async decision widget this sprint, representing a concrete delivery milestone." .

    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Zephyr integration as velocity unlock" ;
      skos:broader narr:DependenciesIntegrations ;
      skos:note "The Zephyr integration is identified as the key enabler behind the team's highest-velocity sprint this quarter, framing integrations as force multipliers." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_VelocityHighestThisQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncDecisionWidgetShipped ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncDecisionWidgetShipped ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points, asserted as highest this quarter. Single-source claim from sprint retro; conviction level Stake pending corroboration from sprint tracking data." .

    narr:Claim_ZephyrWasKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity peak directly to the Zephyr integration. Causal claim from single retrospective speaker; Stake conviction pending broader team confirmation." .

    # ── Observations ────────────────────────────────────────────
    narr:Obs_ShippedAsyncWidget a narr:Observation ;
      skos:broader narr:CaseResults ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya confirms the async decision widget was shipped this sprint." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 79 ;
        oa:end 117
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix " Velocity was 23"
      ] .

    narr:Obs_Velocity23Points a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Sprint velocity recorded at 23 points, stated as highest this quarter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 118 ;
        oa:end 165
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter." ;
        oa:prefix "shipped the async decision widget. " ;
        oa:suffix " The Zephyr integration"
      ] .

    narr:Obs_ZephyrKeyUnlock a narr:Observation ;
      skos:broader narr:DependenciesIntegrations ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration named as the key unlock enabling the velocity peak." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 166 ;
        oa:end 213
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock." ;
        oa:prefix "highest this quarter. " ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_FirstPersonPluralVoice a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Active first-person plural voice ('We shipped') used for team ownership framing." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 79 ;
          oa:end 117
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was 23"
        ]
      ] .

    narr:StyleObs_MetricAssertion a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Bare numeric assertion ('Velocity was 23 points') without hedging — authoritative declarative tone typical of sprint reporting." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 118 ;
          oa:end 165
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Velocity was 23 points, highest this quarter." ;
          oa:prefix "shipped the async decision widget. " ;
          oa:suffix " The Zephyr integration"
        ]
      ] .

    narr:StyleObs_KeyUnlockIdiom a narr:StyleObservation ;
      skos:broader narr:IdiolectPhrasing ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "'Key unlock' is a product/engineering idiom used to attribute causal credit to a dependency. Signals tech-native register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 166 ;
          oa:end 213
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The Zephyr integration was the key unlock." ;
          oa:prefix "highest this quarter. " ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal ;
      skos:note "Three short declarative sentences. 100% active voice. Jargon density ~15% driven by 'async', 'Zephyr', 'key unlock'. Terse sprint-report register." .

  }
