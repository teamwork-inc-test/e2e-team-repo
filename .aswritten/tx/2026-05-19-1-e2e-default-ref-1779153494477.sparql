# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250827T120000Z {

    # Sample
    narr:Sample_DefaultRefTest_v55 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v55) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 ;
      narr:styleProfile "<https://aswritten.ai/narrative#JargonPolicy>\n<https://aswritten.ai/narrative#SpeakerIdiolects>\n<https://aswritten.ai/narrative#ToneDirectPersonal>" .

    # Observation — Tanya's quote
    narr:Obs_DefaultRefTest_v55_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v55 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 96 ;
        oa:end 152
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # Style Observation 1 — Direct personal tone
    narr:StyleObs_DefaultRefTest_v55_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v55 ;
      skos:note "First-person attributed quote from named speaker (Tanya) in direct declarative register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v55 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 88 ;
          oa:end 152
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    # Style Observation 2 — Jargon policy (technical terms: ref, topic branch)
    narr:StyleObs_DefaultRefTest_v55_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v55 ;
      skos:note "Technical git jargon used without definition: 'ref' and 'topic branch'. Consistent with engineering-audience register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v55 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 96 ;
          oa:end 152
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Testing that omitted ref creates a topic branch." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # Style Observation 3 — Speaker idiolect (attributed quote pattern)
    narr:StyleObs_DefaultRefTest_v55_SpeakerIdiolects a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v55 ;
      skos:note "Speaker attribution pattern: 'Name: \"quote\"' — consistent idiolect marker used across all DefaultRefTest extractions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v55 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 88 ;
          oa:end 96
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: " ;
          oa:prefix "\n\n" ;
          oa:suffix "\"Testing"
        ]
      ] .

    # Style Metrics
    narr:StyleMetrics_DefaultRefTest_v55 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v55 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v54 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

  }
}