      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncWidgetVelocityRecord ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration is attributed as the key unlock enabling the velocity record; causal claim from a single speaker." .

    # ── Observations ────────────────────────────────────────────
    narr:Obs_AsyncWidgetShipped a narr:Observation ;
      skos:broader narr:CaseResults ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Shipped artifact: async decision widget" ;
      oa:hasSelector [
