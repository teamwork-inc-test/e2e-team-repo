# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250814T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_DefaultRefTest_v40 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v40) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 .

    # ── Observation: Tanya quote ─────────────────────────────────
    narr:Obs_DefaultRefTest_v40_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v40 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 83 ;
        oa:end 143
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations (minimum 3) ───────────────────────────

    # 1. Tone: Direct/Personal — Tanya speaks in first-person imperative register
    narr:StyleObs_DefaultRefTest_v40_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v40 ;
      skos:note "Speaker attribution ('Tanya:') with direct declarative assertion. Informal test-note register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v40 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 76 ;
          oa:end 143
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. Jargon Policy — technical terms 'ref' and 'topic branch' used without definition
    narr:StyleObs_DefaultRefTest_v40_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v40 ;
      skos:note "Git-domain jargon ('ref', 'topic branch') used without definition, presupposing technical audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v40 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 96 ;
          oa:end 143
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch" ;
          oa:prefix "Testing that " ;
          oa:suffix ".\""
        ]
      ] .

    # 3. Speaker Idiolect — named attribution pattern ('Tanya: "..."')
    narr:StyleObs_DefaultRefTest_v40_SpeakerIdiolect a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v40 ;
      skos:note "Speaker-colon-quote attribution format ('Tanya: \"...\"') is the document's sole rhetorical structure." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v40 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 76 ;
          oa:end 83
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: " ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix "\"Testing"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_DefaultRefTest_v40 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v40 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v39 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

  }
}