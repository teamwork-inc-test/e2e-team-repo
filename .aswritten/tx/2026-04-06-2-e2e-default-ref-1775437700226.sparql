# Transaction Provenance
INSERT DATA {
  narr:Tx_20250714T120001Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T12:00:01Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "add" ;
    narr:originRef "topic-branch-test" ;
    prov:generated narr:Sample_DefaultRefTest_v2, narr:StyleObservation_QuotationMarks, narr:StyleObservation_TechnicalJargon, narr:StyleObservation_DirectAddress, narr:StyleMetrics_DefaultRefTest_v2 .
} ;

# Extracted Entities
INSERT DATA {
  GRAPH narr:Tx_20250714T120001Z {
    narr:Sample_DefaultRefTest_v2 a narr:Sample ;
      dct:title "Default Ref Test" ;
      narr:inputLength 113 ;
      dct:description "Tanya testing system behavior when git ref is omitted." .

    narr:StyleObservation_QuotationMarks a narr:StyleObservation ;
      skos:broader narr:PunctuationTypography ;
      dct:source narr:Sample_DefaultRefTest_v2 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v2 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 65 ; oa:end 112 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "\"Testing that omitted ref creates a topic branch.\"" ; oa:prefix "Tanya: " ]
      ] ;
      skos:note "Use of straight double quotes for attributed speech." .

    narr:StyleObservation_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v2 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v2 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 97 ; oa:end 111 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "topic branch" ; oa:prefix "creates a " ; oa:suffix ".\"" ]
      ] ;
      skos:note "Technical git terminology used in a functional test context." .

    narr:StyleObservation_DirectAddress a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v2 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v2 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 58 ; oa:end 63 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "Tanya" ; oa:suffix ": \"Testing" ]
      ] ;
      skos:note "Attribution via name prefix followed by colon." .

    narr:StyleMetrics_DefaultRefTest_v2 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v2 ;
      narr:AverageSentenceLength 9 ;
      narr:ActiveVoiceRatio 1.0 ;
      narr:JargonDensity 0.22 ;
      skos:note "Extremely concise test note with high active voice." .
  }
}