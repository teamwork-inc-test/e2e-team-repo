# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      dct:created "2025-01-15"^^xsd:date ;
      narr:inputLength "196"^^xsd:integer ;
      skos:note "Sprint retrospective note from Tanya. Reviewer phone number in frontmatter redacted per PII policy. Single speaker quote covering three claims: widget shipped, velocity record, Zephyr unlock." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting on retrospective outcomes. Sole named speaker in this memory." .

    # ── Narratives ──────────────────────────────────────────────
    narr:Narrative_AsyncWidgetShipped a narr:Narrative ;
      narr:theme "Shipping async decision widget" ;
      skos:broader narr:Milestones ;
      skos:note "The team successfully shipped the async decision widget during this sprint, marking a delivery milestone." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Narrative_VelocityRecordQ a narr:Narrative ;
      narr:theme "Record sprint velocity this quarter" ;
      skos:broader narr:NorthStarMetrics ;
      skos:note "Sprint velocity reached 23 points, the highest recorded this quarter, signalling accelerating team throughput." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      narr:theme "Zephyr integration as key unlock" ;
      skos:broader narr:DependenciesIntegrations ;
      skos:note "The Zephyr integration is identified as the enabling factor (key unlock) behind the velocity and delivery gains this sprint." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_AsyncWidgetShipped a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetShipped ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_AsyncWidgetShipped ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya directly asserts the async decision widget was shipped this sprint." .

    narr:Claim_Velocity23Points a narr:Claim ;
      narr:aboutNode narr:Narrative_VelocityRecordQ ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_VelocityRecordQ ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points, stated as the highest this quarter. Specific numeric claim from the speaker." .

    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the sprint gains to Zephyr integration as the key unlock. Causal attribution — conviction set to Stake as it is one speaker's assessment." .

    # ── Observations ────────────────────────────────────────────
    narr:Obs_AsyncWidgetShipped a narr:Observation ;
      skos:broader narr:Milestones ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Direct quote: widget shipped this sprint." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "69"^^xsd:integer ;
        oa:end "105"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix " Velocity was 23 points"
      ] .

    narr:Obs_Velocity23 a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity metric: 23 points, highest this quarter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "107"^^xsd:integer ;
        oa:end "151"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter." ;
        oa:prefix "async decision widget. " ;
        oa:suffix " The Zephyr integration"
      ] .

    narr:Obs_ZephyrUnlock a narr:Observation ;
      skos:broader narr:DependenciesIntegrations ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Causal attribution: Zephyr integration identified as the key unlock for sprint performance." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "153"^^xsd:integer ;
        oa:end "195"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock." ;
        oa:prefix "highest this quarter. " ;
        oa:suffix "\""
      ] .

    # ── Style Observations (minimum 3) ──────────────────────────

    # Style Obs 1: First-person plural voice
    narr:StyleObs_FirstPersonPlural a narr:StyleObservation ;
      skos:broader narr:FirstPerson ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Speaker uses first-person plural ('We shipped') to attribute delivery to the team collectively, not to herself alone. Inclusive team voice." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "69"^^xsd:integer ;
          oa:end "79"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped" ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " the async decision"
        ]
      ] .

    # Style Obs 2: Technical product jargon — compound noun phrase
    narr:StyleObs_NominalizedTechJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "'async decision widget' is a dense compound noun phrase using technical product jargon (async, widget) typical of engineering sprint discourse. No definition provided — assumes shared context." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "84"^^xsd:integer ;
          oa:end "104"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget" ;
          oa:prefix "shipped the " ;
          oa:suffix ". Velocity was"
        ]
      ] .

    # Style Obs 3: Metaphor — 'key unlock'
    narr:StyleObs_KeyUnlockMetaphor a narr:StyleObservation ;
      skos:broader narr:Metaphor ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "'key unlock' is a product/tech metaphor for a critical enabler or dependency resolution. Common in engineering and product discourse to signal causal leverage." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "184"^^xsd:integer ;
          oa:end "194"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "key unlock" ;
          oa:prefix "was the " ;
          oa:suffix ".\""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.25"^^xsd:decimal ;
      skos:note "Three short declarative sentences averaging ~9 words each. All active voice. Jargon density ~25% driven by 'async', 'widget', 'Zephyr integration', 'key unlock'. Register: informal engineering retro, first-person plural, high confidence tone." .

  }
}