# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250714T153000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_ReviewerVerification a narr:Sample ;
      dct:title "Reviewer Verification" ;
      dct:description "Minimal YAML-frontmatter document testing that a phone-number reviewer entry is injected into frontmatter. Contains a single speaker quote from Tanya. Phone number redacted per PII policy." ;
      dct:created "2025-07-14"^^xsd:date ;
      narr:inputLength 130 .

    # ── Claim: reviewer phone injected into frontmatter ─────────
    narr:Claim_ReviewerPhoneInjectedFrontmatter a narr:Claim ;
      dct:source narr:Sample_ReviewerVerification ;
      skos:note "The YAML frontmatter of this document includes a reviewers list with one phone-number entry (redacted per PII policy). Tanya asserts this tests that the phone reviewer is injected into frontmatter. Conviction is Notion — single-speaker test assertion, not yet validated by broader evidence." ;
      narr:aboutNode narr:Sample_ReviewerVerification ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Process .

    # ── Observation: Tanya verbatim quote ───────────────────────
    narr:Obs_TanyaReviewerInjectionQuote a narr:Observation ;
      dct:source narr:Sample_ReviewerVerification ;
      skos:broader narr:Quotes ;
      skos:note "Tanya's verbatim test assertion about phone reviewer injection into frontmatter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 68 ;
        oa:end 130
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that the phone reviewer is injected into frontmatter." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # SO-1: Active voice — Tanya's quote uses active gerund construction
    narr:StyleObs_ReviewerVerification_ActiveVoice a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_ReviewerVerification ;
      skos:note "Active gerund construction ('Testing that...') — speaker frames the action as ongoing and direct." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ReviewerVerification ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 76 ;
          oa:end 130
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Testing that the phone reviewer is injected into frontmatter." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # SO-2: Jargon — technical terms 'frontmatter' and 'reviewer' used precisely
    narr:StyleObs_ReviewerVerification_JargonFrontmatter a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_ReviewerVerification ;
      skos:note "Document uses 'frontmatter' and 'reviewer' as precise technical terms without definition — assumes developer/ops audience familiarity." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ReviewerVerification ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 0 ;
          oa:end 40
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "reviewers:" ;
          oa:prefix "---\n" ;
          oa:suffix "\n  - [REDACTED]"
        ]
      ] .

    # SO-3: Direct personal tone — first-name speaker attribution
    narr:StyleObs_ReviewerVerification_DirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_ReviewerVerification ;
      skos:note "Speaker identified by first name only ('Tanya:') followed by a direct quoted assertion — informal, conversational, test-note register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_ReviewerVerification ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 60 ;
          oa:end 75
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya:" ;
          oa:prefix "# Reviewer Verification\n\n" ;
          oa:suffix " \"Testing"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_ReviewerVerification a narr:StyleMetrics ;
      dct:source narr:Sample_ReviewerVerification ;
      skos:broader narr:StyleMetrics ;
      skos:note "Extremely short document (130 chars, 1 substantive sentence). Active voice dominates. Jargon density moderate — 'frontmatter' and 'reviewer' are technical terms in a 10-word sentence. Register: informal test-note." ;
      narr:AverageSentenceLength 10 ;
      narr:ActiveVoiceRatio "0.85"^^xsd:decimal ;
      narr:JargonDensity "0.20"^^xsd:decimal .

  }
}