PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "" ;
    narr:originRef "main" ;
    dct:title "Tanya Sprint Retro extraction" ;
    prov:generated
      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Narrative_SprintVelocityRecord,
      narr:Claim_AsyncWidgetShipped,
      narr:Claim_Velocity23Points,
      narr:Claim_ZephyrIntegrationKeyUnlock,
      narr:Observation_TanyaQuote,
      narr:StyleObs_FirstPersonQuote,
      narr:StyleObs_TechnicalJargon,
      narr:StyleObs_ShortPunchyCadence,
      narr:StyleMetrics_TanyaSprintRetro .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 213 ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, record velocity of 23 points, and Zephyr integration as key unlock. Reviewer frontmatter contains redacted PII." .

    # ── Actor ────────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes. First-name-only speaker in retro note; domain suffix _SprintRetro added to avoid collisions." .

    # ── Narrative ────────────────────────────────────────────────
    narr:Narrative_SprintVelocityRecord a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Sprint team achieves record velocity by shipping key integration unlock" ;
      skos:broader narr:KPIsSuccess ;
      skos:note "The sprint retro asserts that shipping the async decision widget, enabled by the Zephyr integration, produced the highest velocity of the quarter (23 points). The integration is framed as the causal unlock, not incremental effort." .

    # ── Claims ───────────────────────────────────────────────────
    narr:Claim_AsyncWidgetShipped a narr:Claim ;
      narr:aboutNode narr:Narrative_SprintVelocityRecord ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_SprintVelocityRecord ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya states the async decision widget was shipped this sprint." .

    narr:Claim_Velocity23Points a narr:Claim ;
      narr:aboutNode narr:Narrative_SprintVelocityRecord ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_SprintVelocityRecord ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points, stated as highest this quarter." .

    narr:Claim_ZephyrIntegrationKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_SprintVelocityRecord ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_SprintVelocityRecord ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "The Zephyr integration is identified as the key unlock enabling the record velocity sprint." .

    # ── Observation (grounded quote) ─────────────────────────────
    narr:Observation_TanyaQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's verbatim retrospective statement covering shipped widget, velocity, and Zephyr integration." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 62 ;
          oa:end 180
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Observations ───────────────────────────────────────

    # SO-1: First-person plural voice ("We shipped")
    narr:StyleObs_FirstPersonQuote a narr:StyleObservation ;
      skos:broader narr:FirstPerson ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Speaker uses first-person plural ('We shipped') to assert collective team ownership of the delivery outcome." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 62 ;
          oa:end 79
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was"
        ]
      ] .

    # SO-2: Technical jargon density ("async decision widget", "Zephyr integration")
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Domain-specific terms used without definition: 'async decision widget' and 'Zephyr integration'. Assumes shared technical context among readers." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 75 ;
          oa:end 180
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "We shipped the " ;
          oa:suffix "\""
        ]
      ] .

    # SO-3: Short punchy cadence — three declarative sentences, each ≤ 15 words
    narr:StyleObs_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Three short declarative sentences in sequence, each delivering a single fact. Cadence is clipped and confident — characteristic of sprint retro reporting register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 62 ;
          oa:end 180
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength 12 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal ;
      skos:note "Three sentences averaging ~12 words each. All active voice. Jargon density moderate: 'async decision widget' and 'Zephyr integration' are domain-specific but the overall register is plain and direct." .

  }
}