# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250124T000000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 228 ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, 23-point velocity (quarter high), and Zephyr integration as key unlock. Reviewer phone number redacted per PII policy." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes. First-name-only speaker in retro note." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      narr:theme "Integration as velocity unlock" ;
      skos:broader narr:TechnologiesSocialSystems ;
      skos:note "The Zephyr integration is framed as the causal unlock enabling record sprint velocity and successful feature shipment. Reflects a pattern where a single integration event catalyzes team throughput." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_VelocityRecord_23pts a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "Velocity was 23 points this sprint, reported as highest this quarter." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Claim_AsyncWidgetShipped a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "The async decision widget was shipped during this sprint." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "The Zephyr integration is attributed as the key unlock enabling the sprint's outcomes." ;
      narr:supports narr:Narrative_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_VelocityQuote a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya reports 23-point velocity as highest this quarter" ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 107 ;
        oa:end 162
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter." ;
        oa:prefix "We shipped the async decision widget. " ;
        oa:suffix " The Zephyr integration was the key unlock."
      ] .

    narr:Observation_ZephyrUnlockQuote a narr:Observation ;
      skos:broader narr:TechnologiesSocialSystems ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes Zephyr integration as the causal unlock for sprint success" ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 163 ;
        oa:end 210
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock." ;
        oa:prefix "Velocity was 23 points, highest this quarter. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_ActiveVoiceRetro a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "All three sentences use active voice with clear agent-action-object structure: 'We shipped', 'Velocity was', 'integration was'." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 75 ;
          oa:end 210
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was 23 points"
        ]
      ] .

    narr:StyleObs_SuperlativeFraming a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Superlative 'highest this quarter' frames the velocity metric as a record, lending authority and urgency to the retrospective claim." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 144 ;
          oa:end 162
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "highest this quarter" ;
          oa:prefix "Velocity was 23 points, " ;
          oa:suffix ". The Zephyr integration"
        ]
      ] .

    narr:StyleObs_KeyUnlockIdiom a narr:StyleObservation ;
      skos:broader narr:IdiolectPhrasing ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "'Key unlock' is a tech-team idiom attributing causal primacy to a single enabling factor. Signals engineering/product register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 185 ;
          oa:end 209
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "the key unlock" ;
          oa:prefix "The Zephyr integration was " ;
          oa:suffix ".\""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal ;
      skos:note "Three short declarative sentences averaging ~9 words each. 100% active voice. Jargon terms: async, velocity, Zephyr, widget, unlock (~22% of content words). Register: engineering/product team, informal-professional." .

  }
