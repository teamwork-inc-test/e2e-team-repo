# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250130T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 130 ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, record velocity of 23 points, and Zephyr integration as key unlock. Reviewer phone number redacted per PII policy." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes; sole named speaker in this memory." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_AsyncWidgetShip_VelocityRecord a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Shipping a key feature (async decision widget) unlocks record team velocity" ;
      skos:broader narr:Proof ;
      skos:note "The sprint retro asserts a causal chain: the Zephyr integration enabled the async decision widget to ship, which drove the team's highest velocity (23 points) of the quarter. The narrative pattern is: enabling integration → feature delivery → performance record." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_VelocityHighestThisQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetShip_VelocityRecord ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncWidgetShip_VelocityRecord ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points — stated as highest this quarter. Single-speaker assertion; no corroborating data in this memory." .

    narr:Claim_ZephyrIntegrationKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetShip_VelocityRecord ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncWidgetShip_VelocityRecord ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya identifies the Zephyr integration as the key unlock for shipping the async decision widget. Causal attribution from a single speaker." .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_AsyncDecisionWidgetShipped a narr:Observation ;
      skos:broader narr:CaseResults ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya confirms the async decision widget was shipped this sprint." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 60 ;
        oa:end 97
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget" ;
        oa:prefix "Tanya: \"" ;
        oa:suffix ". Velocity was"
      ] .

    narr:Observation_Velocity23Points a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Sprint velocity recorded at 23 points, described as the highest this quarter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 98 ;
        oa:end 140
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter" ;
        oa:prefix "async decision widget. " ;
        oa:suffix ". The Zephyr"
      ] .

    narr:Observation_ZephyrKeyUnlock a narr:Observation ;
      skos:broader narr:DependenciesIntegrations ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration identified as the enabling dependency that unlocked the sprint's key delivery." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 141 ;
        oa:end 185
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock" ;
        oa:prefix "highest this quarter. " ;
        oa:suffix ".\""
      ] .

    # ── Style Observations ───────────────────────────────────────
    narr:StyleObs_FirstPersonPlural a narr:StyleObservation ;
      skos:broader narr:FirstPerson ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Speaker uses first-person plural ('We shipped') to attribute delivery to the team collectively, not individually." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 60 ;
          oa:end 70
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped" ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " the async"
        ]
      ] .

    narr:StyleObs_JargonTechTerms a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Dense use of product/engineering jargon in a short passage: 'async', 'widget', 'Zephyr integration', 'velocity', 'points'. Assumes shared domain context with the reader." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 71 ;
          oa:end 130
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget. Velocity was 23 points" ;
          oa:prefix "We shipped the " ;
          oa:suffix ", highest this"
        ]
      ] .

    narr:StyleObs_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Three short declarative sentences in rapid succession: shipped widget → velocity record → key unlock. Cadence mirrors sprint reporting conventions — terse, factual, forward-moving." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 141 ;
          oa:end 185
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The Zephyr integration was the key unlock" ;
          oa:prefix "highest this quarter. " ;
          oa:suffix ".\""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength 14 ;
      narr:ActiveVoiceRatio "0.85"^^xsd:decimal ;
      narr:JargonDensity "0.25"^^xsd:decimal ;
      skos:note "Three sentences, ~42 words total. Predominantly active voice. High jargon density for a short text: async, widget, Zephyr, integration, velocity, points (6 domain-specific terms out of ~24 content words)." .

  }
}