          oa:start 54 ;
          oa:end 107
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Testing that omitted ref creates a topic branch." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    narr:StyleObs_Jargon_v20 a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v20 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v20 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 87 ;
          oa:end 106
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "topic branch" ;
          oa:prefix "creates a " ;
          oa:suffix ".\""
        ]
      ] .

    narr:StyleObs_ActiveVoice_v20 a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_DefaultRefTest_v20 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v20 ;
        oa:hasSelector [
