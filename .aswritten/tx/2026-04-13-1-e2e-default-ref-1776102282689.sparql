    narr:Sample_DefaultRefTest_v20 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v20) of the minimal Default Ref Test document. Tanya asserts that omitting a ref creates a topic branch." ;
