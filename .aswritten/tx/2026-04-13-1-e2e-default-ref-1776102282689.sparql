      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal ;
      skos:note "Single-sentence body. Active voice. Technical jargon: 'ref', 'topic branch'." .

    narr:StyleObs_DirectTone_v20 a narr:StyleObservation ;
