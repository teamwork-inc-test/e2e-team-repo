          oa:exact "Tanya: \"We shipped the async decision widget." ;
          oa:prefix "# Tanya's Sprint Retro\n\n" ;
          oa:suffix " Velocity was 23 points"
        ]
      ] .

    # 2. Short punchy declarative cadence
    narr:StyleObs_TanyaRetro_ShortDeclarative a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Three consecutive short declarative sentences averaging ~12 words each. No subordinate clauses. Staccato rhythm typical of executive retro summaries." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 69 ; oa:end 152
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " The Zephyr integration"
        ]
      ] .

    # 3. Jargon / product terminology density
    narr:StyleObs_TanyaRetro_FirstPerson a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Technical product terms used without definition: 'async decision widget', 'Zephyr integration', 'key unlock'. Assumes shared context with engineering/product audience. Consistent with in-team retro register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 84 ; oa:end 105
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget" ;
          oa:prefix "We shipped the " ;
          oa:suffix ". Velocity was"
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength 12 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Extremely short document (3 sentences in quoted speech). 100% active voice. Moderate jargon density driven by product-specific terms (async decision widget, Zephyr integration, key unlock). Register: terse executive retro, in-team audience assumed." .

