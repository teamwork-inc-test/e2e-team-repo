    # ── Observation: Tanya's verbatim quote ─────────────────────
    narr:Obs_TanyaVelocityQuote a narr:Observation ;
      skos:broader narr:KPIsSuccess ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya (CEO) reports 23-point velocity as highest this quarter and names Zephyr integration as the key unlock. Distinct from Obs_TinaVelocity which attributes the same facts to Tina (Head of Product) in Sample_Sprint4Retro_20260322." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 69 ; oa:end 195
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Claim: Tanya corroborates Zephyr as key unlock ──────────
    narr:Claim_TanyaZephyrUnlockCorroboration a narr:Claim ;
      narr:aboutNode narr:Claim_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya (CEO) independently corroborates that the Zephyr integration was the key unlock for the sprint, adding CEO-level speaker attribution to the existing Claim_ZephyrIntegrationUnlock (previously attributed only to Tina, Head of Product). Velocity figure of 23 points (highest this quarter) is consistent with Obs_TinaVelocity." .

    # ── Style Observations ───────────────────────────────────────

    # 1. Direct first-person quote attribution
    narr:StyleObs_TanyaRetro_DirectQuote a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Speaker name followed by colon introduces verbatim quote — same inline attribution pattern as Sample_Sprint4Retro_20260322." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
