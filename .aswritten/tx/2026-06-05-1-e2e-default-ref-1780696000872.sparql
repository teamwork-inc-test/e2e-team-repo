INSERT DATA {
  GRAPH narr:Tx_20250908T120000Z {

    narr:Sample_DefaultRefTest_v83 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v83) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 ;
      narr:styleProfile "<https://aswritten.ai/narrative#JargonPolicy>\n<https://aswritten.ai/narrative#SpeakerIdiolects>\n<https://aswritten.ai/narrative#ToneDirectPersonal>" .

    narr:StyleMetrics_DefaultRefTest_v83 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v83 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v82 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

    narr:StyleObs_DefaultRefTest_v83_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v83 ;
      skos:note "Technical terms 'ref' and 'topic branch' used precisely without definition, assuming developer audience familiarity." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v83 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 72 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch" ;
          oa:prefix "Testing that " ;
          oa:suffix "."
        ]
      ] .

    narr:StyleObs_DefaultRefTest_v83_SpeakerIdiolect a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v83 ;
      skos:note "Tanya's idiolect: direct declarative assertion framed as a test statement. No hedging, no passive constructions." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v83 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 56 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Testing that omitted ref creates a topic branch." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    narr:StyleObs_DefaultRefTest_v83_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v83 ;
      skos:note "Document title and attributed quote use direct, unadorned register. No preamble, no context-setting prose — pure functional test note." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v83 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 18 ;
          oa:end 34
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Default Ref Test" ;
          oa:prefix "# " ;
          oa:suffix "\n"
        ]
      ] .

    narr:Obs_DefaultRefTest_v83_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v83 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 56 ;
        oa:end 113
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
