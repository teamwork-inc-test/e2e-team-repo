      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_VelocityRecord_Q_SprintRetro ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity gain to the Zephyr integration as the 'key unlock' — a causal claim with moderate conviction (single speaker, retrospective context)." .

    # ── Observations ────────────────────────────────────────────
    narr:Obs_ShippedAsyncWidget a narr:Observation ;
      skos:broader narr:CaseResults ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Direct quote: shipping of async decision widget confirmed by Tanya." ;
      oa:hasSelector [
