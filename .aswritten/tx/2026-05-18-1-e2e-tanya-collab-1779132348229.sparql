PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────────────────
INSERT DATA {
  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "inline-message" ;
    narr:originRef "main" ;
    dct:title "Tanya Sprint Retro extraction" ;
    prov:generated
      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Narrative_ZephyrVelocityUnlock,
      narr:Claim_HighestVelocityThisQuarter,
      narr:Claim_ZephyrAsKeyUnlock,
      narr:Obs_AsyncWidgetShipped,
      narr:StyleObs_FirstPersonDirectQuote,
      narr:StyleObs_TripartiteCadence,
      narr:StyleObs_JargonTechTerms,
      narr:StyleMetrics_TanyaSprintRetro .
} ;

# ── Extracted entities (named graph) ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 213 ;
      dct:description "Sprint retrospective note from Tanya reporting velocity of 23 points (highest this quarter) and the Zephyr integration as the key unlock for shipping the async decision widget." .

    # ── Actor ───────────────────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting on retro outcomes; first-name-only speaker in discussion note. Reviewer phone number redacted per PII policy." .

    # ── Narrative ───────────────────────────────────────────────────────────
    narr:Narrative_ZephyrVelocityUnlock a narr:Narrative ;
      narr:theme "Integration unlock drives record team velocity" ;
      skos:broader narr:Proof ;
      skos:note "The Zephyr integration acted as the enabling dependency that allowed the team to ship the async decision widget and achieve their highest velocity (23 points) of the quarter. The narrative pattern: a targeted integration unblocks delivery and produces measurable performance gains." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Claims ──────────────────────────────────────────────────────────────
    narr:Claim_HighestVelocityThisQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrVelocityUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrVelocityUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points, stated as highest this quarter. Single-speaker assertion in retro context; conviction level Stake (reported metric, not independently verified)." .

    narr:Claim_ZephyrAsKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrVelocityUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrVelocityUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya identifies the Zephyr integration as 'the key unlock' — causal attribution for both the widget shipment and the velocity record. Single-speaker causal claim." .

    # ── Observation (verbatim quote) ─────────────────────────────────────────
    narr:Obs_AsyncWidgetShipped a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's full retro statement covering shipment, velocity metric, and causal attribution to Zephyr integration." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 100 ;
        oa:end 213
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations ───────────────────────────────────────────────────

    # 1. Direct first-person declarative voice
    narr:StyleObs_FirstPersonDirectQuote a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Speaker uses direct first-person plural ('We shipped') — assertive, ownership-claiming register typical of retro reporting." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 108 ;
          oa:end 130
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget" ;
          oa:prefix "Tanya: \"" ;
          oa:suffix ". Velocity was"
        ]
      ] .

    # 2. Short punchy cadence — three short declarative sentences
    narr:StyleObs_TripartiteCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Three consecutive short declarative sentences (avg ~10 words each) create a punchy, confident retro cadence: shipment → metric → cause." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 100 ;
          oa:end 213
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # 3. Technical jargon / product terminology
    narr:StyleObs_JargonTechTerms a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Dense product/engineering jargon in a short span: 'async decision widget', 'Zephyr integration', 'velocity' (agile metric). High jargon density for a 3-sentence utterance." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 119 ;
          oa:end 213
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "We shipped the " ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "10"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.23"^^xsd:decimal ;
      skos:note "Three sentences, all active voice. High jargon density (async, velocity, Zephyr integration, widget). Terse, metric-forward register consistent with agile retro reporting." .

  }
}