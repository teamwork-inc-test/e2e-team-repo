INSERT DATA {
  GRAPH aswr:Tx_20260923T172222Z {
    narr:Recon_3RealChannelNotProduct20260428_1 a narr:Reconciliation ;
        oa:hasTarget narr:Narrative_InstallableExpertise ;
        narr:principal narr:Actor_TanyaTeamowner ;
        skos:note "The product is curated expertise installation** — a way to install expertise into your AI and verify where it's coming from.\n\nThis is consistent with `Claim_CoreValuePropInstallExpertise` (Foundation-level, March 19, 2026 strategy session): *\"A way to install expertise into your AI and verify where it's coming from.\"\n\nTanya at the time: \"That's gold.\"" ;
        narr:extends narr:Position_InstallableExpertiseCategoryMoat ;
        narr:extends narr:Expr_1RealFreyaPodcastSalesMotion20260323_24 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_9 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_10 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_11 ;
        prov:generatedAtTime "2026-09-23T17:22:22Z"^^xsd:dateTime .

    narr:Recon_3RealChannelNotProduct20260428_2 a narr:Reconciliation ;
        oa:hasTarget narr:Position_EvaluatorChannelTrustTax ;
        oa:hasTarget narr:Narrative_InterviewFlywheel ;
        narr:principal narr:Actor_TanyaTeamowner ;
        skos:note "The phone number / SMS is a distribution channel.\n\nIt is one of several.\n\nIt is the right channel in some contexts (where the trust-signal of \"not an AI chat\" matters; where an enterprise client needs that texture and is willing to absorb the operational cost) and the wrong channel in others (where SMS reads as spam-adjacent, where prospects don't want to hand over their number, where the operational cost isn't justified).\n\nThis is consistent with `Claim_SMSFormatHonesty` (Foundation): *\"The SMS format makes AI personalization feel honest rather than fake because it removes the 'bot' mental frame associated with chat boxes.\"\n\nThat claim is **not superseded** by this correction.\n\nSMS-as-trust-signal remains genuine value.\n\nThe correction is about scope: it's a *channel property*, not a product identity." ;
        narr:extends narr:Position_EvaluatorChannelTrustTax ;
        narr:extends narr:Expr_2RealTessChatWidget20260423_10 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_12 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_13 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_14 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_16 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_17 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_18 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_19 ;
        prov:generatedAtTime "2026-09-23T17:22:22Z"^^xsd:dateTime .

    narr:Recon_3RealChannelNotProduct20260428_3 a narr:Reconciliation ;
        oa:hasTarget narr:Narrative_InterviewFlywheel ;
        narr:principal narr:Actor_TanyaTeamowner ;
        skos:note "The triggering operational evidence: seven additional Twilio toll-free numbers were submitted for verification and **all seven came back rejected** (April 28, 2026).\n\nThe rejection reason traces to the website / opt-in form not being live or linkable at verification time.\n\nThe numbers can be resubmitted to the review queue.\n\nThis is not the first verification cycle and it will not be the last; verification churn is a permanent operational cost of running SMS at scale." ;
        narr:extends narr:Expr_2RealTessChatWidget20260423_14 ;
        narr:extends narr:Expr_2RealTessChatWidget20260423_3 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_22 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_23 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_24 ;
        dct:source narr:Expr_3RealChannelNotProduct20260428_25 ;
        prov:generatedAtTime "2026-09-23T17:22:22Z"^^xsd:dateTime .

    narr:Recon_3RealChannelNotProduct20260428_5 a narr:Reconciliation ;
        oa:hasTarget narr:Narrative_InterviewFlywheel ;
        narr:principal narr:Actor_TanyaTeamowner ;
        skos:note "The Identity section of the worldview includes the line:\n\n> tagline: \"The product is a phone number.\"\n\nThis tagline should be **superseded**.\n\nThe replacement positioning, in Tanya's voice from this session and consistent with prior strategy work:\n\n> The product is curated expertise installation. The phone number is the distribution channel for contexts where the trust-signal of \"not an AI chat\" is worth its operational cost — primarily enterprise.\n\nThe other Identity tagline (\"Feather your arrows.\") is unaffected." ;
        narr:supersedes narr:Expr_2RealTessChatWidget20260423_27 ;
