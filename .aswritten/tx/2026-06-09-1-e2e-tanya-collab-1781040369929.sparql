INSERT DATA {
  narr:Tx_20250724T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-24T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "main" ;
    dct:title "Tanya Sprint Retro extraction" ;
    prov:generated
      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Narrative_ZephyrIntegrationUnlock,
      narr:Claim_AsyncDecisionWidgetShipped,
      narr:Claim_VelocityHighestThisQuarter,
      narr:Observation_TanyaRetroQuote,
