      skos:note "Tanya attributes the velocity record to the Zephyr integration as 'the key unlock'. Causal attribution from a single speaker — Stake conviction." .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_ShippedWidget a narr:Observation ;
