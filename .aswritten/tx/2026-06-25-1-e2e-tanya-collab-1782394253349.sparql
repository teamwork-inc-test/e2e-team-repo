    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_AsyncDecisionWidgetShipped a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Shipping the async decision widget marks a velocity milestone enabled by the Zephyr integration" ;
