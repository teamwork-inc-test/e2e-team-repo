INSERT DATA {
  GRAPH narr:Tx_20250912T120000Z {

    narr:Sample_DefaultRefTest_v87 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v87) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 .

    narr:StyleMetrics_DefaultRefTest_v87 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v87 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v86 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

    narr:Obs_DefaultRefTest_v87_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v87 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 82 ;
        oa:end 130
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    narr:StyleObs_DefaultRefTest_v87_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v87 ;
      skos:note "First-person attributed quote in direct speech registers as informal, personal tone." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v87 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 75 ;
          oa:end 130
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_DefaultRefTest_v87_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v87 ;
      skos:note "Technical terms 'ref' and 'topic branch' are used without definition, assuming reader familiarity with git conventions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v87 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 96 ;
          oa:end 129
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch" ;
          oa:prefix "Testing that " ;
          oa:suffix "."
        ]
      ] .

    narr:StyleObs_DefaultRefTest_v87_SpeakerIdiolects a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v87 ;
