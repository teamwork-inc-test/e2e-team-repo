    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength "197"^^xsd:integer ;
      dct:description "Sprint retrospective note from Tanya covering shipped widget, velocity record, and Zephyr integration unlock. Reviewer phone number redacted (PII)." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes. First-name-only speaker; domain suffix _SprintRetro added to avoid IRI collision." .

    # ── Narratives ──────────────────────────────────────────────
    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Integration as velocity enabler" ;
      skos:broader narr:TechnologiesSocialSystems ;
      skos:note "The Zephyr integration is framed as the causal unlock behind the team's record velocity, establishing a pattern where third-party integrations drive sprint performance." .

    narr:Narrative_VelocityRecord a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Record sprint velocity as proof of delivery momentum" ;
      skos:broader narr:MetricsMonitoring ;
      skos:note "23 points is asserted as the highest velocity this quarter, positioning the sprint as a performance milestone and evidence of team momentum." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_AsyncWidgetShipped a narr:Claim ;
