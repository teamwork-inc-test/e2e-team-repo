          oa:exact "23 points" ;
          oa:prefix "Velocity was " ;
          oa:suffix ", highest this quarter"
        ]
      ] .

    narr:StyleObs_CausalUnlockMetaphor a narr:StyleObservation ;
      skos:broader narr:Metaphor ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "'Key unlock' is a product/engineering metaphor for an enabling dependency — casual technical idiom common in agile retrospective discourse." ;
