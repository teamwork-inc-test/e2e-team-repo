      ] .

    narr:StyleObs_NumericSpecificity a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Use of precise numeric metric ('23 points') grounds the retro claim in measurable evidence, a hallmark of agile reporting register." ;
      rdf:value true ;
      oa:hasTarget [
