      narr:inputLength "113"^^xsd:integer .

    narr:Obs_DefaultRefTest_v91_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v91 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
