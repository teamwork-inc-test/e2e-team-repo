      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v91 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "57"^^xsd:integer ;
          oa:end "113"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_DefaultRefTest_v91_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v91 ;
      skos:note "Technical terms 'ref' and 'topic branch' used without definition — assumed shared vocabulary with developer audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v91 ;
