# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250124T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 199 ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, 23-point velocity (highest this quarter), and Zephyr integration as key unlock. Reviewer phone number redacted (PII)." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes; sole named speaker in this memory." .

    # ── Narratives ──────────────────────────────────────────────
    narr:Narrative_VelocityPeak_AsyncWidget a narr:Narrative ;
      narr:theme "Team shipped async decision widget at record quarterly velocity" ;
      skos:broader narr:Proof ;
      skos:note "The team delivered the async decision widget in a sprint that achieved 23 story points — the highest velocity of the quarter. Reported by Tanya in sprint retro." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      narr:theme "Zephyr integration was the key unlock enabling peak velocity" ;
      skos:broader narr:TechnologiesSocialSystems ;
      skos:note "Tanya attributes the velocity peak directly to the Zephyr integration, framing it as the enabling dependency that unlocked the sprint's performance." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_VelocityHighestThisQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_VelocityPeak_AsyncWidget ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "Velocity was 23 points, asserted as highest this quarter by Tanya." ;
      narr:supports narr:Narrative_VelocityPeak_AsyncWidget ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "Tanya explicitly names Zephyr integration as 'the key unlock' for the sprint's performance." ;
      narr:supports narr:Narrative_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_TanyaQuote_ShippedWidget a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's verbatim retrospective statement covering shipped widget, velocity metric, and Zephyr attribution." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 71 ;
        oa:end 198
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. Tone: Direct, first-person declarative
    narr:StyleObservation_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Speaker uses first-person plural ('We shipped') for direct ownership; assertive declarative tone throughout." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 71 ;
          oa:end 107
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was"
        ]
      ] .

    # 2. Jargon: Technical product/tool terminology
    narr:StyleObservation_JargonPolicy_TechTerms a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Uses domain-specific technical terms ('async decision widget', 'Zephyr integration') without definition, assuming shared team context." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 80 ;
          oa:end 107
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget" ;
          oa:prefix "shipped the " ;
          oa:suffix ". Velocity"
        ]
      ] .

    # 3. Cadence: Short punchy declarative sentences
    narr:StyleObservation_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Three short declarative sentences averaging ~10 words each; no subordinate clauses; staccato retrospective cadence." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 71 ;
          oa:end 198
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength 10 ;
      narr:ActiveVoiceRatio "0.95"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal ;
      skos:note "Three-sentence quote. Active voice dominant ('We shipped', 'Velocity was', 'integration was the key unlock'). Technical jargon present but sparse: async, widget, Zephyr, integration." .

  }
}