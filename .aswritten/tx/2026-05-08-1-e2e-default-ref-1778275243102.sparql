    narr:Sample_DefaultRefTest_v44 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v44) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
