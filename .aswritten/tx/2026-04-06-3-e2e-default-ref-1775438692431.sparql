PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Transaction Provenance
INSERT DATA {
  narr:Tx_20250714T120002Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T12:00:02Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "add" ;
    narr:originRef "topic-branch-test" ;
    prov:generated narr:Sample_DefaultRefTest_v3, narr:StyleMetrics_DefaultRefTest_v3, narr:StyleObs_QuotedSpeech, narr:StyleObs_TechnicalJargon, narr:StyleObs_InformalRegister .
} ;

# Extracted Entities
INSERT DATA {
  GRAPH narr:Tx_20250714T120002Z {
    narr:Sample_DefaultRefTest_v3 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Tanya testing system behavior when git ref is omitted, resulting in topic branch creation." ;
      narr:inputLength 113 .

    narr:StyleMetrics_DefaultRefTest_v3 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v3 ;
      narr:AverageSentenceLength 9 ;
      narr:ActiveVoiceRatio 1.0 ;
      narr:JargonDensity 0.2 ;
      skos:note "Single sentence test note with technical terminology." .

    narr:StyleObs_QuotedSpeech a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v3 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v3 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 57 ;
          oa:end 106
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Testing that omitted ref creates a topic branch." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v3 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v3 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 93 ;
          oa:end 105
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "topic branch" ;
          oa:prefix "creates a " ;
          oa:suffix "."
        ]
      ] .

    narr:StyleObs_InformalRegister a narr:StyleObservation ;
      skos:broader narr:RegisterFormality ;
      dct:source narr:Sample_DefaultRefTest_v3 ;
      skos:note "Informal test-driven communication style." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v3 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 50 ;
          oa:end 55
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ": \"Testing"
        ]
      ] .
  }
} ;

# Updates to existing entities
DELETE {
  GRAPH ?g {
    narr:Claim_OmittedRefCreatesBranch dct:source ?oldSource .
  }
}
INSERT {
  GRAPH narr:Tx_20250714T120002Z {
    narr:Claim_OmittedRefCreatesBranch dct:source narr:Sample_DefaultRefTest_v3 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_OmittedRefCreatesBranch dct:source ?oldSource .
  }
}