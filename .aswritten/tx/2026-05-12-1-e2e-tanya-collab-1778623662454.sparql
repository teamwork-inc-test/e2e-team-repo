    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength "228"^^xsd:integer ;
      dct:description "Sprint retrospective note in which Tanya reports shipping the async decision widget, a record-high velocity of 23 points, and credits the Zephyr integration as the key unlock. Reviewer phone number redacted (PII)." .

    # ── Actor ───────────────────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
