    # ── Narrative ───────────────────────────────────────────────────────────
    narr:Narrative_ZephyrUnlockVelocityRecord a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Integration unlock drives record team velocity" ;
      skos:broader narr:Proof ;
      skos:note "The Zephyr integration is framed as the enabling condition (key unlock) that allowed the team to ship the async decision widget and achieve their highest velocity this quarter (23 points). The narrative pattern is: targeted integration → capability unlock → measurable output surge." .

    # ── Claims ──────────────────────────────────────────────────────────────
    narr:Claim_AsyncWidgetShipped a narr:Claim ;
