      skos:note "Zephyr integration is identified as the key unlock that enabled the team's highest-velocity sprint this quarter, framing third-party integration as a strategic enabler." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_VelocityHighestThisQuarter a narr:Claim ;
