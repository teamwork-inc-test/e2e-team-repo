    # ── Narratives ──────────────────────────────────────────────
    narr:Narrative_AsyncWidgetDelivery a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Successful delivery of async decision widget at record velocity" ;
      skos:broader narr:Outcomes ;
      skos:note "The team shipped the async decision widget in a sprint achieving 23 points — the highest velocity this quarter. Delivery success is attributed to the Zephyr integration." .

    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Integration as velocity unlock: Zephyr enabled peak sprint performance" ;
