      skos:note "Velocity was 23 points, asserted as the highest this quarter. Single-source claim with no corroboration yet." .

    narr:Claim_ZephyrWasKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity outcome to Zephyr integration as 'the key unlock'. Causal attribution is asserted but not independently verified." .

    # ── Observations ────────────────────────────────────────────────────────
    narr:Obs_VelocityQuote a narr:Observation ;
