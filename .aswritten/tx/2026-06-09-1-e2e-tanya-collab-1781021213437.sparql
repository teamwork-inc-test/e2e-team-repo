    # ── Style Observations ───────────────────────────────────────────────────
    narr:StyleObs_DirectFirstPersonVoice a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Speaker uses direct first-person plural ('We shipped') — assertive, ownership-claiming register typical of agile retro reporting." ;
      rdf:value true ;
      oa:hasTarget [
