    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 181 ;
      dct:description "Sprint retrospective note from Tanya reporting delivery of async decision widget, velocity of 23 points (highest this quarter), and Zephyr integration as the key unlock." .

    # ── Actor ───────────────────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes; attributed statements about widget delivery, velocity, and Zephyr integration." .

    # ── Narratives ──────────────────────────────────────────────────────────
    narr:Narrative_AsyncWidgetVelocityRecord a narr:Narrative ;
      narr:theme "Shipping the async decision widget drove the team's highest velocity this quarter" ;
      skos:broader narr:Proof ;
      skos:note "The sprint retro frames the async decision widget delivery as a milestone that produced a record velocity of 23 points, positioning the team as executing at peak capacity." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      narr:theme "Zephyr integration was the enabling unlock for sprint success" ;
      skos:broader narr:TechnologiesSocialSystems ;
      skos:note "Tanya attributes the velocity record to the Zephyr integration as the 'key unlock', framing external tooling as the decisive enabler of team performance." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Claims ──────────────────────────────────────────────────────────────
    narr:Claim_AsyncWidgetShipped a narr:Claim ;
