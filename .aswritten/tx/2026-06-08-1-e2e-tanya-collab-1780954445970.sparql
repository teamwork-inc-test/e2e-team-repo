          oa:prefix "Tanya: \"" ;
          oa:suffix " The Zephyr integration"
        ]
      ] .

    narr:StyleObs_TechJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Technical product/tooling jargon: \"async decision widget\" and \"Zephyr integration\" used without definition, assuming insider audience." ;
      oa:hasTarget [
