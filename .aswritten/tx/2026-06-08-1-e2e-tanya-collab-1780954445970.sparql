      ] .

    narr:StyleObs_SuperlativeAuthority a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Superlative framing (\"highest this quarter\") used to assert record performance; authoritative, data-backed tone." ;
      oa:hasTarget [
