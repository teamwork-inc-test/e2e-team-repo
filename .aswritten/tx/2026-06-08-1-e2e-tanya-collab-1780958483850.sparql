      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Narrative_VelocityRecordQuarter,
      narr:Claim_AsyncDecisionWidgetShipped,
      narr:Claim_Velocity23PointsHighest,
      narr:Claim_ZephyrIntegrationKeyUnlock,
      narr:Observation_TanyaFullQuote,
      narr:StyleObs_FirstPersonPlural,
