      narr:Narrative_ZephyrIntegrationUnlock,
      narr:Claim_AsyncWidgetShipped,
      narr:Claim_VelocityRecord23pts,
      narr:Claim_ZephyrKeyUnlock,
      narr:Observation_TanyaRetroQuote,
