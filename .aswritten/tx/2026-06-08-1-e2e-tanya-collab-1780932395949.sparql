INSERT DATA {
  GRAPH narr:Tx_20250725T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength "197"^^xsd:integer ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, velocity of 23 points (highest this quarter), and Zephyr integration as key unlock." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retro outcomes; attributed quote about async decision widget delivery and velocity record." .

    # ── Narratives ──────────────────────────────────────────────
    narr:Narrative_SprintVelocityRecord a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Sprint velocity record — highest this quarter" ;
      skos:broader narr:KPIsSuccess ;
      skos:note "The team achieved 23 story points in this sprint, described as the highest velocity of the quarter, signalling a delivery acceleration pattern." .

    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Integration as velocity unlock — Zephyr enabled record sprint output" ;
      skos:broader narr:DependenciesIntegrations ;
      skos:note "The Zephyr integration is identified as the key causal factor behind the velocity record, establishing a pattern where tooling integrations unlock delivery capacity." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_AsyncWidgetShipped a narr:Claim ;
      narr:aboutNode narr:Narrative_SprintVelocityRecord ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya states the async decision widget was shipped this sprint." .

    narr:Claim_Velocity23PointsHighest a narr:Claim ;
      narr:aboutNode narr:Narrative_SprintVelocityRecord ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points, asserted as highest this quarter — single-source claim from sprint retro." .

    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration identified as the key unlock — causal attribution from a single speaker, low corroboration." .

    # ── Observations ────────────────────────────────────────────
    narr:Obs_ShippedAsyncWidget a narr:Observation ;
      skos:broader narr:CaseResults ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya confirms async decision widget was shipped." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "72"^^xsd:integer ;
        oa:end "107"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget" ;
        oa:prefix "Tanya: \"" ;
        oa:suffix ". Velocity was 23"
      ] .

    narr:Obs_VelocityRecord a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity of 23 points reported as highest this quarter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "108"^^xsd:integer ;
        oa:end "148"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter" ;
        oa:prefix "shipped the async decision widget. " ;
        oa:suffix ". The Zephyr integration"
      ] .

    narr:Obs_ZephyrUnlock a narr:Observation ;
      skos:broader narr:DependenciesIntegrations ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration named as the key unlock for sprint velocity." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "150"^^xsd:integer ;
        oa:end "192"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock" ;
        oa:prefix "highest this quarter. " ;
        oa:suffix ".\""
      ] .

    # ── Style Observations ───────────────────────────────────────
    narr:StyleObs_DirectQuoteFirstPerson a narr:StyleObservation ;
      skos:broader narr:FirstPerson ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Speaker uses first-person plural (we) in direct quote, creating team ownership framing." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
