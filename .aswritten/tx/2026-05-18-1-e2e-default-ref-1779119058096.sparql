    narr:StyleObs_DefaultRefTest_v50_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v50 ;
      skos:note "Direct personal tone: attributed first-name speaker quote with declarative assertion." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v50 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 68 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. JargonPolicy — technical terms 'ref' and 'topic branch' used precisely
    narr:StyleObs_DefaultRefTest_v50_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v50 ;
      skos:note "Mild technical jargon: 'ref' (git reference) and 'topic branch' used without definition, assuming developer audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v50 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 76 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Testing that omitted ref creates a topic branch." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # 3. SpeakerIdiolects — attribution pattern 'Name: "quote"'
    narr:StyleObs_DefaultRefTest_v50_SpeakerIdiolects a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v50 ;
      skos:note "Speaker attribution pattern: 'FirstName: \"verbatim quote\"' — idiolect marker consistent across all DefaultRefTest extractions." ;
