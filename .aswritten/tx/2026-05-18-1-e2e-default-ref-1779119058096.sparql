    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_DefaultRefTest_v50 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v50) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 ;
      narr:styleProfile "<https://aswritten.ai/narrative#JargonPolicy>\n<https://aswritten.ai/narrative#SpeakerIdiolects>\n<https://aswritten.ai/narrative#ToneDirectPersonal>" .

    # ── Observation ─────────────────────────────────────────────
    narr:Obs_DefaultRefTest_v50_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v50 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 76 ;
        oa:end 113
