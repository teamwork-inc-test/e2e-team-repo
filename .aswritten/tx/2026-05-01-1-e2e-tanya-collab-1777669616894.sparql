    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_AsyncWidgetDelivery a narr:Narrative ;
      narr:theme "Integration-unlocked delivery velocity" ;
      skos:broader narr:Proof ;
      skos:note "The team's highest-velocity sprint this quarter was enabled by the Zephyr integration, which unblocked shipping the async decision widget. The pattern: a key integration unlock drives record output." ;
      dct:source narr:Sample_TanyaSprintRetro .

