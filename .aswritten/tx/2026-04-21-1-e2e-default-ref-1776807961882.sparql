PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250801T120000Z a prov:Activity ;
    dct:title "Default Ref Test — repeat extraction v26" ;
    prov:generatedAtTime "2025-08-01T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "(not provided — no id field in input)" ;
    narr:originRef "(omitted — document explicitly tests omitted-ref behavior)" ;
    prov:generated
      narr:Sample_DefaultRefTest_v26,
      narr:StyleMetrics_DefaultRefTest_v26,
      narr:Obs_DefaultRefTest_v26_TanyaQuote,
      narr:StyleObs_DefaultRefTest_v26_ToneDirectPersonal,
      narr:StyleObs_DefaultRefTest_v26_JargonPolicy,
      narr:StyleObs_DefaultRefTest_v26_SpeakerIdiolect .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250801T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_DefaultRefTest_v26 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v26) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 ;
      narr:styleProfile "<https://aswritten.ai/narrative#JargonPolicy>\n<https://aswritten.ai/narrative#SpeakerIdiolects>\n<https://aswritten.ai/narrative#ToneDirectPersonal>" .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_DefaultRefTest_v26 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v26 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v25 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

    # ── Observation ──────────────────────────────────────────────
    narr:Obs_DefaultRefTest_v26_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v26 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 60 ;
        oa:end 113
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations (min 3) ───────────────────────────────

    # 1. ToneDirectPersonal — Tanya speaks in first person, direct imperative register
    narr:StyleObs_DefaultRefTest_v26_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v26 ;
      skos:note "Direct personal tone: Tanya's quote is a first-person active-voice test assertion with no hedging." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v26 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. JargonPolicy — technical terms 'ref' and 'topic branch' used precisely
    narr:StyleObs_DefaultRefTest_v26_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v26 ;
      skos:note "Controlled jargon: 'ref' (git reference) and 'topic branch' are precise technical terms used without definition, assuming developer audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v26 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 69 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch." ;
          oa:prefix "Testing that " ;
          oa:suffix "\""
        ]
      ] .

    # 3. SpeakerIdiolects — attributed first-name-only speaker label
    narr:StyleObs_DefaultRefTest_v26_SpeakerIdiolect a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v26 ;
      skos:note "Speaker attribution by first name only ('Tanya:') followed by a quoted assertion — idiomatic discussion-note convention consistent across all prior versions of this document." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v26 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 53 ;
          oa:end 60
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: " ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix "\"Testing"
        ]
      ] .

  }
}