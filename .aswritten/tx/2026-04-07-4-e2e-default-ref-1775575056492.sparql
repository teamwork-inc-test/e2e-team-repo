INSERT DATA {
  GRAPH narr:Tx_20250718T120000Z {
    narr:Sample_DefaultRefTest_v12 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Tanya testing system behavior when git ref is omitted, confirming topic branch creation." ;
      narr:inputLength 113 .

    narr:StyleMetrics_DefaultRefTest_v12 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v12 ;
      narr:AverageSentenceLength 9 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal ;
      skos:note "Single-sentence body. Technical jargon: 'ref', 'topic branch'." .

    narr:StyleObs_DefaultRefTest_Tone a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v12 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v12 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 51 ; oa:end 106 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; 
          oa:exact "Testing that omitted ref creates a topic branch." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\"" 
        ]
      ] .

    narr:StyleObs_DefaultRefTest_Jargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v12 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v12 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 64 ; oa:end 91 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; 
          oa:exact "omitted ref creates a topic branch" ;
          oa:prefix "Testing that " ;
          oa:suffix "." 
        ]
      ] .

    narr:StyleObs_DefaultRefTest_Active a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_DefaultRefTest_v12 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v12 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 51 ; oa:end 106 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; 
          oa:exact "Testing that omitted ref creates a topic branch." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\"" 
