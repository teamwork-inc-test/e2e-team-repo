INSERT DATA {
  GRAPH aswr:Tx_20260923T020106Z {
    narr:Sample_5HalyardLegacyArchive20260922 a narr:Sample ;
        dct:title "Halyard — Legacy Archive Working Session — 2026-09-22" ;
        dct:created "2026-09-22"^^xsd:date ;
        aswr:originPath ".aswritten/memories/2026-09-23-5-halyard-legacy-archive-2026-09-22.md" ;
