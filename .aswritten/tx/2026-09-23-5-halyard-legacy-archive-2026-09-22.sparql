        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Sensible." ;
                oa:prefix "e in writing.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tanya Team:** So the posit" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3287"^^xsd:integer ;
                oa:end "3296"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_22 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "So the position is: the legacy platform is switched off when the last site goes live, the closed history is extracted first into an open self-describing archive, and the retention period comes from legal in writing before we sign anything with the vendor about decommissioning." ;
                oa:prefix "** Sensible.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** I'd sign " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
