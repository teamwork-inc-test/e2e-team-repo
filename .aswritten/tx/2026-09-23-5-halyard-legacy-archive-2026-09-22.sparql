    narr:Expr_5HalyardLegacyArchive20260922_1 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "This one is a topic we have genuinely never opened. Legal came to me on Friday with a question nobody in this programme has an answer to, and I'd rather we form a view than have one handed to us." ;
                oa:prefix "n\n2026-09-22\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Which que" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "296"^^xsd:integer ;
                oa:end "491"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_2 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "question" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Which question?" ;
                oa:prefix "ed to us.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** What happens" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "512"^^xsd:integer ;
                oa:end "527"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_3 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "What happens to the records that stay behind. Everything from before a site's cutover lives in the old platform. We migrate the open work. We do not migrate the closed history — eleven years of it." ;
                oa:prefix "ch question?\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Right, an" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "545"^^xsd:integer ;
                oa:end "742"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_4 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Right, and the vendor's contract ends when the last site goes live, so at some point that platform gets switched off." ;
                oa:prefix "rs of it.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** That's the q" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "763"^^xsd:integer ;
                oa:end "880"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_5 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's the question. When, and in what state." ;
                oa:prefix "witched off.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** I'd assumed w" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "898"^^xsd:integer ;
                oa:end "943"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_6 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I'd assumed we'd just keep paying the vendor to leave it running." ;
                oa:prefix "n what state.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** That's th" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "960"^^xsd:integer ;
                oa:end "1025"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_7 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's the expensive answer and it's also the fragile one. A system nobody uses and nobody patches is a system that stops working quietly, and you find out the day someone needs a consignment record from 2019 for a claim." ;
                oa:prefix " running.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** That's exact" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1046"^^xsd:integer ;
                oa:end "1267"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_8 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's exactly the scenario legal raised." ;
                oa:prefix "for a claim.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Then here" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1285"^^xsd:integer ;
                oa:end "1326"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_9 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Then here's the view I'd take, and I'd take it firmly. We do not keep the legacy platform alive as a read-only system. We extract the closed history into a flat, self-describing archive — the records plus a schema description plus a document explaining what the fields mean — and we hold that. The archive outlives the platform." ;
                oa:prefix "l raised.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** Say more abo" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1347"^^xsd:integer ;
                oa:end "1675"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_10 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "directive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Say more about \"self-describing\"." ;
                oa:prefix "he platform.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Meaning y" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1693"^^xsd:integer ;
                oa:end "1726"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_11 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Meaning you can read it in ten years with nothing but the files. Not a database dump that needs the vendor's version of their engine to restore. Not a proprietary export format. Flat files, an open format, a schema next to them, and a written description of what a \"consignment status of 7\" actually meant in 2017, because nobody will remember and the vendor won't exist." ;
                oa:prefix "cribing\".\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tina Team:** That last par" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1747"^^xsd:integer ;
                oa:end "2118"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_12 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That last part is the bit that always gets skipped." ;
                oa:prefix " won't exist.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** It's the " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2135"^^xsd:integer ;
                oa:end "2186"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_13 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "It's the only part that matters in year eight. The data is easy to keep. The meaning is what rots." ;
                oa:prefix " skipped.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** What's the a" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2207"^^xsd:integer ;
                oa:end "2305"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_14 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "question" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "What's the argument against?" ;
                oa:prefix "s what rots.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Cost and " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2323"^^xsd:integer ;
                oa:end "2351"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_15 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Cost and effort now, against a risk that lands years from now on someone who isn't in this room. That's the whole argument against, and it's why it never gets done." ;
                oa:prefix " against?\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** I'm persuade" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2372"^^xsd:integer ;
                oa:end "2536"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_16 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I'm persuaded. I'd add a reason of my own: a live legacy platform is a thing people will keep using. If Ferry Road can still look something up in the old system, someone at Ferry Road will, and then we've got two systems of record for a year. An archive that is obviously an archive kills that." ;
                oa:prefix "r gets done.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** That's a " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2554"^^xsd:integer ;
                oa:end "2848"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_17 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That's a better argument than mine, actually. Mine is about decay. Yours is about behaviour." ;
                oa:prefix "lls that.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** Both go in t" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2869"^^xsd:integer ;
                oa:end "2961"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_18 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "directive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Both go in the note." ;
                oa:prefix "t behaviour.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** How long do w" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "2979"^^xsd:integer ;
                oa:end "2999"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_19 a narr:Expression ;
        narr:actor narr:Actor_TinaTeam ;
        narr:act "question" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "How long do we hold it?" ;
                oa:prefix " in the note.\n\n**Tina Team:** " ;
                oa:suffix "\n\n**Tanya Team:** Legal says s" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3016"^^xsd:integer ;
                oa:end "3039"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_20 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Legal says seven years from the record date for the consignment data. I want to go beyond that for the claims-relevant subset, and I don't want to decide that number today — I want legal to give us one in writing." ;
                oa:prefix " we hold it?\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Tina Team:** Sensible.\n\n**" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "3057"^^xsd:integer ;
                oa:end "3270"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

