        prov:generatedAtTime "2026-09-23T02:01:06Z"^^xsd:dateTime .

    narr:Expr_5HalyardLegacyArchive20260922_25 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Halyard — Legacy Archive Working Session" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5HalyardLegacyArchive20260922 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Yes. That's the thing I'd have got wrong if legal hadn't asked on Friday — I'd have signed the decommissioning terms first and discovered the extraction requirement afterwards." ;
                oa:prefix "ot after it.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Which is " ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
