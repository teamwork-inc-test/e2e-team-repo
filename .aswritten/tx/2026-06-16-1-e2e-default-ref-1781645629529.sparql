INSERT DATA {
  GRAPH narr:Tx_20250920T120000Z {

    narr:Sample_DefaultRefTest_v95 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v95) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 .

    narr:StyleMetrics_DefaultRefTest_v95 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v95 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v94 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

    narr:Obs_DefaultRefTest_v95_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v95 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 68 ;
        oa:end 113
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    narr:StyleObs_DefaultRefTest_v95_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v95 ;
      skos:note "Direct first-person attributed quote; declarative, no hedging." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v95 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 55 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_DefaultRefTest_v95_SpeakerIdiolects a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v95 ;
      skos:note "First-name-only attribution ('Tanya:') is the document's sole speaker identification pattern." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v95 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 55 ;
          oa:end 62
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: " ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix "\"Testing"
        ]
      ] .

    narr:StyleObs_DefaultRefTest_v95_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v95 ;
      skos:note "Technical terms 'ref' and 'topic branch' used without definition; assumes developer audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v95 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 79 ;
          oa:end 112
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch" ;
          oa:prefix "Testing that " ;
          oa:suffix "."
        ]
      ] .

  }
}