      skos:note "CEO of Teamwork Inc. Speaker in sprint retrospective. Previously identified as participant in Sample_Sprint4Retro_20260322." .

    # ── Observation: Tanya's velocity + Zephyr statement ────────
    narr:Obs_TanyaVelocityStatement a narr:Observation ;
      skos:broader narr:KPIsSuccess ;
      dct:source narr:Sample_TanyaSprintRetro_Inline ;
      skos:note "Tanya (CEO) reports 23-point velocity as highest this quarter and attributes it to the Zephyr integration as the key unlock. Corroborates Obs_TinaVelocity from Sample_Sprint4Retro_20260322 with a different speaker attribution." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 78 ; oa:end 204
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Claim: Tanya asserts Zephyr as key unlock ────────────────
    narr:Claim_TanyaZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Claim_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Claim_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro_Inline ;
      skos:note "Tanya (CEO) independently corroborates that the Zephyr integration was the key unlock for sprint velocity. Adds CEO-level attribution to the existing Claim_ZephyrIntegrationUnlock (previously attributed to Tina/Head of Product)." .

    # ── Style Observations ───────────────────────────────────────

    # 1. Direct first-person executive quote
    narr:StyleObs_TanyaRetro_DirectQuote a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro_Inline ;
      rdf:value true ;
      skos:note "Speaker name + colon + quoted speech pattern. CEO voice used to anchor delivery claim." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro_Inline ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 78 ; oa:end 115
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was"
        ]
      ] .

    # 2. Metric assertion with superlative
    narr:StyleObs_TanyaRetro_MetricAssertion a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_TanyaSprintRetro_Inline ;
      rdf:value true ;
      skos:note "Concrete numeric metric (23 points) paired with superlative claim (highest this quarter). Authoritative, data-grounded register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro_Inline ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 116 ; oa:end 161
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Velocity was 23 points, highest this quarter." ;
          oa:prefix "async decision widget. " ;
          oa:suffix " The Zephyr"
        ]
      ] .

    # 3. Causal attribution via definite article + noun phrase
    narr:StyleObs_TanyaRetro_CausalAttribution a narr:StyleObservation ;
      skos:broader narr:VerbChoice ;
      dct:source narr:Sample_TanyaSprintRetro_Inline ;
      rdf:value true ;
      skos:note "'The Zephyr integration was the key unlock' — definite article 'the' before 'key unlock' signals singular causal attribution. Confident, unhedged causal framing." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro_Inline ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 162 ; oa:end 204
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The Zephyr integration was the key unlock." ;
          oa:prefix "highest this quarter. " ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro_Inline ;
      narr:AverageSentenceLength "10"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal ;
