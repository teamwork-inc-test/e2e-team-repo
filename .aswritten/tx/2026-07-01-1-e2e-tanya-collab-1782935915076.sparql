INSERT DATA {
  GRAPH narr:Tx_20260701T200116Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro_Inline a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 207 ;
      dct:description "Inline sprint retrospective note from Tanya (CEO). Single attributed quote covering shipped widget, velocity metric, and Zephyr integration as key unlock." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_Owner_CEO a narr:Actor ;
