# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 213 ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, 23-point velocity (highest this quarter), and Zephyr integration as key unlock. Reviewer phone number redacted per PII policy." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes; first-name-only speaker in discussion note." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      narr:theme "Integration as velocity unlock" ;
      skos:broader narr:TechnologiesSocialSystems ;
      skos:note "The Zephyr integration is framed as the enabling condition that unlocked record sprint velocity, establishing a pattern where third-party integrations are causal levers for team performance." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_VelocityHighestThisQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "Velocity of 23 points reported as highest this quarter — a concrete, time-bounded performance claim." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Claim_AsyncWidgetShipped a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      skos:note "The async decision widget was shipped — a delivery fact asserted by the sprint team member." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Claim_ZephyrWasKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "Zephyr integration identified as the key unlock for the sprint's record velocity — causal attribution by the reporter." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Observations ────────────────────────────────────────────
    narr:Obs_VelocityQuote a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's direct report of 23-point velocity as highest this quarter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 107 ;
        oa:end 163
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter." ;
        oa:prefix "We shipped the async decision widget. " ;
        oa:suffix " The Zephyr integration was the key unlock."
      ] .

    narr:Obs_ZephyrUnlockQuote a narr:Observation ;
      skos:broader narr:TechnologiesSocialSystems ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's causal attribution of Zephyr integration as the key unlock for velocity." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 164 ;
        oa:end 213
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock." ;
        oa:prefix "Velocity was 23 points, highest this quarter. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # Style Obs 1: Metric-anchored declarative sentence
    narr:StyleObs_MetricAnchoredDeclarative a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Declarative sentence anchored by a concrete numeric metric ('23 points') followed by a superlative qualifier ('highest this quarter'). Establishes authority through specificity." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 107 ;
          oa:end 163
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Velocity was 23 points, highest this quarter." ;
          oa:prefix "We shipped the async decision widget. " ;
          oa:suffix " The Zephyr integration was the key unlock."
        ]
      ] .

    # Style Obs 2: Causal 'key unlock' framing
    narr:StyleObs_CausalKeyUnlockFrame a narr:StyleObservation ;
      skos:broader narr:IdiolectPhrasing ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "'Key unlock' is a tech-team idiom used as a causal attribution marker. Compact, jargon-dense phrasing that implies a single enabling dependency without elaboration." ;
      rdf:value true ;
      skos:related narr:JargonPolicy ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 164 ;
          oa:end 213
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The Zephyr integration was the key unlock." ;
          oa:prefix "Velocity was 23 points, highest this quarter. " ;
          oa:suffix ""
        ]
      ] .

    # Style Obs 3: First-person embedded direct quote in retro format
    narr:StyleObs_FirstPersonEmbeddedQuote a narr:StyleObservation ;
      skos:broader narr:FirstPerson ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "The entire retro content is delivered as a first-person direct quote attributed to Tanya ('Tanya: \"...\"'). Speaker-tagged verbatim format typical of async meeting notes." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 55 ;
          oa:end 213
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was 23 points"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength 11 ;
      narr:ActiveVoiceRatio "0.85"^^xsd:decimal ;
      narr:JargonDensity "0.12"^^xsd:decimal ;
      skos:note "Three short declarative sentences averaging ~11 words. High active voice ratio. Moderate jargon density driven by 'async decision widget', 'Zephyr integration', and 'key unlock'." .

  }
