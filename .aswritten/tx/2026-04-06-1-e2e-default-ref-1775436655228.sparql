# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_DefaultRefTest a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Minimal test document asserting that an omitted git ref causes a topic branch to be created. Contains one reviewer entry (PII redacted) and one attributed quote from Tanya." ;
      narr:inputLength 113 .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_DefaultRefTest a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "First-name-only speaker in the Default Ref Test document. Asserts that omitting a ref creates a topic branch." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_OmittedRefTopicBranch a narr:Narrative ;
      narr:theme "Omitted git ref triggers automatic topic branch creation" ;
      skos:broader narr:Process ;
      skos:note "When a ref is omitted from a submission, the system defaults to creating a topic branch rather than failing or using a default branch. This is the primary behavioral assertion of the document." ;
      dct:source narr:Sample_DefaultRefTest .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_TanyaOmittedRefQuote a narr:Observation ;
      skos:broader narr:FrictionFailure ;
      skos:note "Tanya's direct quote asserting the expected system behavior when a ref is omitted." ;
      dct:source narr:Sample_DefaultRefTest ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 65 ;
        oa:end 114
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Claim ───────────────────────────────────────────────────
    narr:Claim_OmittedRefCreatesBranch a narr:Claim ;
      narr:aboutNode narr:Narrative_OmittedRefTopicBranch ;
      narr:hasConvictionLevel narr:Conviction_Notion ;
      narr:supports narr:Process ;
      skos:note "Tanya asserts that omitting a ref in a submission causes the system to create a topic branch. Conviction is Notion — this is a single test assertion, not yet validated by broader evidence." ;
      dct:source narr:Sample_DefaultRefTest .

    # ── Style Observations ──────────────────────────────────────

    # 1. Direct quote attribution with double-quote marks
    narr:StyleObs_DirectQuoteAttribution a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      skos:note "Speaker attribution uses colon-then-quoted-string pattern: 'Tanya: \"...\"'. Direct, conversational attribution style." ;
      rdf:value true ;
      dct:source narr:Sample_DefaultRefTest ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 58 ;
          oa:end 114
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. Terse noun-phrase document title (technical naming convention)
    narr:StyleObs_TerseNounPhraseTitle a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      skos:note "Document title 'Default Ref Test' follows a terse noun-phrase pattern typical of technical test artifact naming — no verb, no article, no punctuation." ;
      rdf:value true ;
      dct:source narr:Sample_DefaultRefTest ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 38 ;
          oa:end 56
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Default Ref Test" ;
          oa:prefix "# " ;
          oa:suffix "\n"
        ]
      ] .

    # 3. First-name-only speaker tagging (informal register)
    narr:StyleObs_FirstNameOnlySpeaker a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      skos:note "Speaker is identified by first name only ('Tanya:') without surname or role qualifier — informal, discussion-note register." ;
      rdf:value false ;
      dct:source narr:Sample_DefaultRefTest ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 58 ;
          oa:end 64
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya:" ;
          oa:prefix "\n\n" ;
          oa:suffix " \""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_DefaultRefTest a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest ;
      narr:AverageSentenceLength 10 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note." .

  }
