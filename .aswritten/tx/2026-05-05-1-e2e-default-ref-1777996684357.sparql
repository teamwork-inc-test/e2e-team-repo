# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250807T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_DefaultRefTest_v32 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v32) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 .

    # ── Observation ─────────────────────────────────────────────
    narr:Obs_DefaultRefTest_v32_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v32 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 79 ;
        oa:end 138
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_DefaultRefTest_v32 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v32 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v31 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

    # ── Style Observations (minimum 3) ──────────────────────────

    # 1. ToneDirectPersonal — Tanya's quote is first-person imperative test assertion
    narr:StyleObs_DefaultRefTest_v32_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v32 ;
      skos:note "Direct personal tone: attributed first-person test assertion by named speaker." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v32 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 66 ;
          oa:end 138
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. JargonPolicy — technical terms 'ref' and 'topic branch' used without definition
    narr:StyleObs_DefaultRefTest_v32_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v32 ;
      skos:note "Git-domain jargon ('ref', 'topic branch') used without definition, assuming reader familiarity." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v32 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 88 ;
          oa:end 138
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch" ;
          oa:prefix "Testing that " ;
          oa:suffix ".\""
        ]
      ] .

    # 3. SpeakerIdiolects — named attribution pattern ("Tanya: \"...\"")
    narr:StyleObs_DefaultRefTest_v32_SpeakerIdiolects a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v32 ;
      skos:note "Speaker attribution pattern: Name followed by colon and double-quoted statement. Consistent idiolect marker across all Default Ref Test versions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v32 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 66 ;
          oa:end 73
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: " ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix "\"Testing"
        ]
      ] .

  }
}