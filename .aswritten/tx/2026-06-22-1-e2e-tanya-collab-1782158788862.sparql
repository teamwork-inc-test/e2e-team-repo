  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "unknown" ;
    dct:title "Tanya Sprint Retro Extraction" ;
    prov:generated
      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Narrative_VelocityRecord_Q,
      narr:Claim_ShippedAsyncWidget,
      narr:Claim_VelocityHighestThisQuarter,
      narr:Claim_ZephyrIntegrationKeyUnlock,
      narr:Obs_TanyaFullQuote,
      narr:StyleObs_FirstPersonPlural,
      narr:StyleObs_ShortPunchyCadence,
      narr:StyleObs_TechnicalJargon,
      narr:StyleObs_QuantifiedAuthoritative,
      narr:StyleMetrics_TanyaSprintRetro .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 197 ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, record velocity of 23 points, and Zephyr integration as key unlock." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes; first-name-only speaker in sprint retro context." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_VelocityRecord_Q a narr:Narrative ;
      narr:theme "Sprint velocity record driven by integration unlock" ;
      skos:broader narr:KPIsSuccess ;
      skos:note "The team achieved its highest velocity this quarter (23 points) by shipping the async decision widget, with the Zephyr integration identified as the key enabling factor." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_ShippedAsyncWidget a narr:Claim ;
      narr:aboutNode narr:Narrative_VelocityRecord_Q ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_VelocityRecord_Q ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Team shipped the async decision widget this sprint." .

    narr:Claim_VelocityHighestThisQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_VelocityRecord_Q ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_VelocityRecord_Q ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points — the highest this quarter." .

    narr:Claim_ZephyrIntegrationKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_VelocityRecord_Q ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_VelocityRecord_Q ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "The Zephyr integration was identified as the key unlock enabling the velocity record." .

    # ── Observation ─────────────────────────────────────────────
    narr:Obs_TanyaFullQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's verbatim sprint retro statement covering shipped widget, velocity, and Zephyr unlock." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 69 ;
        oa:end 197
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. First-person plural voice
    narr:StyleObs_FirstPersonPlural a narr:StyleObservation ;
      skos:broader narr:FirstPerson ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Speaker uses first-person plural ('We shipped') — collective team voice, not individual attribution." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 70 ;
          oa:end 107
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was"
        ]
      ] .

    # 2. Short punchy declarative cadence
    narr:StyleObs_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Three short declarative sentences in sequence; each sentence delivers a single fact with no subordinate clauses. Characteristic sprint retro cadence." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 108 ;
          oa:end 153
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Velocity was 23 points, highest this quarter." ;
          oa:prefix "async decision widget. " ;
          oa:suffix " The Zephyr"
        ]
      ] .

    # 3. Technical jargon density
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Domain-specific terms ('async decision widget', 'Zephyr integration') used without definition, signalling an insider/team audience." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 154 ;
          oa:end 196
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The Zephyr integration was the key unlock." ;
          oa:prefix "highest this quarter. " ;
          oa:suffix "\""
        ]
      ] .

    # 4. Authoritative tone with quantified claim
    narr:StyleObs_QuantifiedAuthoritative a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Specific numeric claim ('23 points') anchored with superlative ('highest this quarter') projects confidence and authority without hedging." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 108 ;
          oa:end 153
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Velocity was 23 points, highest this quarter." ;
          oa:prefix "async decision widget. " ;
          oa:suffix " The Zephyr"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength 9 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.15"^^xsd:decimal ;
      skos:note "Three declarative sentences (~27 words total). All active voice. Jargon terms: 'async decision widget', 'Zephyr integration', 'velocity points' (~4/27 tokens). Register: informal team-internal, high confidence, no hedging." .

  }
}