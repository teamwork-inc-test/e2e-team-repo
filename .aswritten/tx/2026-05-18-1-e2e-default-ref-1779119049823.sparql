      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations ────────────────────────────────────────

    # 1. Direct personal tone — Tanya speaks in first person imperative register
    narr:StyleObs_DefaultRefTest_v50_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v50 ;
      skos:note "Single attributed quote in direct declarative register. Speaker identified by first name only, asserting system behavior as a test observation." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v50 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "63"^^xsd:integer ;
          oa:end "113"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    # 2. Jargon policy — technical terms 'ref' and 'topic branch' used without definition
    narr:StyleObs_DefaultRefTest_v50_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v50 ;
      skos:note "Terms 'ref' and 'topic branch' are git-domain jargon used without definition, assuming reader familiarity. Consistent with all prior versions of this document." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v50 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "82"^^xsd:integer ;
          oa:end "113"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch." ;
          oa:prefix "Testing that " ;
          oa:suffix "\""
        ]
      ] .

    # 3. Speaker idiolects — first-name-only attribution pattern
    narr:StyleObs_DefaultRefTest_v50_SpeakerIdiolects a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v50 ;
      skos:note "Speaker attributed by first name only ('Tanya:') followed by a verbatim quote. This idiolect pattern — name-colon-quote — is the document's sole rhetorical structure." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v50 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "63"^^xsd:integer ;
          oa:end "70"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: " ;
          oa:prefix "\n\n" ;
          oa:suffix "\"Testing"
