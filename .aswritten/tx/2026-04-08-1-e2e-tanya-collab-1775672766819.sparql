# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 213 ;
      dct:description "Inline sprint retrospective note from Tanya covering widget delivery, velocity record, and Zephyr integration unlock." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting on delivery outcomes in a retrospective context. Only first name available." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_HighVelocityDeliveryViaIntegrationUnlock a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "High-velocity delivery enabled by a key integration unlock" ;
      skos:broader narr:Proof ;
      skos:note "The sprint achieved record velocity (23 points, highest this quarter) by shipping the async decision widget, with the Zephyr integration identified as the enabling unlock. Pattern: integration unblocks delivery acceleration." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_AsyncDecisionWidgetShipped a narr:Claim ;
      narr:aboutNode narr:Narrative_HighVelocityDeliveryViaIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_HighVelocityDeliveryViaIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya states the async decision widget was shipped this sprint." .

    narr:Claim_Velocity23PointsHighestThisQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_HighVelocityDeliveryViaIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_HighVelocityDeliveryViaIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points — self-reported as highest this quarter." .

    narr:Claim_ZephyrIntegrationKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_HighVelocityDeliveryViaIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_HighVelocityDeliveryViaIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity gain to the Zephyr integration as the key unlock. Causal attribution from a single speaker; conviction held at Stake." .

    # ── Observation (verbatim quote) ────────────────────────────
    narr:Obs_TanyaVerbatimRetroQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's full retro statement covering shipment, velocity, and Zephyr unlock." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 75 ;
        oa:end 196
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. First-person direct tone
    narr:StyleObs_FirstPersonDirectTone a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Speaker uses first-person plural ('We shipped') for direct, team-attributed delivery claim. Tone is confident and declarative." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 75 ;
          oa:end 97
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was"
        ]
      ] .

    # 2. Sprint/agile jargon density
    narr:StyleObs_SprintJargonDensity a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "High agile/engineering jargon density: 'velocity', 'sprint', 'integration', 'widget', 'unlock' all appear in a 3-sentence passage. Register is insider-technical." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 75 ;
          oa:end 196
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "async decision widget. " ;
          oa:suffix "\""
        ]
      ] .

    # 3. Short punchy cadence — three declarative sentences
    narr:StyleObs_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Three short declarative sentences in sequence: shipped / velocity / unlock. Classic sprint-retro cadence — each sentence is a self-contained fact." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 75 ;
          oa:end 196
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "12"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.35"^^xsd:decimal ;
      skos:note "Three sentences, ~12 words average. All active voice. High jargon density (velocity, sprint, integration, widget, unlock) for a 36-word passage. Register: insider-technical, retrospective oral report." .

  }
}