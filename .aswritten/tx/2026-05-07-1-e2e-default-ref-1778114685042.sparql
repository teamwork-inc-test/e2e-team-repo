# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250815T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_DefaultRefTest_v41 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v41) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 .

    # ── StyleMetrics ─────────────────────────────────────────────
    narr:StyleMetrics_DefaultRefTest_v41 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v41 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v40 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

    # ── Observation: Tanya quote ──────────────────────────────────
    narr:Obs_DefaultRefTest_v41_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v41 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 82 ;
        oa:end 113
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── StyleObservation 1: ToneDirectPersonal ───────────────────
    narr:StyleObs_DefaultRefTest_v41_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v41 ;
      skos:note "Direct first-person attribution via speaker label 'Tanya:' followed by quoted assertion. Informal, declarative register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v41 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 75 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    # ── StyleObservation 2: JargonPolicy ────────────────────────
    narr:StyleObs_DefaultRefTest_v41_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v41 ;
      skos:note "Technical terms 'ref' and 'topic branch' used without definition, presupposing git-literate audience. Jargon is precise and minimal." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v41 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 91 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch." ;
          oa:prefix "Testing that " ;
          oa:suffix "\""
        ]
      ] .

    # ── StyleObservation 3: SpeakerIdiolects ────────────────────
    narr:StyleObs_DefaultRefTest_v41_SpeakerIdiolects a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
