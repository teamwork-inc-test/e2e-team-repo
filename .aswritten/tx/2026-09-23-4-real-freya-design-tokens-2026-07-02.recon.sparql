  GRAPH aswr:Tx_20260923T173238Z {
    narr:Recon_4RealFreyaDesignTokens20260702_1 a narr:Reconciliation ;
        oa:hasTarget narr:Narrative_InstallableExpertise ;
        narr:principal narr:Actor_TanyaTeamowner ;
        skos:note "The idea that the consulting deliverable of the AI age is not a deck but an installable perspective is already established in the perspective as a high-conviction (boulder) claim from March 19 — \"instead of a deck, deliver a perspective the whole org can install,\" with the deck as a derived artifact. What this call adds is (a) **independent validation** of that thesis from a working designer who arrived at it through his own practice, (b) the concrete **design-token ↔ perspective parallel** the graph was explicitly missing, and (c) a **status note**: Tanya has not yet actually delivered an aswritten perspective as a deck-alternative to a consulting client." ;
        narr:extends narr:Position_InstallableExpertiseCategoryMoat ;
        narr:extends narr:Narrative_InstallableExpertise ;
        dct:source narr:Expr_4RealFreyaDesignTokens20260702_3 ;
        dct:source narr:Expr_4RealFreyaDesignTokens20260702_4 ;
