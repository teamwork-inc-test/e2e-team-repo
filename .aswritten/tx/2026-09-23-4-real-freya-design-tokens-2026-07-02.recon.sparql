    narr:Recon_4RealFreyaDesignTokens20260702_2 a narr:Reconciliation ;
        oa:hasTarget narr:Narrative_InstallableExpertise ;
        narr:principal narr:Actor_TanyaTeamowner ;
        skos:note "This is convergent validation from outside aswritten: a designer independently building extraction → tokens → AI-applied output, and naming \"the lens\" as the irreducible, defensible core — the same claim aswritten makes about perspective. It grounds the design-token/perspective parallel and the brand-as-AI-identity endpoint with primary-source material, and it flags a concrete, still-open product move: actually delivering a perspective to a consulting client in place of a deck." ;
        narr:extends narr:Position_InstallableExpertiseCategoryMoat ;
        narr:extends narr:Narrative_InstallableExpertise ;
