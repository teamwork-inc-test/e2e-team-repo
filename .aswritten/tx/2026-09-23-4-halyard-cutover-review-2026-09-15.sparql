                oa:suffix "\n\n**Tina Team:** That job is g" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "1118"^^xsd:integer ;
                oa:end "1139"^^xsd:integer ] ] ;
