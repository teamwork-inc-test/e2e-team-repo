          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " The Zephyr integration"
        ]
      ] .

    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Technical product jargon: 'async decision widget', 'Zephyr integration' — domain-specific terms used without definition, implying insider audience." ;
      oa:hasTarget [
