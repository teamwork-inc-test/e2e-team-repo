# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250130T000000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength "193"^^xsd:integer ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, 23-point velocity (highest this quarter), and Zephyr integration as key unlock." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes; attributed speaker of the retro quote." .

    # ── Narratives ──────────────────────────────────────────────
    narr:Narrative_AsyncWidgetShipped a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Shipping the async decision widget as a sprint milestone" ;
      skos:broader narr:Milestones ;
      skos:note "The team shipped the async decision widget this sprint, marking a concrete product delivery milestone." .

    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Zephyr integration as the key unlock for velocity" ;
      skos:broader narr:DependenciesIntegrations ;
      skos:note "The Zephyr integration is identified as the enabling factor behind the highest-this-quarter velocity of 23 points." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_Velocity23PointsHighest a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetShipped ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncWidgetShipped ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points this sprint, the highest recorded this quarter, as stated by Tanya." .

    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya explicitly attributes the velocity record to the Zephyr integration as the key unlock." .

    # ── Observations ────────────────────────────────────────────
    narr:Observation_AsyncWidgetShipped a narr:Observation ;
      skos:broader narr:Milestones ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya confirms the async decision widget was shipped this sprint." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "68"^^xsd:integer ;
        oa:end "107"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix " Velocity was 23 points"
      ] .

    narr:Observation_VelocityRecord a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Sprint velocity of 23 points is the highest this quarter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "108"^^xsd:integer ;
        oa:end "152"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter." ;
        oa:prefix "shipped the async decision widget. " ;
        oa:suffix " The Zephyr integration"
      ] .

    narr:Observation_ZephyrUnlock a narr:Observation ;
      skos:broader narr:DependenciesIntegrations ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration named as the key unlock enabling the velocity record." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "153"^^xsd:integer ;
        oa:end "193"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock." ;
        oa:prefix "highest this quarter. " ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_DirectQuoteVoice a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "First-person direct quote from Tanya; conversational and assertive register." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "60"^^xsd:integer ;
