    narr:Expr_5RealXavierAndTanya60Mins20260720_75 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Tanya introduces aswritten AI" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "I don't know what this is. The last thing you told me about is trying to narrative for, like, a voice for an organization such that everyone can speak in the same way." ;
                oa:prefix "ast fall?\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** Yeah. So it " ] ;
