    narr:Expr_5RealXavierAndTanya60Mins20260720_88 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Demoing provenance, gap analysis, graph queries" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Interesting. I will. Yeah. So here you see the full provenance, right? And it can pull in things like which actor influenced this decision, at what exact time? And give you here in the March 7 weekly call with Tina, here's the quote and here's the decision level effect in the graph and so on and so forth. We can also ask what's missing in our understanding of YC and fundraising. And just like inherent in the structure, right, there's gaps. Gap analysis is now in the graph. So not only does AI now know what it knows and able to cite it back to full provenance, it also knows what it doesn't know and can tell you exactly what's missing, what's near, what's missing, what it thinks you should do to connect to what's to fill what's missing, so on and so forth." ;
                oa:prefix "ed for data.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Absolutel" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "17362"^^xsd:integer ;
                oa:end "18126"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

