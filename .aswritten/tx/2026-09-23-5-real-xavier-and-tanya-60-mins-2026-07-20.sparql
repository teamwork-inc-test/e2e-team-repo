    narr:Expr_5RealXavierAndTanya60Mins20260720_90 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Demoing transcript annotation, clarifications, post-call reconciliation" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "This approach lets you aggregate. Hold on, where is. Aggregate calls across transcripts, across all sorts of different stuff. So you have your transcripts from calls, you have your transcripts from MCP sessions that summarize decisions happening while coding. You have directly updated notes on and so forth. And that's all pulled in directly. Here's an example of one of the annotated transcripts. We see my statements, we have analysis of its conviction and its dimensions and so on and so forth. And then we can also get clarification reactions from every single statement. So it'll say, hey, actually this wasn't clear. Did you mean to shift the graph in this direction or this direction? And that concept actually extends onto the notification surface. So like when you're doing. When you submit, when a new call comes in, it will email not only you, but actually all of the attendees or this part is in development. Actually you'll have to tell me after this if it emails you. I was just playing with this last week, emails the attendees and says here's what happened in the call. Here's what you said that we weren't sure about. Please confirm whether it was more this way or more this way or add as much as you want and you can respond to this with as much input as you want and that will add to. It basically adds it to the transcript and then adds that as a reconciliation statement into the graph that references the nodes from that call." ;
                oa:prefix " Absolutely.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Yeah. One" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "18176"^^xsd:integer ;
                oa:end "19625"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

