            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Yeah. One of the challenges that is like how do you deal with authority? Who's authoritative on a particular change?" ;
                oa:prefix "hat call.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** That is if I" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "19646"^^xsd:integer ;
                oa:end "19762"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

    narr:Expr_5RealXavierAndTanya60Mins20260720_92 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Authority and weight in graph updates" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "That is if I say, oh, we're doing blank and somebody else says we're not, how do you score that? So my approach is that the graph witnesses what was said and its role is to encode what was said and relate that to all of these statements. It also, The graph does not encode the analysis of what that means. Right. So authority would be read time by saying, okay, like I understand while reading this that Tanya is founder of this organization and this person is advisor. Like I'm going to weight these statements in this way and the graph has the ability to connect those things. But that's not like pre summarized inside of the digest. Right?" ;
                oa:prefix "ular change?\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Yeah, tha" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "19780"^^xsd:integer ;
                oa:end "20422"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

    narr:Expr_5RealXavierAndTanya60Mins20260720_93 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "question" ;
        narr:context "Entity resolution / John Smith problem" ;
        skos:note "Performs an exploratory question/challenge" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Yeah, that makes sense. Then the other thing that I found is an interesting challenge is like entity resolution. Like how do you, how do you stop. It's like I call it the John Smith problem. Like an organization has 15 John Smiths. How do you disambiguate between them? I'm friends with 15 John Smiths. How do I like ensure that this John Smith isn't like not that John. They're like, they're distinct John Smiths. They don't get things attributed to each other. That's another like challenge that I have found in my, in my world." ;
                oa:prefix "t. Right?\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** So I think l" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "20443"^^xsd:integer ;
                oa:end "20973"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

    narr:Expr_5RealXavierAndTanya60Mins20260720_94 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Modeling speech/positions vs entity facts" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "So I think like yeah, the way I've been thinking that the, the actor case is particularly interesting that the general case about entities. So one of the big differences between the way I've been modeling data is that I am not modeling facts in the graph. I am not modeling the relationship between entities that are pulled out as such. Right. If you mentioned dolt, a node for dolt does not get created in the graph." ;
                oa:prefix "in my world.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Interesti" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "20991"^^xsd:integer ;
                oa:end "21408"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

    narr:Expr_5RealXavierAndTanya60Mins20260720_95 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "expressive" ;
        narr:context "Modeling speech/positions vs entity facts" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Interesting." ;
                oa:prefix "he graph.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** The graph mo" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "21429"^^xsd:integer ;
                oa:end "21441"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

    narr:Expr_5RealXavierAndTanya60Mins20260720_96 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Modeling speech/positions vs entity facts" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "The graph models conversation. A statement in which Xavier said you should really check out dolt exists in the graph that actually creates a position above it that says it's important to consider data versus file text modeling in version control software or something like that where your statement and the other statements we set around it support this position. Because of that, it doesn't matter what's said. And there's never like the entity resolution again is done at read time by the LLM that now gets all of it and must decide what is important and what's not for the particular context. And the same does work for actors to a large degree. Actually. We humans have that same ambiguity. Although you do have object permanence and you can think of. I can conceive of the many different Xaviers. I can also have a document that just says Xavier said blank. And I actually don't disambiguate that until I read it in a certain context. And then I'm like, ah, that's probably this Xavier. And so all of the statements about Xavier can coexist until you need to parse them out, right?" ;
                oa:prefix "Interesting.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Yeah, I m" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "21459"^^xsd:integer ;
                oa:end "22545"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

    narr:Expr_5RealXavierAndTanya60Mins20260720_97 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "assertive" ;
        narr:context "Entity resolution at generation vs storage" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Yeah, I mean, that's true. But then parsing them out, you have to then instead of like Schrodinger's cat, resolve them to something." ;
                oa:prefix "t, right?\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** Well, resolv" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "22566"^^xsd:integer ;
                oa:end "22698"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

    narr:Expr_5RealXavierAndTanya60Mins20260720_98 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "assertive" ;
        narr:context "Entity resolution at generation vs storage" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Well, resolve. That's the interesting thing about LLMs is like the resolve moment happens that generation time. Right. Like it doesn't necessarily have to resolve everything or it has to, doesn't have to resolve all things. That said, I did just do a whole pass on actor resolution and like trying to get these things more distinct so I understand both sides." ;
                oa:prefix "o something.\n\n**Tanya Team:** " ;
                oa:suffix "\n\n**Xavier Expert:** Yeah, I m" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
                oa:start "22716"^^xsd:integer ;
                oa:end "23075"^^xsd:integer ] ] ;
        prov:generatedAtTime "2026-09-23T18:44:45Z"^^xsd:dateTime .

    narr:Expr_5RealXavierAndTanya60Mins20260720_99 a narr:Expression ;
        narr:actor narr:Actor_XavierExpert ;
        narr:act "question" ;
        narr:context "Transitioning to fundraising and help needed" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Yeah, I mean the problem is like my, my thing is like, is essentially all about actor resolution. Like that is the crux of it. That's one of the core things that it has to do. Awesome. How can I be helpful? What would you like?" ;
                oa:prefix "th sides.\n\n**Xavier Expert:** " ;
                oa:suffix "\n\n**Tanya Team:** Well, I am j" ] ;
            oa:hasSelector [ a oa:TextPositionSelector ;
