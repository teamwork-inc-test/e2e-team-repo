        narr:act "assertive" ;
        narr:context "Storage recommendations: Dolt vs Git" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Git is not ideal for data, it is not designed for data. Dolt is designed for data." ;
