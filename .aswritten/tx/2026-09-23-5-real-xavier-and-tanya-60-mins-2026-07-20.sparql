    narr:Expr_5RealXavierAndTanya60Mins20260720_102 a narr:Expression ;
        narr:actor narr:Actor_TanyaTeam ;
        narr:act "directive" ;
        narr:context "Tanya's fundraising, pricing, and enterprise pipeline" ;
        skos:note "Requesting intros to customers and funders" ;
        oa:hasTarget [ a oa:SpecificResource ;
