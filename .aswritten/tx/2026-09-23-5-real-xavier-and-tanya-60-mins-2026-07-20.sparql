        narr:act "assertive" ;
        narr:context "Debating incumbent switching costs and commodification" ;
        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Because it had web browsing. Right. And so like the, the like, if there's an incumbent, right, who has a beachhead already, there's nothing that prevents them from like doing a shitty job. But it's enough that like the intrinsic cost of switching would be too high to a new thing. Right? So like you,." ;
                oa:prefix "browsing.\n\n**Xavier Expert:** " ;
