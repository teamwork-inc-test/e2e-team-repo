        oa:hasTarget [ a oa:SpecificResource ;
            oa:hasSource narr:Sample_5RealXavierAndTanya60Mins20260720 ;
            oa:hasSelector [ a oa:TextQuoteSelector ;
                oa:exact "Okay, and what is. So what do you mean by both those in this context?" ;
                oa:prefix "re pointing.\n\n**Tanya Team:** " ;
