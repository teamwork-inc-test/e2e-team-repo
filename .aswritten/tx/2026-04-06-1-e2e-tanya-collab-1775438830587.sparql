PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "main" ;
    dct:title "Tanya Sprint Retro extraction" ;
    prov:generated
      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Narrative_AsyncWidgetDelivery,
      narr:Claim_AsyncWidgetShipped,
      narr:Claim_VelocityRecord,
      narr:Claim_ZephyrKeyUnlock,
      narr:Obs_TanyaQuote_WidgetShipped,
      narr:Obs_TanyaQuote_VelocityRecord,
      narr:Obs_TanyaQuote_ZephyrUnlock,
      narr:StyleObs_FirstPersonPlural,
      narr:StyleObs_ShortDeclarativeCadence,
      narr:StyleObs_TechJargonTerms,
      narr:StyleMetrics_TanyaSprintRetro .
} ;

# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 197 ;
      dct:description "Sprint retrospective note from Tanya reporting widget delivery, velocity record, and Zephyr integration unlock. Reviewer phone number redacted per PII policy." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes. First-name-only speaker in retro note; domain suffix _SprintRetro added to avoid collisions." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_AsyncWidgetDelivery a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Successful sprint delivery driven by a key integration unlock" ;
      skos:broader narr:Proof ;
      skos:note "The team shipped the async decision widget at record velocity (23 points, highest this quarter), with the Zephyr integration identified as the enabling factor. Pattern: integration unlock → velocity breakthrough → delivery milestone." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_AsyncWidgetShipped a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetDelivery ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncWidgetDelivery ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya asserts the async decision widget was shipped this sprint." .

    narr:Claim_VelocityRecord a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetDelivery ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncWidgetDelivery ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity of 23 points reported as highest this quarter — a quantified performance milestone." .

    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetDelivery ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_AsyncWidgetDelivery ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity breakthrough to the Zephyr integration as the key unlock." .

    # ── Observations (grounded quotes) ──────────────────────────
    narr:Obs_TanyaQuote_WidgetShipped a narr:Observation ;
      skos:broader narr:CaseResults ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya confirms widget shipment in sprint retro." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 71 ;
        oa:end 108
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix " Velocity was 23 points"
      ] .

    narr:Obs_TanyaQuote_VelocityRecord a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Quantified velocity claim: 23 points, highest this quarter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 109 ;
        oa:end 154
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter." ;
        oa:prefix "async decision widget. " ;
        oa:suffix " The Zephyr integration"
      ] .

    narr:Obs_TanyaQuote_ZephyrUnlock a narr:Observation ;
      skos:broader narr:InflectionPoints ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration named as the causal unlock for sprint velocity." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 155 ;
        oa:end 197
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock." ;
        oa:prefix "highest this quarter. " ;
        oa:suffix ""
      ] .

    # ── Style Observations ──────────────────────────────────────
    narr:StyleObs_FirstPersonPlural a narr:StyleObservation ;
      skos:broader narr:FirstPerson ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Speaker uses first-person plural ('We shipped') — collective ownership framing, team voice." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 71 ;
          oa:end 108
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was 23 points"
        ]
      ] .

    narr:StyleObs_ShortDeclarativeCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Three short declarative sentences in sequence — punchy retro cadence. Each sentence delivers one fact with no hedging." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 71 ;
          oa:end 197
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_TechJargonTerms a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Domain-specific jargon used without definition: 'async decision widget', 'Zephyr integration', 'velocity' (agile metric). Assumes insider audience." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 71 ;
          oa:end 197
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget" ;
          oa:prefix "We shipped the " ;
          oa:suffix ". Velocity was 23"
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "14"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Three sentences, all active voice, high jargon density for an insider retro audience. Avg sentence length ~14 words. Register: informal-professional, first-person plural, zero hedging." .

  }
}