PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# ── Transaction provenance (default graph) ──────────────────────
INSERT DATA {
  narr:Tx_20250714T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "inline-memory/tanya-sprint-retro" ;
    narr:originRef "main" ;
    dct:title "Tanya Sprint Retro Extraction" ;
    prov:generated
      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Claim_AsyncWidgetShipped,
      narr:Claim_VelocityHighestQuarter,
      narr:Claim_ZephyrKeyUnlock,
      narr:Observation_SprintRetroStatement,
      narr:StyleObs_DirectQuoteAttribution,
      narr:StyleObs_TelegraphicCadence,
      narr:StyleObs_TechnicalJargon,
      narr:StyleMetrics_TanyaSprintRetro .
} ;

# ── Extracted entities (named graph) ────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250714T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 213 ;
      dct:description "Sprint retrospective note from Tanya reporting velocity, widget delivery, and Zephyr integration. Reviewer phone number redacted (PII)." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member and speaker in retrospective. Reported on async decision widget delivery and Zephyr integration outcome." .

    # ── Claim 1: Async decision widget shipped ───────────────────
    narr:Claim_AsyncWidgetShipped a narr:Claim ;
      narr:aboutNode narr:ModulesCapabilities ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      skos:note "Tanya states the async decision widget was shipped during this sprint." ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:supports narr:Outcomes .

    # ── Claim 2: Velocity 23 points — highest this quarter ───────
    narr:Claim_VelocityHighestQuarter a narr:Claim ;
      narr:aboutNode narr:NorthStarMetrics ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      skos:note "Sprint velocity was 23 points, reported as the highest this quarter." ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:supports narr:KPIsSuccess .

    # ── Claim 3: Zephyr integration was the key unlock ───────────
    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:DependenciesIntegrations ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      skos:note "Tanya attributes the velocity achievement to the Zephyr integration as the key enabling factor." ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:supports narr:Claim_VelocityHighestQuarter .

    # ── Observation: Sprint retro statement (grounded quote) ─────
    narr:Observation_SprintRetroStatement a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's verbatim retrospective statement covering delivery, velocity, and integration." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 68 ;
        oa:end 213
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observation 1: Direct quote attribution ────────────
    narr:StyleObs_DirectQuoteAttribution a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "First-person plural direct quote attributed to named speaker (Tanya), creating immediate accountability and ownership." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 61 ;
          oa:end 75
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the" ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "async decision widget."
        ]
      ] .

    # ── Style Observation 2: Telegraphic declarative cadence ─────
    narr:StyleObs_TelegraphicCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Three short declarative sentences in sequence, each a self-contained fact. No conjunctions or hedging. Telegraphic sprint-report register." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 68 ;
          oa:end 155
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " The Zephyr integration"
        ]
      ] .

    # ── Style Observation 3: Technical jargon density ────────────
    narr:StyleObs_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Domain-specific terms used without definition: 'async decision widget', 'Zephyr integration', 'velocity'. Assumes shared sprint/agile context with audience." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 155 ;
          oa:end 213
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The Zephyr integration was the key unlock." ;
          oa:prefix "highest this quarter. " ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "10"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.30"^^xsd:decimal ;
      skos:note "Three sentences, all active voice, ~10 words each. High jargon density for a short retro note: async decision widget, Zephyr integration, velocity points." .

  }
}