PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Transaction provenance
INSERT DATA {
  narr:Tx_20250522T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-05-22T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "add" ;
    narr:originRef "topic-branch-test" ;
    prov:generated narr:Sample_DefaultRefTest_v34, narr:Observation_TanyaOmittedRefQuote_v34, narr:StyleMetrics_v34, narr:StyleObs_ToneDirect_v34, narr:StyleObs_Jargon_v34, narr:StyleObs_ActiveVoice_v34 .
} ;

# Extracted entities
INSERT DATA {
  GRAPH narr:Tx_20250522T120000Z {
    narr:Sample_DefaultRefTest_v34 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Tanya testing system behavior when git ref is omitted, confirming topic branch creation." ;
      narr:inputLength 113 .

    narr:Observation_TanyaOmittedRefQuote_v34 a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v34 ;
      skos:note "Tanya's direct assertion regarding topic branch creation on omitted ref." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 55 ;
        oa:end 111
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    narr:StyleMetrics_v34 a narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v34 ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength 9 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal .

    narr:StyleObs_ToneDirect_v34 a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v34 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v34 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 55 ; oa:end 111 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "Testing that omitted ref creates a topic branch." ]
      ] .

    narr:StyleObs_Jargon_v34 a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v34 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v34 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 97 ; oa:end 109 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "topic branch" ]
      ] .

    narr:StyleObs_ActiveVoice_v34 a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_DefaultRefTest_v34 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v34 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 55 ; oa:end 111 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "Testing that omitted ref creates a topic branch." ]
      ] .
  }
} ;

# Update existing Claim with new evidence link
DELETE {
  GRAPH ?g {
    narr:Claim_OmittedRefCreatesBranch narr:evidencedBy ?oldEvidence .
  }
}
INSERT {
  GRAPH narr:Tx_20250522T120000Z {
    narr:Claim_OmittedRefCreatesBranch narr:evidencedBy narr:Observation_TanyaOmittedRefQuote_v34 .
  }
}
WHERE {
  GRAPH ?g {
    narr:Claim_OmittedRefCreatesBranch a narr:Claim .
    OPTIONAL { narr:Claim_OmittedRefCreatesBranch narr:evidencedBy ?oldEvidence }
  }
}