INSERT DATA {
  GRAPH narr:Tx_20250809T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_DefaultRefTest_v35 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v35) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 ;
      narr:styleProfile "<https://aswritten.ai/narrative#JargonPolicy>\n<https://aswritten.ai/narrative#SpeakerIdiolects>\n<https://aswritten.ai/narrative#ToneDirectPersonal>" .

    # ── StyleMetrics ────────────────────────────────────────────
    narr:StyleMetrics_DefaultRefTest_v35 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v35 ;
      skos:note "Single-sentence body. Active voice throughout. Mild technical jargon: 'ref', 'topic branch'. Register: informal test note. Consistent with v1–v34 metrics." ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.2"^^xsd:decimal .

    # ── Observation ─────────────────────────────────────────────
    narr:Obs_DefaultRefTest_v35_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v35 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 72 ;
        oa:end 130
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── StyleObservation 1: ToneDirectPersonal ───────────────────
    narr:StyleObs_DefaultRefTest_v35_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v35 ;
      skos:note "Direct first-name attribution ('Tanya:') signals an informal, personal register — speaker is named and speaks in first person via quoted assertion." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v35 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 55 ;
          oa:end 72
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix " omitted ref creates"
        ]
      ] .

    # ── StyleObservation 2: JargonPolicy ────────────────────────
    narr:StyleObs_DefaultRefTest_v35_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v35 ;
      skos:note "Technical terms 'ref' and 'topic branch' are used without definition, presupposing a git-literate audience. Jargon is precise and minimal." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v35 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 88 ;
          oa:end 130
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch." ;
          oa:prefix "Testing that " ;
          oa:suffix "\""
        ]
      ] .

    # ── StyleObservation 3: SpeakerIdiolects ────────────────────
    narr:StyleObs_DefaultRefTest_v35_SpeakerIdiolects a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v35 ;
      skos:note "Single attributed speaker (Tanya) with a terse, declarative idiolect. The quote is a complete, self-contained test assertion — no hedging, no elaboration." ;
      rdf:value true ;
