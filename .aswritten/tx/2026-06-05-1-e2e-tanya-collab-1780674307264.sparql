PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX oa:   <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250115T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-01-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "unknown" ;
    narr:originRef "main" ;
    dct:title "Tanya Sprint Retro extraction" ;
    prov:generated
      narr:Sample_TanyaSprintRetro,
      narr:Actor_Tanya_SprintRetro,
      narr:Narrative_VelocityRecord_Q_AsyncWidget,
      narr:Claim_ShippedAsyncDecisionWidget,
      narr:Claim_VelocityHighestThisQuarter,
      narr:Claim_ZephyrIntegrationKeyUnlock,
      narr:Obs_TanyaRetroQuote,
      narr:StyleObs_FirstPersonDirectSpeech,
      narr:StyleObs_TripartiteStructure,
      narr:StyleObs_TechnicalJargonZephyr,
      narr:StyleMetrics_TanyaSprintRetro .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength "175"^^xsd:integer ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, velocity of 23 points (highest this quarter), and Zephyr integration as key unlock. Reviewer phone number redacted per PII policy." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes. Full surname not provided in source." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_VelocityRecord_Q_AsyncWidget a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "Sprint velocity record driven by async decision widget and Zephyr integration" ;
      skos:broader narr:KPIsSuccess ;
      skos:note "The team achieved its highest quarterly velocity (23 points) by shipping the async decision widget, with the Zephyr integration identified as the critical enabling factor." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_ShippedAsyncDecisionWidget a narr:Claim ;
      narr:aboutNode narr:Narrative_VelocityRecord_Q_AsyncWidget ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_VelocityRecord_Q_AsyncWidget ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya states the async decision widget was shipped this sprint." .

    narr:Claim_VelocityHighestThisQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_VelocityRecord_Q_AsyncWidget ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_VelocityRecord_Q_AsyncWidget ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points, stated as the highest this quarter." .

    narr:Claim_ZephyrIntegrationKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_VelocityRecord_Q_AsyncWidget ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_VelocityRecord_Q_AsyncWidget ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity achievement to the Zephyr integration as the key unlock." .

    # ── Observation (grounded quote) ────────────────────────────
    narr:Obs_TanyaRetroQuote a narr:Observation ;
      skos:broader narr:Quotes ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya's verbatim retrospective statement covering shipped widget, velocity, and Zephyr unlock." ;
      oa:hasSelector [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "60"^^xsd:integer ;
          oa:end "175"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock."^^xsd:string ;
          oa:prefix "Tanya: \""^^xsd:string ;
          oa:suffix "\""^^xsd:string
        ]
      ] .

    # ── Style Observations ──────────────────────────────────────

    # 1. First-person direct speech / authoritative tone
    narr:StyleObs_FirstPersonDirectSpeech a narr:StyleObservation ;
      skos:broader narr:ToneAuthoritative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Speaker uses first-person plural ('We shipped') for direct, authoritative ownership of outcomes." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "60"^^xsd:integer ;
          oa:end "83"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget."^^xsd:string ;
          oa:prefix "Tanya: \""^^xsd:string ;
          oa:suffix " Velocity was"^^xsd:string
        ]
      ] .

    # 2. Short punchy cadence — three declarative sentences
    narr:StyleObs_TripartiteStructure a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Three short declarative sentences in sequence: shipped → velocity → unlock. Classic tripartite retro cadence." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "60"^^xsd:integer ;
          oa:end "175"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock."^^xsd:string ;
          oa:prefix "Tanya: \""^^xsd:string ;
          oa:suffix "\""^^xsd:string
        ]
      ] .

    # 3. Technical jargon / product naming
    narr:StyleObs_TechnicalJargonZephyr a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Uses product-specific jargon: 'async decision widget' and integration name 'Zephyr' without definition, assuming shared team context." ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "130"^^xsd:integer ;
          oa:end "175"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "The Zephyr integration was the key unlock."^^xsd:string ;
          oa:prefix "highest this quarter. "^^xsd:string ;
          oa:suffix "\""^^xsd:string
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "11"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.18"^^xsd:decimal ;
      skos:note "Three sentences averaging ~11 words each. All active voice. Jargon density elevated by domain-specific terms: 'async decision widget', 'Zephyr integration', 'velocity', 'sprint'." .

  }
}