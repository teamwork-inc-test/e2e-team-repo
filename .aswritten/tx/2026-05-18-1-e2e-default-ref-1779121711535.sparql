PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX oa: <http://www.w3.org/ns/oa#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250823T120000Z a prov:Activity ;
    prov:generatedAtTime "2025-08-23T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "add" ;
    narr:originRef "topic-branch-test" ;
    prov:generated narr:Sample_DefaultRefTest_v51, narr:StyleMetrics_DefaultRefTest_v51, narr:Obs_DefaultRefTest_v51_TanyaQuote .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250823T120000Z {
    narr:Sample_DefaultRefTest_v51 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Tanya testing system behavior when git ref is omitted, confirming topic branch creation." ;
      narr:inputLength 113 .

    narr:StyleMetrics_DefaultRefTest_v51 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v51 ;
      narr:AverageSentenceLength 9 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal ;
      skos:note "Single sentence, active voice, technical jargon." .

    narr:Obs_DefaultRefTest_v51_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v51 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 55 ;
        oa:end 110
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    narr:StyleObs_v51_Jargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v51 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v51 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 96 ; oa:end 108 ] ;
        oa:hasSelector [ oa:exact "topic branch" ]
      ] .

    narr:StyleObs_v51_ActiveVoice a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_DefaultRefTest_v51 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v51 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 55 ; oa:end 110 ] ;
        oa:hasSelector [ oa:exact "Testing that omitted ref creates a topic branch." ]
      ] .

    narr:StyleObs_v51_DirectTone a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v51 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v51 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 55 ; oa:end 110 ] ;
        oa:hasSelector [ oa:exact "Testing that omitted ref creates a topic branch." ]
      ] .
  }
}
