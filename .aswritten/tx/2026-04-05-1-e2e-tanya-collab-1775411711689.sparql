# ── Extracted entities (named graph) ────────────────────────────────────────
INSERT DATA {
  GRAPH narr:Tx_20250115T120000Z {

    # ── Sample ──────────────────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength 185 ;
      dct:description "Sprint retrospective note from Tanya reporting shipped async decision widget, record velocity of 23 points, and Zephyr integration as the key unlock." .

    # ── Actor ───────────────────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting retrospective outcomes; reviewer contact redacted per PII policy." .

    # ── Narratives ──────────────────────────────────────────────────────────
    narr:Narrative_AsyncWidgetShipped a narr:Narrative ;
      narr:theme "Async decision widget shipped" ;
      skos:broader narr:Milestones ;
      skos:note "The team successfully shipped the async decision widget this sprint, achieving the highest velocity of the quarter at 23 points." ;
      dct:source narr:Sample_TanyaSprintRetro .

    narr:Narrative_ZephyrIntegrationUnlock a narr:Narrative ;
      narr:theme "Zephyr integration as key unlock" ;
      skos:broader narr:DependenciesIntegrations ;
      skos:note "The Zephyr integration was identified as the key unlock enabling the sprint's record velocity and successful widget delivery." ;
      dct:source narr:Sample_TanyaSprintRetro .

    # ── Claims ──────────────────────────────────────────────────────────────
    narr:Claim_VelocityRecord a narr:Claim ;
      narr:aboutNode narr:Narrative_AsyncWidgetShipped ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_AsyncWidgetShipped ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points — stated as highest this quarter. Direct first-person assertion from sprint participant." .

    narr:Claim_ZephyrKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_ZephyrIntegrationUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrIntegrationUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration described as 'the key unlock' — causal attribution without further evidence in this note." .

    # ── Observations ────────────────────────────────────────────────────────
    narr:Obs_ShippedWidget a narr:Observation ;
      skos:broader narr:Milestones ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya confirms async decision widget was shipped this sprint." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 70 ;
        oa:end 107
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix " Velocity was"
      ] .

    narr:Obs_VelocityPoints a narr:Observation ;
      skos:broader narr:NorthStarMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity of 23 points recorded as highest this quarter." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 108 ;
        oa:end 155
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Velocity was 23 points, highest this quarter." ;
        oa:prefix "async decision widget. " ;
        oa:suffix " The Zephyr"
      ] .

    narr:Obs_ZephyrUnlock a narr:Observation ;
      skos:broader narr:DependenciesIntegrations ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Zephyr integration attributed as the key unlock for sprint success." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 156 ;
        oa:end 205
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "The Zephyr integration was the key unlock." ;
        oa:prefix "highest this quarter. " ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────────────────
    narr:StyleObs_DirectFirstPerson a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "First-person plural ('We shipped') establishes direct, participatory voice typical of retro reporting." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 70 ;
          oa:end 107
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was"
        ]
      ] .

    narr:StyleObs_JargonTechTerms a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Technical jargon cluster: 'async', 'Zephyr integration', 'velocity points' — assumes engineering audience fluency." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 78 ;
          oa:end 205
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "We shipped the " ;
          oa:suffix "\""
        ]
      ] .

    narr:StyleObs_ShortPunchyCadence a narr:StyleObservation ;
      skos:broader narr:ShortPunchyCadence ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Three short declarative sentences in sequence: shipped → velocity → unlock. Classic retro cadence — outcome, metric, cause." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 70 ;
          oa:end 205
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength 12 ;
      narr:ActiveVoiceRatio "0.95"^^xsd:decimal ;
      narr:JargonDensity "0.25"^^xsd:decimal ;
      skos:note "Three short declarative sentences averaging ~12 words. Near-total active voice. Moderate jargon density driven by 'async', 'velocity', 'Zephyr integration'. Register: informal engineering retro." .

  }
}