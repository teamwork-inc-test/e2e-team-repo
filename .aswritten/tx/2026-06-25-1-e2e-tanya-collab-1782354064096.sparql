          oa:suffix " the async decision"
        ]
      ] .

    narr:StyleObs_JargonKeyUnlock a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      rdf:value true ;
      skos:note "Domain jargon cluster: 'async decision widget', 'velocity', 'Zephyr integration', 'key unlock' — dense technical/agile vocabulary in a short passage." ;
      oa:hasTarget [
