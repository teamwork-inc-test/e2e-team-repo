      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_ZephyrUnlockVelocityRecord ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity achievement to the Zephyr integration as 'the key unlock' — a causal claim asserted but not independently verified in this memory." .

    # ── Observations (grounded quotes) ──────────────────────────
    narr:Obs_TanyaQuote_WeShipped a narr:Observation ;
      skos:broader narr:CaseResults ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya confirms widget delivery." ;
      oa:hasSelector [
