PREFIX narr: <https://aswritten.ai/narrative#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Transaction provenance (default graph)
INSERT DATA {
  narr:Tx_20250714T120001Z a prov:Activity ;
    prov:generatedAtTime "2025-07-14T12:00:01Z"^^xsd:dateTime ;
    prov:wasAssociatedWith "aswritten.ai" ;
    prov:wasAttributedTo "n8n.aswritten.ai" ;
    narr:originPath "---\nreviewers:\n  - +15005550006\n---\n\n# Default Ref Test\n\nTanya: \"Testing that omitted ref creates a topic branch.\"" ;
    narr:originRef "main@unknown" ;
    prov:generated narr:Sample_DefaultRefTest_Update, narr:StyleObservation_QuotedAssertion, narr:StyleObservation_TechnicalJargon, narr:StyleObservation_DirectAddress, narr:StyleMetrics_DefaultRefTest_Update .
} ;

# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250714T120001Z {
    # Style Observations
    narr:StyleObservation_QuotedAssertion a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 51 ; oa:end 106 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ; oa:prefix "# Default Ref Test\n\n" ; oa:suffix "" ]
      ] ;
      skos:note "Direct attribution of a test assertion using quotation marks." .

    narr:StyleObservation_TechnicalJargon a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 73 ; oa:end 105 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "omitted ref creates a topic branch" ; oa:prefix "Testing that " ; oa:suffix ".\"" ]
      ] ;
      skos:note "Use of git-specific technical terminology ('ref', 'topic branch')." .

    narr:StyleObservation_DirectAddress a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_DefaultRefTest ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 51 ; oa:end 56 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "Tanya" ; oa:prefix "" ; oa:suffix ": \"Testing" ]
      ] ;
      skos:note "Speaker identification prefixing the assertion." .

    # Style Metrics (Update/Refinement)
    narr:StyleMetrics_DefaultRefTest_Update a narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest ;
      skos:broader narr:StyleMetrics ;
      narr:AverageSentenceLength 10 ;
      narr:ActiveVoiceRatio 1.0 ;
      narr:JargonDensity 0.30 ;
      skos:note "Updated metrics based on the specific 10-word assertion." .
  }
}