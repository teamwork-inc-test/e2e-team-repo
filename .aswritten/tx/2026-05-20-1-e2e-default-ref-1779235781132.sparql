    narr:Sample_DefaultRefTest_v71 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Tanya testing system behavior when git ref is omitted, confirming topic branch creation." ;
      narr:inputLength 113 .

    narr:StyleMetrics_DefaultRefTest_v71 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v71 ;
      narr:AverageSentenceLength 9 ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.22"^^xsd:decimal ;
      skos:note "Single sentence, active voice, technical jargon." .

    narr:Observation_TanyaOmittedRefQuote_v71 a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v71 ;
      skos:note "Tanya's direct assertion regarding topic branch creation on omitted ref." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 54 ;
        oa:end 107
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    narr:StyleObs_DirectTone_v71 a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v71 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v71 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 54 ; oa:end 107 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "Testing that omitted ref creates a topic branch." ]
      ] .

    narr:StyleObs_ActiveVoice_v71 a narr:StyleObservation ;
      skos:broader narr:VoiceActive ;
      dct:source narr:Sample_DefaultRefTest_v71 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v71 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 54 ; oa:end 107 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; oa:exact "creates a topic branch" ]
      ] .

    narr:StyleObs_Jargon_v71 a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v71 ;
      skos:note "Use of technical terms 'ref' and 'topic branch'." ;
      oa:hasTarget [
