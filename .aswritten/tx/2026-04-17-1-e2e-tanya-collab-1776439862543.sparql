# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250130T000000Z {

    # ── Sample ──────────────────────────────────────────────────
    narr:Sample_TanyaSprintRetro a narr:Sample ;
      dct:title "Tanya's Sprint Retro" ;
      narr:inputLength "185"^^xsd:integer ;
      dct:description "Sprint retrospective note attributed to Tanya, covering widget delivery, velocity metric, and Zephyr integration unlock." .

    # ── Actor ───────────────────────────────────────────────────
    narr:Actor_Tanya_SprintRetro a narr:Actor ;
      skos:prefLabel "Tanya" ;
      skos:note "Sprint team member reporting on delivery outcomes in retrospective context." .

    # ── Narrative ───────────────────────────────────────────────
    narr:Narrative_HighVelocityDeliveryZephyrUnlock a narr:Narrative ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:theme "High-velocity delivery enabled by integration unlock" ;
      skos:broader narr:KPIsSuccess ;
      skos:note "The sprint achieved record velocity (23 points, highest this quarter) by shipping the async decision widget, with the Zephyr integration identified as the key enabling factor." .

    # ── Claims ──────────────────────────────────────────────────
    narr:Claim_Velocity23PointsHighestQuarter a narr:Claim ;
      narr:aboutNode narr:Narrative_HighVelocityDeliveryZephyrUnlock ;
      narr:hasConvictionLevel narr:Conviction_Boulder ;
      narr:supports narr:Narrative_HighVelocityDeliveryZephyrUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Velocity was 23 points, explicitly stated as highest this quarter — a concrete, attributed metric." .

    narr:Claim_ZephyrIntegrationKeyUnlock a narr:Claim ;
      narr:aboutNode narr:Narrative_HighVelocityDeliveryZephyrUnlock ;
      narr:hasConvictionLevel narr:Conviction_Stake ;
      narr:supports narr:Narrative_HighVelocityDeliveryZephyrUnlock ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya attributes the velocity achievement to the Zephyr integration as the key unlock — a causal claim with moderate conviction given single-source attribution." .

    # ── Observation ─────────────────────────────────────────────
    narr:Observation_AsyncDecisionWidgetShipped a narr:Observation ;
      skos:broader narr:CaseResults ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Tanya confirms the async decision widget was shipped this sprint." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start "63"^^xsd:integer ;
        oa:end "107"^^xsd:integer
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "We shipped the async decision widget." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix " Velocity was 23"
      ] .

    # ── Style Observations ───────────────────────────────────────
    narr:StyleObs_FirstPersonDirectAttribution a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "First-person plural voice ('We shipped') used for direct team attribution, creating ownership and accountability tone." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "63"^^xsd:integer ;
          oa:end "100"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "We shipped the async decision widget." ;
          oa:prefix "Tanya: \"" ;
          oa:suffix " Velocity was"
        ]
      ] .

    narr:StyleObs_DeclarativeSentenceStructure a narr:StyleObservation ;
      skos:broader narr:SentenceMood ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "Three consecutive short declarative sentences deliver facts in rapid succession — a punchy, results-oriented cadence typical of sprint retro reporting." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "63"^^xsd:integer ;
          oa:end "185"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "We shipped the async decision widget. " ;
          oa:suffix ""
        ]
      ] .

    narr:StyleObs_TechJargonDensity a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_TanyaSprintRetro ;
      skos:note "High jargon density for a short passage: 'async', 'widget', 'velocity', 'integration', 'unlock' — domain-specific sprint/engineering vocabulary throughout." ;
      rdf:value "true"^^xsd:boolean ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_TanyaSprintRetro ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start "63"^^xsd:integer ;
          oa:end "185"^^xsd:integer
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "async decision widget. Velocity was 23 points, highest this quarter. The Zephyr integration was the key unlock." ;
          oa:prefix "We shipped the " ;
          oa:suffix ""
        ]
      ] .

    # ── Style Metrics ────────────────────────────────────────────
    narr:StyleMetrics_TanyaSprintRetro a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_TanyaSprintRetro ;
      narr:AverageSentenceLength "9"^^xsd:integer ;
      narr:ActiveVoiceRatio "1.0"^^xsd:decimal ;
      narr:JargonDensity "0.45"^^xsd:decimal ;
