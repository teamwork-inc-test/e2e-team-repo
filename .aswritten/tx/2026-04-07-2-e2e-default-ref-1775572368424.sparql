      narr:JargonDensity "0.2"^^xsd:decimal ;
      skos:note "Single-sentence body. Active voice throughout. Technical jargon: 'ref', 'topic branch'." .

    narr:StyleObs_TanyaQuote_v10 a narr:StyleObservation ;
