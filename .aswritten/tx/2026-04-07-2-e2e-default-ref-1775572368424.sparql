          oa:prefix "Tanya: \"" ;
          oa:suffix "\"" 
        ]
      ] .

    narr:StyleObs_Naming_v10 a narr:StyleObservation ;
      skos:broader narr:NamingConventions ;
      dct:source narr:Sample_DefaultRefTest_v10 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v10 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 88 ; oa:end 106 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; 
          oa:exact "topic branch" ;
          oa:prefix "creates a " ;
          oa:suffix "." 
        ]
      ] .

    narr:StyleObs_Tone_v10 a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v10 ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v10 ;
        oa:hasSelector [ a oa:TextPositionSelector ; oa:start 47 ; oa:end 52 ] ;
        oa:hasSelector [ a oa:TextQuoteSelector ; 
