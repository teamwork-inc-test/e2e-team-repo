# Extracted entities (named graph)
INSERT DATA {
  GRAPH narr:Tx_20250715T120000Z {

    # ── Sample ──────────────────────────────────────────────────────
    narr:Sample_DefaultRefTest_v9 a narr:Sample ;
      dct:title "Default Ref Test" ;
      dct:description "Repeat extraction (v9) of the minimal Default Ref Test document. One reviewer entry (PII redacted). One attributed quote from Tanya asserting that omitting a ref creates a topic branch." ;
      narr:inputLength 113 .

    # ── Observation ─────────────────────────────────────────────────
    narr:Obs_DefaultRefTest_v9_TanyaQuote a narr:Observation ;
      skos:broader narr:Process ;
      dct:source narr:Sample_DefaultRefTest_v9 ;
      skos:note "Tanya's direct assertion that omitting a ref causes the system to create a topic branch." ;
      oa:hasSelector [
        a oa:TextPositionSelector ;
        oa:start 60 ;
        oa:end 113
      ] ;
      oa:hasSelector [
        a oa:TextQuoteSelector ;
        oa:exact "Testing that omitted ref creates a topic branch." ;
        oa:prefix "Tanya: \"" ;
        oa:suffix "\""
      ] .

    # ── Style Observations ──────────────────────────────────────────

    # SO1: Direct personal tone — Tanya speaks in first-person imperative register
    narr:StyleObs_DefaultRefTest_v9_ToneDirectPersonal a narr:StyleObservation ;
      skos:broader narr:ToneDirectPersonal ;
      dct:source narr:Sample_DefaultRefTest_v9 ;
      skos:note "Single attributed quote in direct-personal register: speaker name + colon + quoted assertion. No hedging language." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v9 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: \"Testing that omitted ref creates a topic branch.\"" ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix ""
        ]
      ] .

    # SO2: Speaker idiolect — attribution pattern "Name: \"quote\"" signals idiolect capture
    narr:StyleObs_DefaultRefTest_v9_SpeakerIdiolect a narr:StyleObservation ;
      skos:broader narr:SpeakerIdiolects ;
      dct:source narr:Sample_DefaultRefTest_v9 ;
      skos:note "Attribution format 'Name: \"quote\"' is the document's idiolect convention for capturing speaker assertions." ;
      rdf:value true ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v9 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 52 ;
          oa:end 60
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "Tanya: " ;
          oa:prefix "# Default Ref Test\n\n" ;
          oa:suffix "\"Testing"
        ]
      ] .

    # SO3: Jargon policy — technical terms 'ref' and 'topic branch' used without definition
    narr:StyleObs_DefaultRefTest_v9_JargonPolicy a narr:StyleObservation ;
      skos:broader narr:JargonPolicy ;
      dct:source narr:Sample_DefaultRefTest_v9 ;
      skos:note "Terms 'ref' and 'topic branch' are git-domain jargon used without definition, assuming reader familiarity. Consistent with prior extractions of this document." ;
      rdf:value false ;
      oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource narr:Sample_DefaultRefTest_v9 ;
        oa:hasSelector [
          a oa:TextPositionSelector ;
          oa:start 76 ;
          oa:end 113
        ] ;
        oa:hasSelector [
          a oa:TextQuoteSelector ;
          oa:exact "omitted ref creates a topic branch." ;
          oa:prefix "Testing that " ;
          oa:suffix "\""
        ]
      ] .

    # ── Style Metrics ───────────────────────────────────────────────
    narr:StyleMetrics_DefaultRefTest_v9 a narr:StyleMetrics ;
      skos:broader narr:StyleMetrics ;
      dct:source narr:Sample_DefaultRefTest_v9 ;
