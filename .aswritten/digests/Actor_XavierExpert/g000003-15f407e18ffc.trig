    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_6> ;
    narr:keyPhrase [ narr:text "during cutover, every reporting read comes off the replica" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "we take ownership on the day Clyde goes green and not a day earlier" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "the zone map drifts between them" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_38> ] ;
    narr:keyPhrase [ narr:text "It's one site, one season." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:keyPhrase [ narr:text "One week is defensible but it has no slack in it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ] ;
    narr:variation [ narr:text "He endorses the shortened cutover window yet insists on record that it is tight, not safe — agreement carrying a priced reservation." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:variation [ narr:text "His own pairing argument rests on evidence he himself flags as one site, one season." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:variation [ narr:text "Both firm rules assume one cutover window at a time; going parallel would force rewriting them." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "flat claim-stating — positions put as fact, hedges named and then dismissed" ; narr:text "Not \"should\", not \"where possible\" — reporting does not touch the live system during a cutover window, full stop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert authority exercised by inviting scrutiny rather than pulling rank" ; narr:text "Can I push on it for a second? Not because I disagree — because the steering group will push and I'd rather they push here." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_10> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — arguments anchored in specific past incidents, then projected forward as rules" ; narr:text "Reporting on top of that is what took Dockside down for forty minutes." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation-pricing — trades stated as explicit costs against losses" ; narr:text "My argument is that a four-minute-stale number is fine and an outage is not." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "market-pricing framing — costs and slack quantified even when agreeing" ; narr:text "Two weeks was conservative in a place where being conservative was cheap." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical baseline shifting to formal for-the-record moments" ; narr:text "For the record, that's the strongest argument anyone's made for it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_15> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what a thing is by naming what it isn't" ; narr:text "I just want it on the record that the new number is tight, not safe." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
