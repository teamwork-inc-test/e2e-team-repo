    narr:keyPhrase [ narr:text "reporting does not touch the live system during a cutover window, full stop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "we take ownership on the day Clyde goes green and not a day earlier." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "Keeping one source of truth through the whole programme is worth more than getting ownership early." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_38> ] ;
    narr:keyPhrase [ narr:text "It's one site, one season." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:keyPhrase [ narr:text "the steering group will push and I'd rather they push here." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_10> ] ;
    narr:keyPhrase [ narr:text "Reporting on top of that is what took Dockside down for forty minutes." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ] ;
    narr:variation [ narr:text "The reporting-boundary claim, stated as an absolute rule, rests on evidence Xavier himself flags as thin — one site, one season." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:variation [ narr:text "Before landing the desk-coupling argument, Xavier frames it as something to be pressure-tested rather than settled — a provisional posture against his later declarative claims." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_10> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ] ;
    narr:variation [ narr:text "Two independent policy threads run in parallel — cutover reporting boundary vs vendor reference-data ownership timing — argued via different logics, outage precedent versus drift risk." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
