    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "grounds arguments concretely, pulling a past incident forward to justify a future rule" ; narr:text "Reporting on top of that is what took Dockside down for forty minutes." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ] ;
