    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_6> ;
    narr:keyPhrase [ narr:text "the telephone company always wins" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_105> ] ;
    narr:keyPhrase [ narr:text "Emery Park is the howitzer" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_185> ] ;
    narr:keyPhrase [ narr:text "But 20% of their quotes are responsible for 50% of their margin loss." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_47> ] ;
    narr:keyPhrase [ narr:text "I'm charging framewell probably about 15 grand a month." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_135> ] ;
    narr:keyPhrase [ narr:text "I think you should definitely apply to yc." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_143> ] ;
    narr:keyPhrase [ narr:text "it is not about individual VCs. It is about maximal VCs." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_191> ] ;
    narr:keyPhrase [ narr:text "I am working on a sovereign AI, like Department of Education pilot in Iceland." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_59> ] ;
    narr:variation [ narr:text "He explicitly hedges his own strategic theses as unproven, sitting against the confident 'operating thesis' framing used elsewhere." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_155> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_109> ] ;
    narr:variation [ narr:text "He calls his own consulting business explicitly not venture-backable and says he doesn't care, yet coaches his interlocutor toward YC and a formal raise." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_139> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_143> ] ;
    narr:variation [ narr:text "Some framing is relayed, not owned — Tina's decision to restart and fundraise, the feed-mill owner's staffing call, both voiced as someone else's move." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_27> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_37> ] ;
    narr:variation [ narr:text "A sharper, angrier register breaks through when he describes his own tooling failing silently, unlike the confident register used to narrate theses." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_69> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_71> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "states operating theses as near-axiomatic principle, not hedged opinion" ; narr:text "One of my operating theses is the telephone company always wins." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_105> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual and expletive-laced even when narrating technical chaos" ; narr:text "Shit show. Because this thing is a fucking disaster." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_37> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis used to draw a hard line between the weak pitch and the confident one" ; narr:text "Hi, I am raising money. It is happening, right?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_199> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "speaks pipeline work in present-tense concrete framing even when the outcome is speculative" ; narr:text "I am working on a sovereign AI, like Department of Education pilot in Iceland." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_59> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "coaches by flat directive rather than suggestion" ; narr:text "I think you should definitely apply to yc." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_143> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "frames value as mutual market exchange between equals, not dependency" ; narr:text "we're both paying for as written, we're both different companies, different people, like different clients, it is more valuable for both of us. We win." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_125> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "prizes optionality over any single path" ; narr:text "YC is high value, low cost." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_145> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "warm and personal when the subject turns to family, breaking from the thesis-narration register" ; narr:text "She is delightful and a dream up until about five days ago when she decided that she's not keen on sleeping at night." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_7> ] ;
    narr:writer "subscription.anthropic/claude-sonnet-5" .
