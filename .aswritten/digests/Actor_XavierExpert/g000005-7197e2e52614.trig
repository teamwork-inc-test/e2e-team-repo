    narr:keyPhrase [ narr:text "during cutover, every reporting read comes off the replica. Not \"should\", not \"where possible\" — reporting does not touch the live system during a cutover window, full stop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "The vendor stays the system of record for reference data until the last site is live." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "Two weeks was conservative in a place where being conservative was cheap. One week is defensible but it has no slack in it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ] ;
    narr:keyPhrase [ narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:keyPhrase [ narr:text "We do not keep the legacy platform alive as a read-only system." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:keyPhrase [ narr:text "Give me until the end of next week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_28> ] ;
    narr:variation [ narr:text "He endorses the shortened cutover window while insisting its tightness be on the record — agreement carrying a priced objection, not plain assent." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:variation [ narr:text "He repeatedly undercuts his own evidence base — the exception curve is one site, one season — even while holding the position it supports." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_17> ] ;
    narr:variation [ narr:text "His rules rest on an unstated assumption — one cutover window at a time — that would force rewrites if the programme ever went parallel." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:variation [ narr:text "He concedes others' arguments outrank his own — a hard constraint over his drift argument, behaviour over his decay argument." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_15> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claim-forward — he states positions as positions, then prices them; principles and decisions surface only at commitment points" ; narr:text "So the position I want us to take is: during cutover, every reporting read comes off the replica." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — he argues from specific past incidents and named future moments, abstracting only to name the pattern" ; narr:text "Reporting on top of that is what took Dockside down for forty minutes." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation first, competence close behind — he protects against loss and prizes things that work without him" ; narr:text "Meaning you can read it in ten years with nothing but the files." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_11> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert persuasion, consultation when it costs nothing — he argues from evidence and invites challenge before others force it" ; narr:text "Can I push on it for a second? Not because I disagree — because the steering group will push and I'd rather they push here." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_10> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "market-pricing — he weighs positions as trades, costs against risks" ; narr:text "Cost and effort now, against a risk that lands years from now on someone who isn't in this room." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_15> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical baseline that drops to plain-spoken when he lands the point" ; narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-led — the sentence names what it isn't before what it is, with parallelism and rule-of-three carrying the close" ; narr:text "Not a database dump that needs the vendor's version of their engine to restore. Not a proprietary export format." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_11> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
