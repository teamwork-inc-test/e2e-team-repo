    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_9> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_91> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_93> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_95> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_97> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_99> ;
    narr:keyPhrase [ narr:text "One of my operating theses is the telephone company always wins." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_105> ] ;
    narr:keyPhrase [ narr:text "The marginal cost of software development is asymptotically approaching zero." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_105> ] ;
    narr:keyPhrase [ narr:text "20% of their quotes are responsible for 50% of their margin loss." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_47> ] ;
    narr:keyPhrase [ narr:text "I think you should definitely apply to yc." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_143> ] ;
    narr:keyPhrase [ narr:text "You are creating a marketplace for as written." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_191> ] ;
    narr:keyPhrase [ narr:text "If Slack was just internal, Slack would not be durable." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_119> ] ;
    narr:keyPhrase [ narr:text "And the transcript is the truth, because it exists." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_79> ] ;
    narr:variation [ narr:text "His own two theses pull against each other: the network-effect moat is framed as big VC strategy, yet he shrugs that his micro-SaaS work is not venture backable and doesn't care." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_131> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_139> ] ;
    narr:variation [ narr:text "He hedges his own operating theses — explicitly not certain, still trying to beat them up — so the confident register coexists with held-open conviction." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_155> ] ;
    narr:variation [ narr:text "He concedes the counterargument rather than dismissing it: he agrees the in-company data compounding is real and only argues someone could still build a better version." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_111> ] ;
    narr:variation [ narr:text "The authority-ranking relational signal is relayed — Tina's fundraise push and the fired ERP champion's authority — witnessed through others' stances, not his own." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_27> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_37> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "thesis-bearing but self-qualified — he names operating theses as claims and principles, then explicitly refuses certainty about them" ; narr:text "One of my operating theses is the telephone company always wins." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_105> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "metaphor-first — he argues through concrete images (telephone company, howitzer, cockroach) rather than abstractions" ; narr:text "Emery Park is the howitzer. You show up like." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_185> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert advisory — directs with recommendations and tool pointers, and opens space with consultation offers" ; narr:text "You should look at dolt instead of git, dolt, D O L T dolt and then also beads." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_85> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "swings between abstract present-tense principle and concrete future irrealis planning" ; narr:text "I think you should definitely apply to yc." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_143> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "optionality-preserving autonomy — he optimizes consulting work to keep doors open" ; narr:text "how do I find consulting work that retains optionality" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_145> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "market-pricing lens — he reasons about value in terms of who pays, who sits in between, and cross-company network effects" ; narr:text "If Slack was just internal, Slack would not be durable." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_119> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "activated-negative flashes — irritation and frustration surface plainly alongside warmth" ; narr:text "I hate slack for all sorts of reasons." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_67> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical baseline with casual, playful bursts when he's making a point land" ; narr:text "AI is moving to the edges, so we should do AI on the edge rather than on the center." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_77> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
