    narr:keyPhrase [ narr:text "during cutover, every reporting read comes off the replica" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "The vendor stays the system of record for reference data until the last site is live." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "It's one site, one season." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:keyPhrase [ narr:text "One week is defensible but it has no slack in it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ] ;
    narr:keyPhrase [ narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:keyPhrase [ narr:text "We extract the closed history into a flat, self-describing archive" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:keyPhrase [ narr:text "both assume one cutover window open at a time" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:variation [ narr:text "He agrees with the shortened window while insisting on the record that it is tight, not safe — endorsement carrying a priced caveat, repeated verbatim across three review threads." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_5> ] ;
    narr:variation [ narr:text "His own rules rest on an assumption he admits he hadn't stated — one cutover window at a time — and would need rewriting if the programme ever went parallel." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_9> ] ;
    narr:variation [ narr:text "He repeatedly undercuts his own evidence base: the exception curve is one site, one season, the only support for positions he still argues." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_17> ] ;
    narr:variation [ narr:text "In the archive thread he concedes a colleague's argument is better than his own — decay versus behaviour — rather than defending his framing." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claim-forward — positions stated as takes to be argued, not hedged guesses" ; narr:text "So the position I want us to take is: during cutover, every reporting read comes off the replica." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert persuasion — argues by naming the failure mode, then draws the rule" ; narr:text "That's the expensive answer and it's also the fragile one." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — grounds rules in specific past incidents and named future moments" ; narr:text "Reporting on top of that is what took Dockside down for forty minutes." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation-first — one source of truth and kept meaning outrank early wins" ; narr:text "Keeping one source of truth through the whole programme is worth more than getting ownership early." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_38> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical baseline that drops into plain-spoken aphorism at the load-bearing line" ; narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what a thing is by naming what it isn't" ; narr:text "Two weeks was conservative in a place where being conservative was cheap." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "market-pricing — costs and risks weighed against each other across time" ; narr:text "Cost and effort now, against a risk that lands years from now on someone who isn't in this room." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_15> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
