    narr:keyPhrase [ narr:text "during cutover, every reporting read comes off the replica" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "we take ownership on the day Clyde goes green and not a day earlier" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "The replica rule and the reference-data rule both assume one cutover window open at a time" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:keyPhrase [ narr:text "the new number is tight, not safe" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:keyPhrase [ narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:keyPhrase [ narr:text "The archive outlives the platform." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:variation [ narr:text "He endorses the shortened cutover window while insisting on the record that it costs something — defensible but with no slack" ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:variation [ narr:text "He concedes his own evidence is thin — one site, one season — even while holding the position it supports" ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:variation [ narr:text "He repeatedly ranks others' arguments above his own, ceding that theirs is the stronger case" ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_15> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:variation [ narr:text "He names an unstated assumption under both of his standing rules and admits both would need rewriting if cutover ever went parallel" ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claim-first with a principle underneath — he states positions flatly, and only the archive question rises to a stated principle" ; narr:text "Then here's the view I'd take, and I'd take it firmly." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert persuasion — he argues from mechanism and precedent, and pre-empts challenge by inviting it" ; narr:text "Can I push on it for a second? Not because I disagree — because the steering group will push and I'd rather they push here." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_10> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical baseline that drops into plain-spoken when he's landing the point" ; narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated when grounding, abstract-future when arguing — he prices present cost against distant risk" ; narr:text "Cost and effort now, against a risk that lands years from now on someone who isn't in this room." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_15> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation-led — he consistently argues that avoiding irreversible loss beats early gain" ; narr:text "Keeping one source of truth through the whole programme is worth more than getting ownership early." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_38> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "market-pricing default — he frames trade-offs as costs and prices, softening to communal only when committing" ; narr:text "That's the expensive answer and it's also the fragile one." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't, then pairs the poles" ; narr:text "Mine is about decay. Yours is about behaviour." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
