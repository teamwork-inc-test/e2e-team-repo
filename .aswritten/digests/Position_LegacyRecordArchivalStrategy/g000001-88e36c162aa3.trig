GRAPH <https://aswritten.ai/narrative#Digest_Position_LegacyRecordArchivalStrategy> {
  <https://aswritten.ai/narrative#Digest_Position_LegacyRecordArchivalStrategy> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_LegacyRecordArchivalStrategy> ;
    narr:childCount "9"^^xsd:integer ;
    narr:generatedFrom "88e36c162aa3ba30a94074c3b2f7b68fbe13aefc" ;
    narr:narration """This position holds that closed legacy-platform history should be extracted into an open, self-describing archive rather than kept alive as a read-only system. [The problem statement](narr:Expr_5HalyardLegacyArchive20260922_3) frames the gap: open work migrates, eleven years of closed history does not. [The core stance](narr:Expr_5HalyardLegacyArchive20260922_9) rejects keeping the legacy platform alive, arguing a dormant system fails quietly until someone needs an old record for a claim — [the fragility argument](narr:Expr_5HalyardLegacyArchive20260922_7) makes that cost explicit. [The archival prescription](narr:Expr_5HalyardLegacyArchive20260922_11) specifies flat files, open formats, a schema, and field-meaning documentation readable in a decade without the vendor. [The decay thesis](narr:Expr_5HalyardLegacyArchive20260922_13) holds that data is easy to keep but meaning rots. [The counterargument acknowledgment](narr:Expr_5HalyardLegacyArchive20260922_15) names why this never gets done: cost now, risk later on someone absent. [A behavioural addition](narr:Expr_5HalyardLegacyArchive20260922_16) argues an obviously-dead archive prevents a second system of record, which [the expert concedes](narr:Expr_5HalyardLegacyArchive20260922_17) is the stronger argument. [The formalized position](narr:Expr_5HalyardLegacyArchive20260922_22) states switch-off at last-site go-live, extraction first, and written legal retention terms before signing decommissioning papers.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_11> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_15> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_22> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ;
    narr:keyPhrase [ narr:text "We do not migrate the closed history — eleven years of it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_3> ] ;
    narr:keyPhrase [ narr:text "The archive outlives the platform." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:keyPhrase [ narr:text "A system nobody uses and nobody patches is a system that stops working quietly" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ] ;
    narr:keyPhrase [ narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:keyPhrase [ narr:text "An archive that is obviously an archive kills that." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ] ;
    narr:keyPhrase [ narr:text "the retention period comes from legal in writing before we sign anything with the vendor about decommissioning" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_22> ] ;
    narr:variation [ narr:text "The counterargument is named within the position itself: cost and effort now against a risk landing years away on someone not in the room — the reason archival work 'never gets done'." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_15> ] ;
    narr:variation [ narr:text "Two competing rationales for the same stance — decay of meaning versus behavioural risk of a shadow second system of record — with the expert conceding the behavioural one is stronger." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:variation [ narr:text "The read-only legacy platform alternative was explicitly considered and rejected as expensive and fragile, not absent from the debate." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}