    narr:keyPhrase [ narr:text "the team pricing is about $400 a month" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_100> ] ;
    narr:keyPhrase [ narr:text "enterprise pricing starts at four grand" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_100> ] ;
    narr:keyPhrase [ narr:text "I'm raising 500k at this point to do a bridge round" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_102> ] ;
    narr:keyPhrase [ narr:text "the graph itself is the moat" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_110> ] ;
    narr:keyPhrase [ narr:text "they've been paying me $800 a month" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_214> ] ;
    narr:keyPhrase [ narr:text "I don't know, I'm feeling a little unsure of what I'm doing right at this point." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_140> ] ;
    narr:variation [ narr:text "Confident architecture and moat claims sit against a mid-call admission that the product's own user story feels unclear." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_110> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_84> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_92> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_140> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_152> ] ;
    narr:variation [ narr:text "The personal catch-up with an old contact gives way to a direct fundraising and customer-intro ask." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_2> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_24> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_102> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_170> ] ;
    narr:variation [ narr:text "Pricing appears on two different footings: her own consultative framing of tiers versus a relayed account of an existing client's payment terms." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_100> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_214> ] ;
    narr:variation [ narr:text "The closing advice to stop building and just sell cuts against her stated instinct to stay head-down in development." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_246> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_140> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "Claims land flat and declarative when she's stating the product thesis, not hedged into notions." ; narr:text "the real value here is not can I ask questions against my calls, right?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_110> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "Reaches for metaphor to land an emotional read rather than just decorate." ; narr:text "you're sorry because you feel responsibility for not pulling the magic bunny out of the hat in time." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_20> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "Frames stability as staying close to known people rather than straying too far." ; narr:text "If my blinders are up enough and I stay focused on the, like, wonderful people right around me, things are great, you know, you just can't stray too far." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_12> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "Calm-negative candor breaks through the pitch confidence when she names her own uncertainty." ; narr:text "I would have given you a very confident, different description of this moment coming into the call. And now I don't know, now I'm feeling less sure." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_140> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "Commercial specifics about an existing client arrive as relayed status, not her own asserted market position." ; narr:text "there's currently an MSA out for like, you know, six grand a month" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_214> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "Fundraising plans are pitched in concrete future/irrealis terms — sized, contingent, staged." ; narr:text "I'm raising 500k at this point to do a bridge round to get me to enough enterprise traction that I can do a true, you know, million seed." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_102> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "Opens pricing talk in a consultative register, checking rather than asserting." ; narr:text "First of all, I'm curious if that sounds appropriate to you." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_100> ] ;
    narr:writer "subscription.anthropic/claude-sonnet-5" .
