    narr:keyPhrase [ narr:text "We do this one site at a time." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "the soak between sites is one week, not two" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_8> ] ;
    narr:keyPhrase [ narr:text "I want legal to give us one in writing" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:keyPhrase [ narr:text "I'll take that to the board as the open item rather than wait for them to find it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_28> ] ;
    narr:keyPhrase [ narr:text "vendor holds reference data until Clyde is green" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
    narr:variation [ narr:text "The soak she rehearsed as two weeks is formally superseded to one week, stated on the record twice" ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_8> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
    narr:variation [ narr:text "She repeatedly adopts others' sharper versions of her own arguments rather than defending her own framing" ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_17> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_12> ] ;
    narr:variation [ narr:text "She concedes an outside critique nobody internal had raised and chooses to surface the gap to the board herself" ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_20> ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_28> ] ;
    narr:variation [ narr:text "The retention number is deliberately left undecided pending a written legal figure, against her pattern of settling rules in-meeting" ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-first — she announces where she's landed and dares the room to move her" ; narr:text "I don't think I'm going to move off it" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority with consultation runs — she orders rules into writing but asks before deciding" ; narr:text "write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence prices two options against each other in balanced clauses" ; narr:text "a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking as the default, but she credits upward-challenging explicitly" ; narr:text "Thank you for bringing it rather than letting it ride." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_23> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-future irrealis — she argues by painting the downstream consequence that hasn't happened yet" ; narr:text "then we've got two systems of record for a year" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual in flow, but shifts to formal for on-the-record rulings" ; narr:text "the soak between sites is one week, not two" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_8> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive in receipt of good argument — warmth expressed as plain thanks, not enthusiasm" ; narr:text "Thanks, Freya. Genuinely useful." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_31> ] ;
