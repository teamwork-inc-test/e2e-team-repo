    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_7> ;
    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one. No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "Reporting reads come off the replica during cutover. Xavier, write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "Their data, their problem, right up until the end." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_39> ] ;
    narr:keyPhrase [ narr:text "That's a much more concrete version of what I was arguing last week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ] ;
    narr:keyPhrase [ narr:text "Noted, and I'll lead with yours on Thursday." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_17> ] ;
    narr:variation [ narr:text "The chair who pre-commits ('I don't think I'm going to move off it') is the same one who, a week later, adopts a colleague's version of her own argument and leads with it — consultation can still move her." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_17> ] ;
    narr:variation [ narr:text "She probes whether the sequencing would survive easier staffing — the rule is held on principle, not just under pressure, but the question is left open in the record." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_21> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-grade — she states outcomes as settled, not opinions" ; narr:text "Then that's the rule." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority run alongside genuine consultation — she asks, then rules" ; narr:text "Hold those for ten minutes. Sequencing first. Tina, you've been living in the site plan — where are we?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_4> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking with colleagues, but equality-matching when soliciting expertise" ; narr:text "Freya, what do you need from me?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_27> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence sets two things against each other" ; narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-future and irrealis when ruling; past-realis when recounting what's settled" ; narr:text "So Thursday I'm telling them: one site at a time, two-week soak between sites, reporting off the replica during cutover, vendor holds reference data until Clyde is green. Anything I've mangled?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "activated-negative under deadline pressure, calm-positive once the work lands" ; narr:text "I want to come out of it with the cutover shape actually decided, because the steering group asks again on Thursday and I've given them \"we're still working it\" twice now." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual and plain-spoken even while exercising authority" ; narr:text "Please." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_11> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}