    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_86> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_88> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_90> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_92> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_94> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_96> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_98> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_11> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_14> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_18> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_21> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_29> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_7> ;
    narr:keyPhrase [ narr:text "the graph itself is the moat, right? And like, yes, I'm letting someone store the data in their repo, but the read and manipulation layer is proprietary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_110> ] ;
    narr:keyPhrase [ narr:text "I'm raising 500k at this point to do a bridge round to get me to enough enterprise traction that I can do a true, you know, million seed." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_102> ] ;
    narr:keyPhrase [ narr:text "The transcript is the truth. But then from there the perspective becomes a way to interrogate the truth and it changes over time." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_80> ] ;
    narr:keyPhrase [ narr:text "the graph witnesses what was said and its role is to encode what was said and relate that to all of these statements." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_92> ] ;
    narr:keyPhrase [ narr:text "It's not that enterprise isn't a good target. It's that the quote, enterprise plan isn't about enterprise. It's about the shape of the deployment and the needs of the organization." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_21> ] ;
    narr:keyPhrase [ narr:text "it's actually more of a B2C product than a B2B product." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_5> ] ;
    narr:keyPhrase [ narr:text "I feel like my pitch has gone back about six months in terms of clarity and whatever else." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_152> ] ;
    narr:variation [ narr:text "Confident moat thesis vs. mid-call admission of being lost and unsure what the front-end user story is — the pitch confidence and the doubt coexist in the same call." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_110> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_140> ] ;
    narr:variation [ narr:text "The B2C-first reframing in the second call cuts against the enterprise-pilot-driven positioning of the first call, while she still defends enterprise as a target." ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_5> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_21> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_100> ] ;
    narr:variation [ narr:text "Marketplace-of-expertise and AI-as-deck ideas are speculative notions, not the load-bearing graph thesis — a divergent future direction, not yet committed." ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_24> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_26> ] ;
    narr:variation [ narr:text "She concedes competitors like Fireflies or Otter could ostensibly build conversational knowledge graphs, qualifying the moat claim." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_116> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "oscillates between firm claim-making on the product thesis and hedged 'notion' register when the topic turns to her own moment — claims about the graph, notions about herself" ; narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_18> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-present realis as the baseline, flipping to irrealis-future when fundraising or new ideas enter" ; narr:text "I could build out the marketplace by basically creating a podcast where I interview people about their business and perspective, and each of those things gets packaged into an installable expertise and they're just available." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_24> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "metaphor-first with antithesis and parallelism — she frames by naming what a thing is not, then pairs the halves" ; narr:text "It's not that enterprise isn't a good target. It's that the quote, enterprise plan isn't about enterprise. It's about the shape of the deployment and the needs of the organization." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_21> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical when explaining the system, dropping to casual-irreverent when diagnosing the market" ; narr:text "The problem with most developers and entrepreneurs is they've already rolled their own bullshit." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_7> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "swings from activated-positive excitement about AI possibility to calm-negative and activated-negative when the subject is her own uncertainty or the market's resistance" ; narr:text "I don't know, I'm feeling a little unsure of what I'm doing right at this point." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_140> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and conservation — she values things working, being written down, and not losing what exists" ; narr:text "And this meeting is actually the source of truth for how things are done at the company, right? And yet nobody writes it down" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_78> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "market-pricing fluency — she talks money in exact numbers, though the client-payment figures were relayed rather than owned in the graph's own accounting" ; narr:text "They have been paying me. They've been paying me, like. Yeah, they've been paying me $800 a month. And there's currently an MSA out for like, you know, six grand a month. That's in legal review." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_214> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "consultative — she checks her framing against the listener rather than asserting it" ; narr:text "First of all, I'm curious if that sounds appropriate to you." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_100> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}