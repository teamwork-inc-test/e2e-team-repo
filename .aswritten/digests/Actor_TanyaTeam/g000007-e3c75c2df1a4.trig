    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_6> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_8> ;
    narr:keyPhrase [ narr:text "We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one. No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "Then that's the rule. Reporting reads come off the replica during cutover. Xavier, write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "Right. For the record then: the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:keyPhrase [ narr:text "Legal says seven years from the record date for the consignment data. I want to go beyond that for the claims-relevant subset, and I don't want to decide that number today — I want legal to give us one in writing." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:keyPhrase [ narr:text "I'll take that to the board as the open item rather than wait for them to find it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_28> ] ;
    narr:keyPhrase [ narr:text "No, that's fair. Nobody has said that to me yet." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_20> ] ;
    narr:variation [ narr:text "She formally supersedes her own earlier two-week soak ruling, replacing it with one week — her own prior decision is the thing revised." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_20> ] ;
    narr:variation [ narr:text "An outside advisor's critique lands where nobody internal had pushed — she concedes it and commits to surfacing the gap to the board herself." ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_20> ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_28> ] ;
    narr:variation [ narr:text "She adopts a subordinate's sharper version of her own argument and leads with it, rather than defending her original framing." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_17> ] ;
    narr:variation [ narr:text "She admits the archive question is one she'd have got wrong — signing decommissioning terms before discovering the extraction requirement — absent legal's prompt." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_25> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-first — she states where she has landed before the discussion, then holds it unless formally revised" ; narr:text "Then let me say where I've landed, because I don't think I'm going to move off it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority exercised by converting talk into written rules, with consultation run alongside it" ; narr:text "Then that's the rule. Reporting reads come off the replica during cutover. Xavier, write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking as the default, but she drops to genuine equality when thanking or taking input" ; narr:text "Freya, what do you need from me?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_27> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and future-facing — she frames decisions as what will happen next, often irrealis" ; narr:text "Morning, both. Let's keep this one tight — I want to come out of it with the cutover shape actually decided, because the steering group asks again on Thursday and I've given them \"we're still working it\" twice now." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence sets two things against each other, then mirrors them" ; narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive when receiving input — warmth expressed as appreciation for the act of raising things" ; narr:text "Thank you for bringing it rather than letting it ride." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_23> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual-but-commanding day to day, shifting to formal only when putting something on the record" ; narr:text "Right. For the record then: the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation — recovered slack is banked, not spent" ; narr:text "Which I will not be spending. That goes into the Clyde buffer." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_54> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}