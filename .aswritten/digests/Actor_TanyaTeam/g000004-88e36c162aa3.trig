    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "Then that's the rule. Reporting reads come off the replica during cutover. Xavier, write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:keyPhrase [ narr:text "That's a much more concrete version of what I was arguing last week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ] ;
    narr:keyPhrase [ narr:text "I want to go beyond that for the claims-relevant subset, and I don't want to decide that number today — I want legal to give us one in writing." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:keyPhrase [ narr:text "That's the thing I'd have got wrong if legal hadn't asked on Friday — I'd have signed the decommissioning terms first and discovered the extraction requirement afterwards." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_25> ] ;
    narr:variation [ narr:text "Her own two-week soak figure, ratified on the record, is formally superseded a week later by a one-week figure — the earlier framing is still reachable and now wrong." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_20> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:variation [ narr:text "The strongest argument for her settled sequencing position isn't hers — she adopts and leads with someone else's version of it." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_17> ] ;
    narr:variation [ narr:text "She names a decision she'd have got wrong without external prompting — signing decommissioning terms before the extraction requirement surfaced." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_25> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-first — she announces where she's landed before the room speaks, then holds it" ; narr:text "Then let me say where I've landed, because I don't think I'm going to move off it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority with consultation run alongside — she orders rules into writing but asks before deciding" ; narr:text "Then that's the rule. Reporting reads come off the replica during cutover." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking as the default, but she drops to equality-matching when asking what someone needs" ; narr:text "Freya, what do you need from me?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_27> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence sets what it is against what it isn't" ; narr:text "We migrate the open work. We do not migrate the closed history — eleven years of it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_3> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated in both directions — she reasons from what already happened into what must happen before signing" ; narr:text "I'd have signed the decommissioning terms first and discovered the extraction requirement afterwards." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_25> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive in receipt of good argument — warmth expressed briefly and plainly" ; narr:text "Thanks, Freya. Genuinely useful." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_31> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual baseline with a deliberate shift into formal for on-the-record ratifications" ; narr:text "Right. For the record then: the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "relatedness surfaces in how she rewards dissent being voiced rather than suppressed" ; narr:text "Thank you for bringing it rather than letting it ride." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_23> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
