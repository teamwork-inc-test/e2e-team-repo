    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_8> ;
    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:keyPhrase [ narr:text "An archive that is obviously an archive kills that." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ] ;
    narr:keyPhrase [ narr:text "I want legal to give us one in writing." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:keyPhrase [ narr:text "I'll take that to the board as the open item rather than wait for them to find it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_28> ] ;
    narr:keyPhrase [ narr:text "No, that's fair. Nobody has said that to me yet." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_20> ] ;
    narr:variation [ narr:text "She adopts others' better arguments rather than defending her own — twice crediting a sharper version of her position and once admitting she'd have got the sequencing wrong alone." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_12> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_25> ] ;
    narr:variation [ narr:text "The advisor conversation is a register departure: she solicits critique from outside the programme and concedes a point nobody had raised, rather than ruling from the chair." ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_1> ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_20> ] ;
    narr:variation [ narr:text "Her own earlier two-week soak figure is formally superseded on the record — a settled number she'd stated publicly is revised to one week." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_21> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decisions stated as landed positions, then ratified on the record — claims only where she's genuinely uncertain" ; narr:text "Then let me say where I've landed, because I don't think I'm going to move off it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority run alongside consultation — she orders, but asks before deciding" ; narr:text "I want your read on it from the rota side before it hardens." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_3> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking default that drops to equality-matching when she's thanking or recruiting" ; narr:text "Thanks, Freya. Genuinely useful." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_31> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-future irrealis — she narrates what will happen under the decision, not abstractions" ; narr:text "A site goes live, it soaks, and only when the soak is clean do we start the next." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_7> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence names what it isn't, then balances what it is" ; narr:text "We migrate the open work. We do not migrate the closed history — eleven years of it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_3> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive under review, activated-negative only when a deadline presses" ; narr:text "That's a good test." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_22> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "relatedness surfaces in how she receives challenge — gratitude for the raising, not just the content" ; narr:text "Thank you for bringing it rather than letting it ride." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_23> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual-but-commanding baseline with a formal shift when she ratifies on the record" ; narr:text "Right. For the record then: the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
