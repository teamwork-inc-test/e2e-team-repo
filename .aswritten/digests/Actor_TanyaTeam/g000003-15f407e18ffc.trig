    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "Their data, their problem, right up until the end." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_39> ] ;
    narr:keyPhrase [ narr:text "That's a much more concrete version of what I was arguing last week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ] ;
    narr:keyPhrase [ narr:text "Noted, and I'll lead with yours on Thursday." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_17> ] ;
    narr:keyPhrase [ narr:text "the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:variation [ narr:text "Her own two-week soak figure is formally superseded by a one-week figure the same week she'd ratified it — the settled rule she wrote down didn't hold" ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_20> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:variation [ narr:text "The load-bearing argument for the sequencing is no longer hers: she adopts and publicly leads with someone else's sharper version" ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_17> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_12> ] ;
    narr:variation [ narr:text "She probes whether the sequencing would survive eased staffing — an untested counterfactual left open, not closed" ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_21> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-grade and unapologetic — she names her landing spot before the discussion and dares movement" ; narr:text "No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority softened by consultation — she orders outcomes but asks for reads first" ; narr:text "Xavier, write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism as the load-bearing habit — sentences define by what they are and are not" ; narr:text "We are still going one site at a time, and we are still soaking between sites before the next one starts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_10> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking by default, but she drops to equality-matching when asking what someone needs" ; narr:text "Freya, what do you need from me?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_27> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "irrealis future as her planning home — rules stated as what will and won't happen" ; narr:text "A site goes live, it soaks, and only when the soak is clean do we start the next." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_7> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "activated-negative under deadline pressure, warming to calm-positive when the work lands well" ; narr:text "Thanks, Freya. Genuinely useful." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_31> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
