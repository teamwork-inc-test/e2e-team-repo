GRAPH <https://aswritten.ai/narrative#Digest_Position_PostGoLiveSoakDurationBasis> {
  <https://aswritten.ai/narrative#Digest_Position_PostGoLiveSoakDurationBasis> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_PostGoLiveSoakDurationBasis> ;
    narr:childCount "14"^^xsd:integer ;
    narr:generatedFrom "e3c75c2df1a4d6b8ce07850fdf733affe72074b3" ;
    narr:narration """The position's basis was overturned within a week. It opened as a [two-week minimum soak defended on the Dockside exception curve](narr:Expr_1HalyardWeekly20260908_21), with the evidence base flagged as [one site, one season](narr:Expr_1HalyardWeekly20260908_21). At the ops-readiness review, [a demand for dates plus a commitment that a soak doesn't get shortened because a date slipped](narr:Expr_2HalyardOpsReadiness20260915_28) was met with [an agreement to hold it](narr:Expr_2HalyardOpsReadiness20260915_29). At the cutover review the author [retracted the two-week figure outright](narr:Expr_4HalyardCutoverReview20260915_3), having [re-analyzed the logs and found the nine-day flattening was an artifact of a retired weekly reconciliation job](narr:Expr_4HalyardCutoverReview20260915_5) — [nothing in the new platform runs on a weekly cycle](narr:Expr_4HalyardCutoverReview20260915_7). The revised basis is [one week: underlying exception rate flat by day four, plus three days of margin](narr:Expr_4HalyardCutoverReview20260915_9), formally [ratified on the record as superseding the earlier note](narr:Expr_4HalyardCutoverReview20260915_20). The position itself now stands contested — rejected by [Tanya TeamOwner](narr:Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_61), [who reads the one-week figure as as unmeasured as the two weeks was, since nobody has run a soak yet](narr:Expr_4HalyardCutoverReview20260915_9) — so the ratified number is disputed, not settled. The register throughout runs antithesis and formal — [tight, not safe](narr:Expr_4HalyardCutoverReview20260915_15). A later review comment adds an open governance gap: [the one-week soak should name who signs off the second site before it starts](narr:Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30).""" ;
    narr:reaction """The review move is what changed: the position's status is now carried as its formal review state — contested, with the rejection and its reason stated in place — rather than only as a tension inside the graph. The trajectory beneath it (two weeks retracted, one week ratified, the slack trade-off, the sign-off gap) is unchanged and still open.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_61> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_62> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_29> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ;
    narr:keyPhrase [ narr:text "I'll note that the exception curve is the only evidence we have for it. It's one site, one season." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:keyPhrase [ narr:text "That job is gone. It was retired in July. Nothing in the new platform runs on a weekly cycle — reconciliation is continuous now." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_7> ] ;
    narr:keyPhrase [ narr:text "One week. Strip the reconciliation cycles out of the Dockside curve and the underlying exception rate is flat by day four." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:keyPhrase [ narr:text "the one-week figure is as unmeasured as the two weeks was; nobody has run a soak yet" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_62> ] ;
    narr:keyPhrase [ narr:text "the one-week soak should name who signs off the second site before it starts" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ] ;
    narr:variation [ narr:text "The ratified one-week figure is disputed — the owner's rejection holds that no soak has been run yet, so the number is as unmeasured as the one it replaced." ; narr:over <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_61> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_62> ] ;
    narr:variation [ narr:text "The correction costs something: two weeks was conservative where conservatism was cheap, and one week has no slack in it." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:variation [ narr:text "An open governance gap: nobody is named to sign off the second site before its soak starts." ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ] ;
    narr:variation [ narr:text "The original two-week basis survives as superseded-but-quotable — its own author flagged the evidence as one site, one season before it fell." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-forward when moving numbers, claim-forward when explaining them — the retraction and the ratification are both flat declarations" ; narr:text "That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "informational persuasion — corrections are argued from re-analyzed evidence, not pulled by rank" ; narr:text "The reason the queue took nine days to flatten at Dockside is that the old reconciliation job ran weekly and every run threw a fresh batch of exceptions." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — claims are pinned to specific days and past events rather than abstractions" ; narr:text "I quoted the Dockside number — the exception queue not flattening until day nine or ten." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence over caution — defensible-and-known beats conservative-for-an-imaginary-reason" ; narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking in the formal record, equality-matching in negotiation — the register shifts with the room" ; narr:text "Right. For the record then: the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence names what it isn't before what it is" ; narr:text "Agreed. I just want it on the record that the new number is tight, not safe." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:pipelineCondition "review-renarrate:on" ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}