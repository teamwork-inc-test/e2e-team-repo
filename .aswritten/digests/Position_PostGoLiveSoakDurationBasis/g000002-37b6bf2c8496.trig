GRAPH <https://aswritten.ai/narrative#Digest_Position_PostGoLiveSoakDurationBasis> {
  <https://aswritten.ai/narrative#Digest_Position_PostGoLiveSoakDurationBasis> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_PostGoLiveSoakDurationBasis> ;
    narr:childCount "7"^^xsd:integer ;
    narr:generatedFrom "37b6bf2c84965cc245e031aab2e50ce7a0484a10" ;
    narr:narration """The position fixes a [two-week minimum soak between cutovers](narr:Expr_1HalyardWeekly20260908_17), grounded in the [Dockside pilot's exception queue, which didn't flatten until day nine or ten](narr:Expr_1HalyardWeekly20260908_19). [Tanya took it as a decision on the record](narr:Expr_1HalyardWeekly20260908_20), and the basis is defended as [hold two weeks and shorten with evidence rather than the reverse](narr:Expr_1HalyardWeekly20260908_22). [The single-site, single-season evidence base is flagged as a limitation](narr:Expr_1HalyardWeekly20260908_21). A week later the position gained an enforcement side: [Freya demanded dates plus a commitment that a soak doesn't get shortened because a date slipped](narr:Expr_2HalyardOpsReadiness20260915_28), and [Tanya agreed to hold it](narr:Expr_2HalyardOpsReadiness20260915_29).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_19> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_20> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_29> ;
    narr:keyPhrase [ narr:text "The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:keyPhrase [ narr:text "it didn't flatten out until day nine or ten" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_19> ] ;
    narr:keyPhrase [ narr:text "I'd rather hold two weeks and shorten it with evidence than hold one week and discover we needed two." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ] ;
    narr:keyPhrase [ narr:text "It's one site, one season." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:keyPhrase [ narr:text "a commitment that a soak doesn't get shortened because a date slipped" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:keyPhrase [ narr:text "That's fair and I'll hold it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_29> ] ;
    narr:variation [ narr:text "The evidence base is one site, one season — the only empirical support for the two-week number is a single pilot's exception curve." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:variation [ narr:text "The number was set partly to preempt schedule pressure; the risk it guards against resurfaced as Freya's demand that a slipped date can't eat the soak." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "plain claim-assertion, firming into decisions when she's ready to commit" ; narr:text "The soak is two full weeks." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — grounds future rules in specific past observation" ; narr:text "Dockside pilot, back in the spring. We watched the exception queue after go-live and it didn't flatten out until day nine or ten." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_19> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert authority exercised through rational persuasion, naming the mechanism" ; narr:text "\"a soak\" without a number turns into three days the first time someone's under pressure." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — states the rule by setting what she'd do against what she wouldn't" ; narr:text "I'd rather hold two weeks and shorten it with evidence than hold one week and discover we needed two." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}