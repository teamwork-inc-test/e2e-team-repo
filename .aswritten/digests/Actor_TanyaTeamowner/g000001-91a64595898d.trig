    narr:childCount "7"^^xsd:integer ;
    narr:generatedFrom "91a64595898d7daf51efb7ee046e6c9870fbba0f" ;
    narr:narration """Tanya's voice here is a sales-motion articulation, all voiced in her own register. The through-line runs from [the renaming of the product to installable expertise](narr:Expr_1RealFreyaPodcastSalesMotion20260323_24) through [the technical moat of extracting citable perspective from documents](narr:Expr_1RealFreyaPodcastSalesMotion20260323_26) to [the target market: experts packaging their work in static, bounded forms](narr:Expr_1RealFreyaPodcastSalesMotion20260323_28) and [the bottleneck framing of delegated expert work](narr:Expr_1RealFreyaPodcastSalesMotion20260323_30). She holds the product stance as principle — [building the Apple of installable expertise rather than a toolbox](narr:Expr_1RealFreyaPodcastSalesMotion20260323_32) — while the go-to-market side stays exploratory: [seeding initial perspectives from people she knows](narr:Expr_1RealFreyaPodcastSalesMotion20260323_34) and [a podcast-driven marketplace build-out](narr:Expr_1RealFreyaPodcastSalesMotion20260323_7). Her style-lane shows antithesis-first phrasing, analogy, and rhetorical questions; conviction splits between firm principle/claim on the product thesis and irrealis 'notion' on distribution.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "The target market is becoming an expert that currently packages their work in a static and bounded way." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ] ;
    narr:keyPhrase [ narr:text "And the person, the business owner, the consultant, the expert, is currently the bottleneck." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:variation [ narr:text "Product thesis held as firm principle/claim, while both distribution ideas (seeded perspectives, podcast marketplace) remain irrealis 'notions' — conviction is asymmetric across the arc." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ] ;
    narr:variation [ narr:text "The Apple-vs-toolbox analogy explicitly rejects the toolbox framing, an alternative product shape she names only to rule out." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "principle-first on the product thesis — she states stances as settled commitments, dropping to casual 'notion' only when brainstorming distribution" ; narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "inspirational-appeal — she frames the pitch as a vision the listener is invited into" ; narr:text "Because what we need and the big narrative foundation is not intelligence is capability." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical when naming the moat, casual and plain-spoken when narrating the story — she code-switches by topic" ; narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't before what it is, with analogy and rhetorical questions as secondary moves" ; narr:text "And more information does not solve your problem." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "abstract-present-realis for the thesis — she speaks of the product as already true; only distribution ideas slip into concrete-future irrealis" ; narr:text "Could I get all the people I know to contribute their expertise as the first modules?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and autonomy — the pitch centers expertise carried out without the expert as gatekeeper" ; narr:text "It's really about the delegation of work that requires expertise to carry it out." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "communal-sharing appears only in the exploratory mode — recruiting her own network as first contributors" ; narr:text "Could I get all the people I know to contribute their expertise as the first modules?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}