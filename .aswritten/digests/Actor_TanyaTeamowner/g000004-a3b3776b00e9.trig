    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_11> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_15> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:keyPhrase [ narr:text "She's on Individual because she's my fiancé and beta tester, not a sales target — although she fits the profile." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:keyPhrase [ narr:text "I think SMS is something that we should offer only for the enterprise plan, because we have to provision numbers individually and manage them and so on and so forth." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ] ;
    narr:keyPhrase [ narr:text "these AI identities have the opportunity to be the brand's identity" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_13> ] ;
    narr:variation [ narr:text "The channel thread contains a self-correction: an earlier 'product is a phone number' framing is disowned as a product experiment that over-embedded in the graph." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_7> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:variation [ narr:text "The phone-number channel is valued for how it feels yet flagged as costly maintenance and gated to enterprise — value and cost held together, tier mapping explicitly deferred." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_15> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_21> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ] ;
    narr:variation [ narr:text "The platform-over-toolbox principle sits against an admitted hard edge: users don't know what to say to the product." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:variation [ narr:text "The AI-as-deck-alternative is named as the future but admitted as not yet delivered to any consulting client." ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "principles stated flat and first-person; distribution ideas stay hedged notions — the conviction gradient tracks how core the claim is to the thesis" ; narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what the thing is not before saying what it is" ; narr:text "The product is not a phone number; it's the phone number distribution channel" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "inspirational-appeal — she sells the vision by painting the endpoint, not by asserting authority" ; narr:text "how do we get from one-shotting a website [that] looks like [Claude] every time to deliver an AI to Coca Cola" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_15> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "thesis claims sit in abstract present realis; exploratory ideas flip to future irrealis — tense marks what's held vs. floated" ; narr:text "Could I get all the people I know to contribute their expertise as the first modules?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "communal with insiders, market-pricing with customers — the register switches with who's in the frame" ; narr:text "She's on Individual because she's my fiancé and beta tester, not a sales target" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual baseline that turns technical exactly at the moat claim" ; narr:text "I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-negative only at the honest edges — the hard problems get a flat, unbothered delivery" ; narr:text "Feel like this is actually one of the hardest parts about this thing." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and autonomy lead — the recurring grievance is dependency on lossy interpretation of expert work" ; narr:text "they need to have someone in house that they pay quite a bit of money to then do a very lossy interpretation of your ideas" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
