    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_11> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_15> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_1> ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:keyPhrase [ narr:text "Feel like this is actually one of the hardest parts about this thing. Someone's like, what do I say now? And I'm like, I don't know, like, kind of anything." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:keyPhrase [ narr:text "We don't know yet how this maps to tiers... I'm doing this as a demo right now, and I'm trying to get some of these larger clients on the hook... I don't want to make that decision right now." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ] ;
    narr:keyPhrase [ narr:text "I haven't delivered an AI perspective as an alternative to a deck to a consulting client yet. But actually I think that's a really... that does seem like the future to me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ] ;
    narr:variation [ narr:text "She flags her own earlier framing as a product experiment that leaked into the graph — the phone-number thesis is partly a correction of the record, not just a refinement." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_7> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:variation [ narr:text "The confident capability thesis sits against an admitted low point: she doesn't know what users should say to the product." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:variation [ narr:text "Pricing is explicitly deferred — she names the tier-mapping decision as one she's refusing to make while demoing to larger clients." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ] ;
    narr:variation [ narr:text "The AI-perspective-as-deck-alternative is claimed as the future but never delivered — aspiration, not track record." ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ] ;
    narr:variation [ narr:text "Distribution is held as open notions (seeding from people she knows, a podcast marketplace) rather than a settled motion — now under review by advisors pre-fundraising." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_1> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "principle-first — she states the thesis as a settled rule, then lets distribution stay notion-level" ; narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what the thing is not before saying what it is" ; narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "inspirational-appeal when selling the vision, legitimate authority when deferring decisions" ; narr:text "when you're talking about brand identity... these AI identities have the opportunity to be the brand's identity." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_13> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "abstract-present realis for the thesis, flipping to concrete-future irrealis the moment she imagines distribution" ; narr:text "I could build out the marketplace by basically creating a podcast where I interview people about their business and perspective, and each of those things gets packaged into an installable expertise and they're just available." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and autonomy — the framing is always about who carries the expertise" ; narr:text "It's really about the delegation of work that requires expertise to carry it out. And the person, the business owner, the consultant, the expert, is currently the bottleneck." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "communal-sharing with her circle, market-pricing the moment money enters" ; narr:text "She's on Individual because she's my fiancé and beta tester, not a sales target — although she fits the profile." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual and plain-spoken baseline, technical only when naming the moat" ; narr:text "Feel like this is actually one of the hardest parts about this thing. Someone's like, what do I say now? And I'm like, I don't know, like, kind of anything." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm and level even when naming uncertainty or cost" ; narr:text "It's also a lot more work because of the maintenance around fraud, et cetera, as we're seeing above with the verification." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_21> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}