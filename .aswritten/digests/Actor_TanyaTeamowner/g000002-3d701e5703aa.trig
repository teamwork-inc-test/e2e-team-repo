    narr:generatedFrom "3d701e5703aa3f959ba54d59603077ba4a8ce3db" ;
    narr:narration """Tanya's voice here is a sales-motion articulation plus a beta-testing relationship, all voiced in her own register. The through-line runs from [the renaming of the product to installable expertise](narr:Expr_1RealFreyaPodcastSalesMotion20260323_24) through [the technical moat of extracting citable perspective from documents](narr:Expr_1RealFreyaPodcastSalesMotion20260323_26) to [the target market: experts packaging their work in static, bounded forms](narr:Expr_1RealFreyaPodcastSalesMotion20260323_28) and [the bottleneck framing of delegated expert work](narr:Expr_1RealFreyaPodcastSalesMotion20260323_30). She holds the product stance as principle — [a platform-over-toolbox ambition for installable expertise](narr:Expr_1RealFreyaPodcastSalesMotion20260323_32) — while the go-to-market side stays exploratory: [seeding initial perspectives from people she knows](narr:Expr_1RealFreyaPodcastSalesMotion20260323_34) and [a podcast-driven marketplace build-out](narr:Expr_1RealFreyaPodcastSalesMotion20260323_7). A second thread grounds the product in [her fiancé as beta tester rather than sales target](narr:Expr_2RealTessChatWidget20260423_44), [the volume of her verbal feedback](narr:Expr_2RealTessChatWidget20260423_54), and [an admitted hard edge: users not knowing what to say](narr:Expr_2RealTessChatWidget20260423_58). Style-lane shows antithesis-first phrasing, analogy, and rhetorical questions; conviction splits between firm principle/claim on the product thesis and irrealis 'notion' on distribution and open problems.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_54> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ;
    narr:keyPhrase [ narr:text "I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:keyPhrase [ narr:text "the business owner, the consultant, the expert, is currently the bottleneck." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:keyPhrase [ narr:text "She's on Individual because she's my fiancé and beta tester, not a sales target — although she fits the profile." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:keyPhrase [ narr:text "She's the single most prolific beta tester and has had more feedback than anyone." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_54> ] ;
    narr:keyPhrase [ narr:text "Feel like this is actually one of the hardest parts about this thing." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:variation [ narr:text "Product thesis held as firm principle while distribution stays irrealis 'notion' — the confident core rests on speculative go-to-market." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ] ;
    narr:variation [ narr:text "The confident sales motion sits against a calm-negative admission that the hardest part is unresolved — users facing a blank prompt." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:variation [ narr:text "The marketplace framing prices expertise as installable product, yet the closest working relationship is communal — a fiancé testing for free." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "principle-and-claim on the product thesis, dropping to hedged 'notion' the moment she leaves it — conviction tracks distance from the core framing" ; narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "abstract-present-realis when asserting, concrete-future-irrealis when imagining — the tense shifts with the conviction" ; narr:text "Could I get all the people I know to contribute their expertise as the first modules?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't before what it is, with analogy and rhetorical questions close behind" ; narr:text "Because what we need and the big narrative foundation is not intelligence is capability." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "inspirational-appeal when selling the vision, legitimate-authority when explaining who gets access" ; narr:text "She's on Individual because she's my fiancé and beta tester, not a sales target — although she fits the profile." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "communal-sharing in close relationships, market-pricing framing everywhere else" ; narr:text "Could I get all the people I know to contribute their expertise as the first modules?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and autonomy lead — the pitch is about experts unblocked from being the bottleneck" ; narr:text "It's really about the delegation of work that requires expertise to carry it out." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-negative appears only once, in the casual register, when admitting an unsolved problem" ; narr:text "Feel like this is actually one of the hardest parts about this thing." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual and plain-spoken baseline, turning technical only for the moat claim" ; narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
