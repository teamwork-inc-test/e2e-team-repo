    narr:covers <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_62> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ;
    narr:keyPhrase [ narr:text "Tanya TeamOwner reviewed a change to a position and rejected it, with one comment." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_1> ] ;
    narr:keyPhrase [ narr:text "how is the minimum soak duration between site cutovers determined and validated?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_2> ] ;
    narr:keyPhrase [ narr:text "how should multi-site cutovers be sequenced when operational containment conflicts with local site friction?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_60> ] ;
    narr:keyPhrase [ narr:text "Tanya TeamOwner rejected the change under review" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_61> ] ;
    narr:keyPhrase [ narr:text "the one-week figure is as unmeasured as the two weeks was; nobody has run a soak yet" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_62> ] ;
    narr:keyPhrase [ narr:text "this reads as though containment settled the sequencing; the call weighed it against local site friction and did not settle it" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
    narr:keyPhrase [ narr:text "we never agreed a single-site pilot — the call settled on two sites in parallel" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ] ;
    narr:variation [ narr:text "The two September 23 rejections contest different mainline framings — one on pilot scope, one on sequencing rationale — rather than one recurring complaint." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ] ;
    narr:variation [ narr:text "The September 28 rejection carries no quoted counter-claim of its own, unlike the September 23 rejections which each quote a specific disagreement — it leans on attached open questions instead." ; narr:over <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_61> ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
    narr:variation [ narr:text "The pilot-scope rejection was submitted by Claude on Tanya's behalf rather than recorded as her own act, a different evidentiary footing than the directly-attributed rejections." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "Rejections land as flat decisions, not argued claims — the verb states, it doesn't defend." ; narr:text "Tanya TeamOwner rejected the change under review" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_61> ] ;
