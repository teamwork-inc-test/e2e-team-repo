    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "Alternates between abstract present-tense procedural questions and concrete past-tense verdicts." ; narr:text "how should multi-site cutovers be sequenced when operational containment conflicts with local site friction?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_60> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "Matter-of-fact even while correcting the record — no hedge, no escalation." ; narr:text "this reads as though containment settled the sequencing; the call weighed it against local site friction and did not settle it" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
