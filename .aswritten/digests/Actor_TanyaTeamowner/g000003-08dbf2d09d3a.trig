    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_21> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_35> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:keyPhrase [ narr:text "She's on Individual because she's my fiancé and beta tester, not a sales target — although she fits the profile." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:keyPhrase [ narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:keyPhrase [ narr:text "I think SMS is something that we should offer only for the enterprise plan, because we have to provision numbers individually and manage them and so on and so forth." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ] ;
    narr:variation [ narr:text "A prior framing — the product as a phone number — is explicitly corrected to channel-not-product, with the earlier text flagged as a product experiment that points to an extraction issue." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_7> ] ;
    narr:variation [ narr:text "The phone-number channel is both an upsell and a burden: value felt in the medium vs. fraud/maintenance cost, and an enterprise-only restriction proposed while tier mapping stays undecided." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_20> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_21> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ] ;
    narr:variation [ narr:text "Against the confident product thesis sits an admitted open problem: users not knowing what to say." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:variation [ narr:text "Conviction splits by domain: principle/claim on the product, irrealis 'notion' on distribution and scoping subgraphs." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_35> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "principle and claim on the product thesis, dropping to irrealis 'notion' on distribution and open problems" ; narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't — with analogy and rhetorical questions as secondary moves" ; narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "abstract realis when holding the thesis, flipping to concrete irrealis when exploring what could be built" ; narr:text "I could build out the marketplace by basically creating a podcast where I interview people about their business and perspective, and each of those things gets packaged into an installable expertise and they're just available." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "inspirational appeal when pitching the vision, legitimate authority when deferring a decision" ; narr:text "We don't know yet how this maps to tiers... I'm doing this as a demo right now, and I'm trying to get some of these larger clients on the hook... I don't want to make that decision right now." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "communal-sharing with her circle, market-pricing the moment tiers and upsells enter" ; narr:text "You know, I could have some initially available perspectives. Could I get all the people I know to contribute their expertise as the first modules? Like do your design thinking version and have that available." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence drives the thesis; relatedness shows in how she frames the people around the product" ; narr:text "She's on Individual because she's my fiancé and beta tester, not a sales target — although she fits the profile." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-negative when naming hard problems — flat, undefensive admission" ; narr:text "Feel like this is actually one of the hardest parts about this thing. Someone's like, what do I say now? And I'm like, I don't know, like, kind of anything." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical baseline for the moat, casual everywhere else" ; narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
