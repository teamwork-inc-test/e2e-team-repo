    narr:keyPhrase [ narr:text "The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:keyPhrase [ narr:text "One week is the soak, and please don't hold the plan to two weeks on my say-so, because I was wrong on the eighth." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:keyPhrase [ narr:text "Two weeks was two reconciliation cycles. It was never about the site settling." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:keyPhrase [ narr:text "the one-week soak should name who signs off the second site before it starts" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ] ;
    narr:keyPhrase [ narr:text "And this needs to be in the vendor exit conversation, not after it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_24> ] ;
    narr:keyPhrase [ narr:text "I'd assumed we'd just keep paying the vendor to leave it running." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_6> ] ;
    narr:variation [ narr:text "The two-week soak she once said she'd hold us to still stands in the record beside the one-week retraction — the original number is superseded, not deleted." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_12> ] ;
    narr:variation [ narr:text "She retracts the number but holds the sequencing fixed — the correction is scoped to the soak, not the strategy." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_11> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:variation [ narr:text "The newest decision opens an unresolved authority question — who signs off the second site — that nothing else in the profile answers." ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ] ;
    narr:variation [ narr:text "Her voiced, argued correction contrasts with the review acceptance she only signed, relayed through Claude's report rather than her own words." ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_9> ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_2> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claims held as positions until evidence moves them, then converted to explicit decisions — including decisions against herself" ; narr:text "That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_9> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence sets two terms against each other, then resolves by naming what the choice is not" ; narr:text "A double cutover is a staffing problem and a data problem at the same time, which isn't." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_15> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "rational-persuasion baseline — she wins arguments with log evidence, and reaches for legitimate pressure only to strike her own number" ; narr:text "Two weeks was two reconciliation cycles. It was never about the site settling." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence over caution — defensibility with known slack beats conservatism on imaginary grounds" ; narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — she argues from specific past measurements to specific future numbers" ; narr:text "Four sites, three soaks between them, a week off each." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_17> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "mostly flat facilitator calm; the one activated-negative spike is a nagging doubt she acts on rather than drops" ; narr:text "I went back through the Dockside logs on Friday because Xavier's comment about it being one site, one season was bothering me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking surfaces only where accountability needs a name — she wants the sign-off owned, not assumed" ; narr:text "the one-week soak should name who signs off the second site before it starts" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
