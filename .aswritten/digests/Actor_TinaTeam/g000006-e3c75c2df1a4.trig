    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_21> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_6> ;
    narr:keyPhrase [ narr:text "The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:keyPhrase [ narr:text "On the eighth I said the soak between sites has to be two full weeks, and I said I'd hold us to it. That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:keyPhrase [ narr:text "Two weeks was two reconciliation cycles. It was never about the site settling." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:keyPhrase [ narr:text "One week is the soak, and please don't hold the plan to two weeks on my say-so, because I was wrong on the eighth." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:keyPhrase [ narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:keyPhrase [ narr:text "the one-week soak should name who signs off the second site before it starts" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ] ;
    narr:keyPhrase [ narr:text "And this needs to be in the vendor exit conversation, not after it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_24> ] ;
    narr:variation [ narr:text "Her own two-week position stands retracted by her own hand — the original call and the retraction both live here, and the retraction is the load-bearing one." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:variation [ narr:text "The same words now exist twice: her own review comment, and quoted inside another reviewer's comment — attribution boundary worth checking before citing." ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_9> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_21> ] ;
    narr:variation [ narr:text "Her only signed-but-not-voiced act is an acceptance relayed through Claude's report — a decision on record without her own argument behind it." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_2> ] ;
    narr:variation [ narr:text "A separate legacy wind-down thread (vendor retention, archive hold) sits outside the cutover spine entirely." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_6> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_24> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claim-first, decision when she moves — she argues, then commits, and retracts by explicit decision rather than drift" ; narr:text "That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence names what it isn't before what it is" ; narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "rational-persuasion over pressure — she moves people with the log, not the title, even when she holds the number" ; narr:text "I went back through the Dockside logs on Friday because Xavier's comment about it being one site, one season was bothering me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — past evidence cited to fix future numbers, never abstract" ; narr:text "Strip the reconciliation cycles out of the Dockside curve and the underlying exception rate is flat by day four." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence over conservation — being right about where the slack is beats being safely wrong" ; narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_6> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "mostly calm; a spike of activated-negative when her own error nags at her" ; narr:text "I went back through the Dockside logs on Friday because Xavier's comment about it being one site, one season was bothering me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_10> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "moves from communal-sharing (holding the group to a number) to authority-ranking when she names who signs off" ; narr:text "the one-week soak should name who signs off the second site before it starts" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
