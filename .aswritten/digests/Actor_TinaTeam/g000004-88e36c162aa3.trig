    narr:keyPhrase [ narr:text "The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:keyPhrase [ narr:text "That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:keyPhrase [ narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:keyPhrase [ narr:text "And this needs to be in the vendor exit conversation, not after it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_24> ] ;
    narr:keyPhrase [ narr:text "I'd assumed we'd just keep paying the vendor to leave it running." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_6> ] ;
    narr:keyPhrase [ narr:text "It would have come out at Northgate either way, and worse." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_24> ] ;
    narr:variation [ narr:text "Her own two-week soak figure, argued hard on the eighth, is retracted outright a week later — the strongest claim in the graph is the one she struck herself." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:variation [ narr:text "The legacy-archive thread shows her holding a mere notion ('I'd assumed') rather than a claim — a lower-conviction register than the cutover spine." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_6> ] ;
    narr:variation [ narr:text "The review acceptance is a relayed decision signed through Claude's report, not her own voiced argument — her signature and her voice diverge there." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_2> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claims and decisions stated flat and owned — and retracted with the same flatness when wrong" ; narr:text "That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't before what it is, often in parallel halves" ; narr:text "A double cutover is a staffing problem and a data problem at the same time, which isn't." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_15> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "rational-persuasion grounded in named evidence rather than position" ; narr:text "I quoted the Dockside number — the exception queue not flattening until day nine or ten." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated either way — past evidence cited precisely, future commitments pinned to numbers" ; narr:text "It takes three weeks out of the programme. Four sites, three soaks between them, a week off each." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_17> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence-framed — the concern is being right, not looking right" ; narr:text "Before we start on anything else, I need to correct something I said, and I'd rather do it at the top than bury it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_1> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive in the brief evaluative asides" ; narr:text "Sensible." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_21> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking appears only relayed — through Claude's report of her acceptance act, not in her own words" ] ;
