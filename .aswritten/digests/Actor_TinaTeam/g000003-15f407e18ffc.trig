    narr:keyPhrase [ narr:text "A double cutover is a staffing problem and a data problem at the same time, which isn't." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_15> ] ;
    narr:keyPhrase [ narr:text "The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:keyPhrase [ narr:text "That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:keyPhrase [ narr:text "Two weeks was two reconciliation cycles. It was never about the site settling." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:keyPhrase [ narr:text "One week is the soak, and please don't hold the plan to two weeks on my say-so, because I was wrong on the eighth." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:keyPhrase [ narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:variation [ narr:text "Her own hard two-week soak commitment is later retracted by her, on re-analysis, as measuring a retired job — the number she'd hold the plan to is the one she strikes." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:variation [ narr:text "The retraction is scoped: sequencing stands, only the number moves — the original structural argument survives the correction of its evidence." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_11> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_15> ] ;
    narr:variation [ narr:text "The acceptance act is a decision signed but relayed through another's report — authority exercised without her own voiced argument in the record." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_2> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claim-conviction that converts to decision when the evidence moves — and a principle-level habit of preferring defensibility over comfort" ; narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "rational-persuasion backed by re-analysis — she wins the point by showing the log work, not by pulling rank" ; narr:text "The reason the queue took nine days to flatten at Dockside is that the old reconciliation job ran weekly and every run threw a fresh batch of exceptions." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated in both directions — she anchors arguments in what the past actually showed and what the plan will cost" ; narr:text "It takes three weeks out of the programme. Four sites, three soaks between them, a week off each." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_17> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence-first — the sting of being wrong is about the work being right, not about face" ; narr:text "Before we start on anything else, I need to correct something I said, and I'd rather do it at the top than bury it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_1> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism as the default sentence shape — she defines a thing by what it is not, then balances the halves" ; narr:text "It's one site, one season, and it's the only site we've actually done. I'd rather hold two weeks and shorten it with evidence than hold one week and discover we needed two." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking appears only in relayed form — her sign-off on a decision reaches the record through someone else's report, not her own words" ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
