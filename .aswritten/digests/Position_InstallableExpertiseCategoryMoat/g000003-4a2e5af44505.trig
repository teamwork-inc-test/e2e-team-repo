GRAPH <https://aswritten.ai/narrative#Digest_Position_InstallableExpertiseCategoryMoat> {
  <https://aswritten.ai/narrative#Digest_Position_InstallableExpertiseCategoryMoat> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_InstallableExpertiseCategoryMoat> ;
    narr:childCount "10"^^xsd:integer ;
    narr:generatedFrom "4a2e5af44505dae82a1f0f0aac97e2348a790a70" ;
    narr:narration """This position holds that the boundary of installable expertise — a rename from an earlier 'memory word' framing — is capability rather than information: [the narrative foundation that more information does not solve your problem](narr:Expr_1RealFreyaPodcastSalesMotion20260323_24). The claimed technical moat is a specific pipeline: [extracting perspective from textual documents and making it citable in the individual task](narr:Expr_1RealFreyaPodcastSalesMotion20260323_26), restated verbatim in a later advisor call. A second moat framing qualifies the first: [the ingested graph itself as the moat, with a proprietary read and manipulation layer](narr:Expr_6RealAdvisorCall20260728_14). The target market is defined by [experts who package their work statically — books, blogs, trainings, courses, decks](narr:Expr_1RealFreyaPodcastSalesMotion20260323_28), with the underlying problem framed as [delegation of expert work where the expert is the bottleneck](narr:Expr_1RealFreyaPodcastSalesMotion20260323_30), sharpened by [the lossy interpretation clients suffer when working from static assets](narr:Expr_4RealFreyaDesignTokens20260702_19). The product ambition is stated as [building the Apple of installable expertise rather than giving you a toolbox](narr:Expr_1RealFreyaPodcastSalesMotion20260323_32). A later admission qualifies the market story: [no AI perspective has yet been delivered to a consulting client as an alternative to a deck](narr:Expr_4RealFreyaDesignTokens20260702_17). Nothing here addresses pricing, named competitors, or implementation detail.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_14> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_18> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_26> ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "the graph itself is the moat, right? And like, yes, I'm letting someone store the data in their repo, but the read and manipulation layer is proprietary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_14> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:keyPhrase [ narr:text "I haven't delivered an AI perspective as an alternative to a deck to a consulting client yet." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ] ;
    narr:keyPhrase [ narr:text "not intelligence is capability. And more information does not solve your problem." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:variation [ narr:text "Two competing moat claims sit side by side: the extract-and-cite pipeline versus the ingested-graph-as-moat with a proprietary read layer — the latter is newer and untested against the former." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_14> ] ;
    narr:variation [ narr:text "The market story is aspirational, not proven: the speaker concedes no client has yet received an AI perspective in place of a deck, while still calling it the future." ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_26> ] ;
    narr:variation [ narr:text "The rename from 'memory word' to installable expertise means older framings may still be reachable for and should not be assumed superseded in every context." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it is by naming what it isn't" ; narr:text "not intelligence is capability. And more information does not solve your problem." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "principled assertion at the frame level, claim-level confidence on mechanism, dropping to 'notion' when admitting what hasn't shipped" ; narr:text "I haven't delivered an AI perspective as an alternative to a deck to a consulting client yet. But actually I think that's a really... that does seem like the future to me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "inspirational appeal for vision, rational persuasion for the market problem" ; narr:text "what someone is hiring you for now is a static asset that they then are dependent on you to either execute on, or they need to have someone in house that they pay quite a bit of money to then do a very lossy interpretation of your ideas and then continue on forward." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical when naming the mechanism, casual and plain-spoken when framing the narrative" ; narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "abstract-present for the thesis, concrete only when touching actual delivery" ; narr:text "I haven't delivered an AI perspective as an alternative to a deck to a consulting client yet." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and autonomy — the expert freed from being the bottleneck" ; narr:text "It's really about the delegation of work that requires expertise to carry it out. And the person, the business owner, the consultant, the expert, is currently the bottleneck." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}