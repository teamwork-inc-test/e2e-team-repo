    narr:generatedFrom "91a64595898d7daf51efb7ee046e6c9870fbba0f" ;
    narr:narration """This position holds that the boundary of installable expertise — the rename from an earlier 'memory word' framing — is capability, not information: [the narrative foundation that more information does not solve your problem](narr:Expr_1RealFreyaPodcastSalesMotion20260323_24). The claimed technical moat is a specific pipeline: [extracting perspective from textual documents and making it citable in the individual task](narr:Expr_1RealFreyaPodcastSalesMotion20260323_26). The target market is defined by [experts who currently package their work statically — books, blogs, trainings, courses, decks](narr:Expr_1RealFreyaPodcastSalesMotion20260323_28), with the underlying problem framed as [delegation of expert work where the expert is the bottleneck](narr:Expr_1RealFreyaPodcastSalesMotion20260323_30). The product ambition is stated as [building the Apple of installable expertise rather than giving you a toolbox](narr:Expr_1RealFreyaPodcastSalesMotion20260323_32). All children date to the same day and all support the position; the span covers naming/renaming, moat mechanics, market definition, problem framing, and product philosophy — nothing here addresses pricing, competition, or technical implementation detail.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "And more information does not solve your problem." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:keyPhrase [ narr:text "And the person, the business owner, the consultant, the expert, is currently the bottleneck." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:variation [ narr:text "Product philosophy tension: an integrated end-to-end 'Apple' ambition set against explicitly rejecting the toolbox framing — a scope claim that could read either as vision or as overreach." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:variation [ narr:text "The moat is asserted as 'the real differentiator' but rests on a single-sentence pipeline claim; no supporting evidence or competitive comparison appears under this hub." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "principle-level conviction — stated as a foundation, not an opinion" ; narr:text "Because what we need and the big narrative foundation is not intelligence is capability." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "inspirational appeal — frames the mission as something to join, not a spec to evaluate" ; narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual and plain-spoken at the vision level, turning technical only when naming the moat" ; narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't before what it is" ; narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "abstract present-tense realis — speaks of the market and moat as already true" ; narr:text "It's really about the delegation of work that requires expertise to carry it out." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and autonomy — the expert freed from being the bottleneck" ; narr:text "And the person, the business owner, the consultant, the expert, is currently the bottleneck." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
