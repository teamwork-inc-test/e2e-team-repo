@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Position_InstallableExpertiseCategoryMoat> {
  <https://aswritten.ai/narrative#Digest_Position_InstallableExpertiseCategoryMoat> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_InstallableExpertiseCategoryMoat> ;
    narr:childCount "7"^^xsd:integer ;
    narr:generatedFrom "a3b3776b00e91d42f37e53859ea1cd3275e9dfe7" ;
    narr:narration """This position holds that the boundary of installable expertise — a rename from an earlier 'memory word' framing — is capability rather than information: [the narrative foundation that more information does not solve your problem](narr:Expr_1RealFreyaPodcastSalesMotion20260323_24). The claimed technical moat is a specific pipeline: [extracting perspective from textual documents and making it citable in the individual task](narr:Expr_1RealFreyaPodcastSalesMotion20260323_26). The target market is defined by [experts who package their work statically — books, blogs, trainings, courses, decks](narr:Expr_1RealFreyaPodcastSalesMotion20260323_28), with the underlying problem framed as [delegation of expert work where the expert is the bottleneck](narr:Expr_1RealFreyaPodcastSalesMotion20260323_30), sharpened by [the lossy interpretation clients suffer when working from static assets](narr:Expr_4RealFreyaDesignTokens20260702_19). The product ambition is stated as [building the Apple of installable expertise rather than giving you a toolbox](narr:Expr_1RealFreyaPodcastSalesMotion20260323_32). A later admission qualifies the market story: [no AI perspective has yet been delivered to a consulting client as an alternative to a deck](narr:Expr_4RealFreyaDesignTokens20260702_17). Nothing here addresses pricing, named competitors, or implementation detail.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:keyPhrase [ narr:text "I haven't delivered an AI perspective as an alternative to a deck to a consulting client yet." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ] ;
    narr:keyPhrase [ narr:text "a very lossy interpretation of your ideas" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ] ;
    narr:variation [ narr:text "The moat is asserted as real, but its flagship use case is admitted to be undelivered — conviction runs at 'notion' where the client-facing proof would be." ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:variation [ narr:text "The market definition assumes experts will abandon static packaging (decks, books, courses) — the very assets the problem framing says clients still depend on." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_19> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}