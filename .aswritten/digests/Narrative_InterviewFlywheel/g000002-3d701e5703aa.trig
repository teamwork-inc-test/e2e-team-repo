    narr:covers <https://aswritten.ai/narrative#Position_PerShareChatWidgetArchitecture> ;
    narr:keyPhrase [ narr:text "The breakthrough: the demo call, the marketing content, and the product onboarding are the same event." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_3> ] ;
    narr:keyPhrase [ narr:text "This is a content flywheel that also builds the marketplace supply side." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_5> ] ;
    narr:keyPhrase [ narr:text "No bait and switch." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_45> ] ;
    narr:keyPhrase [ narr:text "texting is so associated with spam now that requiring someone to text might actually be a real downside" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_9> ] ;
    narr:keyPhrase [ narr:text "A chat widget on the share page is the right fit for evaluator, skeptic, first-touch, and demo contexts — no number, no verification, no opt-in form, no spam frame." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_30> ] ;
    narr:keyPhrase [ narr:text "This is a scoping, not a replacement." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_32> ] ;
    narr:keyPhrase [ narr:text "Whether the chat widget replaces or augments SMS for Demo 1 is a decision, not a drift." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_71> ] ;
    narr:variation [ narr:text "The SMS channel is context-dependent, not universal: it works where the sender is already trusted, flips suspicious in evaluator contexts — a scoping, not a replacement." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_10> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_11> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_32> ] ;
    narr:variation [ narr:text "The operational cost of the SMS onramp has been absorbed, not priced — the trust tax persists even when verification succeeds." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_15> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_16> ] ;
    narr:variation [ narr:text "An explicit stop condition exists: if verification fails again, stop investing in the SMS onramp for evaluator contexts and pivot to the chat widget." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_67> ] ;
    narr:variation [ narr:text "Open questions resist closure: whether the widget replaces or augments SMS for Demo 1 and Tess-category users, whether inbox creation is API-automatable, and whether Pat's HIPAA-adjacent context inverts the trust tax." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_71> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_75> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_76> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_77> ] ;
    narr:variation [ narr:text "The 'SMS is the product' framing had already been walked back twice before this thread narrowed it further." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_27> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_28> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
