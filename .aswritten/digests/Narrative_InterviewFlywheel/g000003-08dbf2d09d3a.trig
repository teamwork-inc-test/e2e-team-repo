    narr:keyPhrase [ narr:text "The breakthrough: the demo call, the marketing content, and the product onboarding are the same event." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_3> ] ;
    narr:keyPhrase [ narr:text "This is a content flywheel that also builds the marketplace supply side." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_5> ] ;
    narr:keyPhrase [ narr:text "in a lot of skeptical or lower-trust contexts, texting is so associated with spam now that requiring someone to text might actually be a real downside" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_9> ] ;
    narr:keyPhrase [ narr:text "A chat widget on the share page is the right fit for evaluator, skeptic, first-touch, and demo contexts — no number, no verification, no opt-in form, no spam frame." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_30> ] ;
    narr:keyPhrase [ narr:text "a phone number doesn't feel like an AI chat in the same way that chat does" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_15> ] ;
    narr:keyPhrase [ narr:text "verification churn is a permanent operational cost of running SMS at scale" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_25> ] ;
    narr:keyPhrase [ narr:text "Whether the chat widget replaces or augments SMS for Demo 1 is a decision, not a drift." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_71> ] ;
    narr:variation [ narr:text "The trust-cost challenge qualifies the flywheel's SMS-based demo motion: the channel that felt honest in one context flips to spam-adjacent in evaluator contexts." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_9> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_11> ] ;
    narr:variation [ narr:text "The chat-widget answer is explicitly a scoping, not a replacement — SMS stays alive where the sender is already welcome." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_32> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_29> ] ;
    narr:variation [ narr:text "The later correction insists the SMS-honesty claim is NOT superseded — the phone number's non-AI texture remains genuine value even as the widget wins evaluator contexts." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_17> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_18> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_15> ] ;
    narr:variation [ narr:text "Replace-vs-augment for Demo 1 is flagged as an explicit undecided decision, not settled drift." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_71> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_69> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_75> ] ;
    narr:variation [ narr:text "An open outlier: the trust tax might invert for the HIPAA-adjacent user, where a chat widget could be the riskier channel." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_77> ] ;
    narr:variation [ narr:text "A conditional pivot trigger remains live: if verification fails again, stop investing in the SMS onramp for evaluator contexts." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_67> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_22> ] ;
