    narr:keyPhrase [ narr:text "The breakthrough: the demo call, the marketing content, and the product onboarding are the same event." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_3> ] ;
    narr:keyPhrase [ narr:text "This is a content flywheel that also builds the marketplace supply side." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_5> ] ;
    narr:keyPhrase [ narr:text "But in a lot of skeptical or lower-trust contexts, texting is so associated with spam now that requiring someone to text might actually be a real downside." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_9> ] ;
    narr:keyPhrase [ narr:text "A chat widget on the share page is the right fit for evaluator, skeptic, first-touch, and demo contexts — no number, no verification, no opt-in form, no spam frame." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_30> ] ;
    narr:keyPhrase [ narr:text "There is some real value to the way the phone number feels. That's really important: a phone number doesn't feel like an AI chat in the same way that chat does." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_15> ] ;
    narr:keyPhrase [ narr:text "This is not the first verification cycle and it will not be the last; verification churn is a permanent operational cost of running SMS at scale." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_25> ] ;
    narr:variation [ narr:text "The SMS-honesty framing is context-dependent, not universal — it flips in evaluator contexts where spam training makes SMS more suspicious, qualifying the earlier claim." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_11> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_12> ] ;
    narr:variation [ narr:text "The chat widget is a scoping, not a replacement — SMS stays alive where the sender is already welcome, and replace-vs-augment for Demo 1 is flagged as a decision, not drift." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_32> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_71> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_29> ] ;
    narr:variation [ narr:text "Channel-not-product holds both sides: the phone number's non-AI texture is real value even as SMS adds trust friction for the Knowledge-Rich Consumer archetype." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_14> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_15> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_30> ] ;
    narr:variation [ narr:text "The trust tax may invert per user — the HIPAA-adjacent context question suggests the widget-vs-SMS answer isn't uniform across the cohort." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_77> ] ;
    narr:variation [ narr:text "A stop-invest signal is pre-committed: if verification fails again, the SMS onramp for evaluator contexts is abandoned for the widget." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_67> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
