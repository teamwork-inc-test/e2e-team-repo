    narr:keyPhrase [ narr:text "The breakthrough: the demo call, the marketing content, and the product onboarding are the same event." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_3> ] ;
    narr:keyPhrase [ narr:text "This is a content flywheel that also builds the marketplace supply side." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_5> ] ;
    narr:keyPhrase [ narr:text "Three outputs from one conversation." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_4> ] ;
    narr:keyPhrase [ narr:text "No bait and switch." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_45> ] ;
    narr:keyPhrase [ narr:text "The \"drafts\" framing is internal; the published version should feel like a media property." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_44> ] ;
    narr:variation [ narr:text "The motion exists at two conviction levels: Tanya's casual, irrealis 'could I' musing versus Claude's abstract-realis articulation of it as an operating mechanism — the idea is voiced as notion but narrated as settled." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_4> ] ;
    narr:variation [ narr:text "Freya's interview intent is only relayed (calm-positive, via Claude), not held firsthand — the flagship first case rests on a secondhand want." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_37> ] ;
    narr:variation [ narr:text "Communal-sharing seeding (free modules from people Tanya knows) sits alongside a marketplace/commercial framing — gift economy vs supply-side growth remain unreconciled." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_34> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_5> ] ;
