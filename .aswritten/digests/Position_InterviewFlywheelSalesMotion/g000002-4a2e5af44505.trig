GRAPH <https://aswritten.ai/narrative#Digest_Position_InterviewFlywheelSalesMotion> {
  <https://aswritten.ai/narrative#Digest_Position_InterviewFlywheelSalesMotion> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_InterviewFlywheelSalesMotion> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "4a2e5af44505dae82a1f0f0aac97e2348a790a70" ;
    narr:narration """This position holds that a single expert interview can serve three functions at once: [the demo call, the marketing content, and the product onboarding are the same event](narr:Expr_1RealFreyaPodcastSalesMotion20260323_3), unpacked as [three outputs from one conversation](narr:Expr_1RealFreyaPodcastSalesMotion20260323_4) — an installable perspective delivered with a free account, a published content piece, and a live proof of the product working. The strategic extension is that [this flywheel also builds the marketplace supply side](narr:Expr_1RealFreyaPodcastSalesMotion20260323_5). A supporting observation notes [the interview removes the expert's setup-work barrier](narr:Expr_1RealFreyaPodcastSalesMotion20260323_41), which is what makes the podcast model viable. The owner's own framing remains tentative: [packaging each interview into installable expertise](narr:Expr_1RealFreyaPodcastSalesMotion20260323_7) is voiced as a possibility, not a commitment, and the same notion reappears [restated on a later advisor call](narr:Expr_6RealAdvisorCall20260728_24) still in irrealis register.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_41> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_24> ;
    narr:keyPhrase [ narr:text "the demo call, the marketing content, and the product onboarding are the same event" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_3> ] ;
    narr:keyPhrase [ narr:text "Three outputs from one conversation." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_4> ] ;
    narr:keyPhrase [ narr:text "This is a content flywheel that also builds the marketplace supply side." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_5> ] ;
    narr:keyPhrase [ narr:text "the interview removes the \"finding time\" barrier because the expert doesn't have to do the setup work" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_41> ] ;
    narr:keyPhrase [ narr:text "I could build out the marketplace by basically creating a podcast where I interview people about their business and perspective" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ] ;
    narr:variation [ narr:text "The owner's framing stays in notion/irrealis register — a possibility voiced, not a commitment — while the supporting expressions state the mechanism in flat realis." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_24> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_3> ] ;
    narr:variation [ narr:text "The same tentative marketplace framing recurs months later on an advisor call without firming — the idea has persisted but not hardened." ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_24> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_7> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
