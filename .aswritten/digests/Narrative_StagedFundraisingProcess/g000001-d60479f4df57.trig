    narr:keyPhrase [ narr:text "I'm raising 500k at this point to do a bridge round to get me to enough enterprise traction that I can do a true, you know, million seed." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_102> ] ;
    narr:keyPhrase [ narr:text "you are not raising. You're not trying to get someone to give you a check. You are creating a marketplace for as written." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_191> ] ;
    narr:keyPhrase [ narr:text "So it is specific. It is time bound. It is like starts at a date, ends at a date." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_193> ] ;
    narr:keyPhrase [ narr:text "Hi, I am raising money. It is happening, right?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_199> ] ;
    narr:keyPhrase [ narr:text "why should I take your dollars rather than someone else's? Right." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_205> ] ;
    narr:keyPhrase [ narr:text "Emery Park is the howitzer. You show up like. Right. You use the howitzer when you have the ammunition." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_185> ] ;
    narr:keyPhrase [ narr:text "All right, well, I'm doing the YC app this week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_222> ] ;
    narr:variation [ narr:text "The YC route is framed as optionality-taking ('dumb money... take it'), sitting alongside — not inside — the staged marketplace process; the two paths are never reconciled." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_143> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_145> ] ;
    narr:variation [ narr:text "Consulting work that preserves optionality for the venture is raised as a parallel road not taken, qualifying the all-in raise posture." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_145> ] ;
    narr:variation [ narr:text "The advice-first opening round deliberately inverts the declarative 'I am raising money' stance the same speaker later prescribes — the tension between the two phases is the design, not a contradiction to smooth over." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_195> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_199> ] ;
    narr:variation [ narr:text "Cold-emailing all listed VC emails sits uneasily with the leverage thesis that individual outreach is the wrong frame." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_194> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_191> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
