    narr:keyPhrase [ narr:text "You are creating a marketplace for as written." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_191> ] ;
    narr:keyPhrase [ narr:text "It is time bound. It is like starts at a date, ends at a date." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_193> ] ;
    narr:keyPhrase [ narr:text "I am raising money. It is happening, right?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_199> ] ;
    narr:keyPhrase [ narr:text "why should I take your dollars rather than someone else's" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_205> ] ;
    narr:keyPhrase [ narr:text "You use the howitzer when you have the ammunition." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_185> ] ;
    narr:keyPhrase [ narr:text "I'm raising 500k at this point to do a bridge round" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_102> ] ;
    narr:keyPhrase [ narr:text "know the strategic environment you are operating in" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_28> ] ;
    narr:keyPhrase [ narr:text "Just stop and go sell it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_30> ] ;
    narr:variation [ narr:text "The low-cost optionality path runs parallel to the declarative marketplace raise — a hedge alongside the harder ask." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_143> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_191> ] ;
    narr:variation [ narr:text "The advice-seeking first round and the declarative second round are deliberately opposite postures toward the same targets." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_195> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_199> ] ;
    narr:variation [ narr:text "The biggest lever is explicitly withheld until there's a term sheet — a sequencing choice that trades an immediate shot for later leverage." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_179> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_183> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_185> ] ;
    narr:variation [ narr:text "A caution about the broader strategic environment qualifies the short-term-win framing, pushed against by a blunter call to just execute." ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_28> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_30> ] ;
    narr:variation [ narr:text "A pricing and positioning worry surfaces late without resolution, sitting outside the process-and-staging frame." ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_2> ] ;
    narr:writer "subscription.anthropic/claude-sonnet-5" .
