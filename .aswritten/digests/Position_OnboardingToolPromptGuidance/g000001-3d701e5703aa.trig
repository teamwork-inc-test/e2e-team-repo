GRAPH <https://aswritten.ai/narrative#Digest_Position_OnboardingToolPromptGuidance> {
  <https://aswritten.ai/narrative#Digest_Position_OnboardingToolPromptGuidance> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_OnboardingToolPromptGuidance> ;
