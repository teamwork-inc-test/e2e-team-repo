    narr:covers <https://aswritten.ai/narrative#Position_SprintVelocityCausalAttribution> ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786614422719_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786614422719_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786614422719_3> ] ;
    narr:keyPhrase [ narr:text "Core feature: decision capture at the point of consensus." ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:variation [ narr:text "Tension persists between attributing velocity gains to the new widget versus the Zephyr integration." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786614422719_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786614422719_3> ; narr:over <https://aswritten.ai/narrative#Position_SprintVelocityCausalAttribution> ] ;
