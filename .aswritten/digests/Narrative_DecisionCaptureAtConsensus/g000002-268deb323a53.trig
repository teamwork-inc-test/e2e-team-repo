    narr:covers <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ;
    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784801427646_1> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784801427646_3> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784801427646_2> ] ;
    narr:variation [ narr:text "The focus on technical integration as the primary driver of velocity may obscure other contributors to team performance." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784801427646_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784801427646_3> ] ;
