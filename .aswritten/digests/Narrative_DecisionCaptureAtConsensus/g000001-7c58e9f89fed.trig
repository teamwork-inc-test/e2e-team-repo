    narr:variation [ narr:text "Tension exists between measuring success via feature shipping (widget/integration) versus quantitative output (velocity)." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785406405073_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785406405073_2> ] ;
