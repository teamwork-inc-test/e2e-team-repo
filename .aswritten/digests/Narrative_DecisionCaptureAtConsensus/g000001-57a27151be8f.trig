    narr:covers <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ;
    narr:covers <https://aswritten.ai/narrative#Position_SprintExecutionDrivers> ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789205548941_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789205548941_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789205548941_3> ] ;
    narr:keyPhrase [ narr:text "Core feature: decision capture at the point of consensus." ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "This is the product's primary differentiator" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:variation [ narr:text "The team-owner's delivery updates lean self-enhancing (a highest-of-quarter velocity claim) with no independent corroboration in this hub." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789205548941_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789205548941_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789205548941_3> ] ;
    narr:variation [ narr:text "The driver-focused frame asks what technical capabilities drove the milestone but carries no content yet — a signal this hub does not (yet) hold that answer." ; narr:over <https://aswritten.ai/narrative#Position_SprintExecutionDrivers> ] ;
