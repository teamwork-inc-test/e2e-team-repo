    narr:keyPhrase [ narr:text "This is the product's primary differentiator" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789809781028_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789809781028_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789809781028_3> ] ;
    narr:variation [ narr:text "The delivery evidence is a single team owner's account — the velocity claim and the integration credit rest on one witness, not corroborated elsewhere in this graph." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789809781028_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1789809781028_3> ] ;
