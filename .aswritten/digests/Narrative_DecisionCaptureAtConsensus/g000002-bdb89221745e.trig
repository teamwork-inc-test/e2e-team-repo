    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785838678389_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785838678389_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785838678389_3> ] ;
    narr:variation [ narr:text "The focus on technical integration (Zephyr) contrasts with the broader, user-centric goal of decision capture." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785838678389_3> ; narr:over <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
