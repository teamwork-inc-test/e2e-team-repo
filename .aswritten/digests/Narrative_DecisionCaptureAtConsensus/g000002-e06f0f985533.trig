    narr:covers <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4ProofPoints> ;
    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785059979981_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785059979981_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785059979981_3> ] ;
    narr:variation [ narr:text "The Zephyr integration is framed as a metaphorical 'unlock' rather than a purely functional milestone." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785059979981_3> ] ;
