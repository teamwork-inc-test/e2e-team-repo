    narr:covers <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ;
    narr:keyPhrase [ narr:text "capturing the decision artifact at the moment it's made" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786872563090_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786872563090_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786872563090_3> ] ;
    narr:variation [ narr:text "The focus on communal sharing and decision-making (widget) contrasts with the market-pricing and self-enhancement framing of velocity metrics." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786872563090_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786872563090_2> ] ;
