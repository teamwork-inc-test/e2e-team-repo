    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787922766540_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787922766540_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787922766540_3> ] ;
    narr:variation [ narr:text "The focus shifts between communal-sharing (widget/integration) and market-pricing (velocity metrics)." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787922766540_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787922766540_2> ] ;
