    narr:covers <https://aswritten.ai/narrative#Position_Sprint4DeliveryEvidence> ;
    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786011453597_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786011453597_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786011453597_3> ] ;
    narr:variation [ narr:text "The evidence focuses on team velocity and shipping metrics, leaving the long-term qualitative impact of consensus capture unmeasured." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786011453597_2> ] ;
