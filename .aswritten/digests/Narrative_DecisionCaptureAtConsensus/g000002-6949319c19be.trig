    narr:covers <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4DeliveryClaims> ;
    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787835375249_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787835375249_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787835375249_3> ] ;
    narr:variation [ narr:text "The tension between concrete delivery claims and the meta-inquiry on how those claims are constructed remains unresolved." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787835375249_1> ; narr:over <https://aswritten.ai/narrative#Position_Sprint4DeliveryClaims> ] ;
