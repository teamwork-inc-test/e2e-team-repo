    narr:covers <https://aswritten.ai/narrative#Position_Sprint4OutcomeAttribution> ;
    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785320401145_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785320401145_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785320401145_3> ] ;
    narr:variation [ narr:text "Attribution tension: performance gains linked to feature deployment versus technical integration." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785320401145_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785320401145_3> ] ;
