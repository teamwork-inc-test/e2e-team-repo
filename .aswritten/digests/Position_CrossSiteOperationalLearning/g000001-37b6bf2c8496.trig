GRAPH <https://aswritten.ai/narrative#Digest_Position_CrossSiteOperationalLearning> {
  <https://aswritten.ai/narrative#Digest_Position_CrossSiteOperationalLearning> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_CrossSiteOperationalLearning> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "37b6bf2c84965cc245e031aab2e50ce7a0484a10" ;
    narr:narration """This position holds that sequential, one-at-a-time site cutovers compound operational skill across teams rather than duplicating errors in parallel. The support runs from [concrete first-night evidence that a supervisor's second cutover goes visibly better than their first](narr:Expr_2HalyardOpsReadiness20260915_18), through [the general claim that the learning curve transfers across sites instead of four teams repeating the same mistake](narr:Expr_2HalyardOpsReadiness20260915_19), to [a stress-test question about whether the sequencing would survive eased staffing](narr:Expr_2HalyardOpsReadiness20260915_21) and [the answer that it would — held for the learning reason, though argued less strongly and fronted differently for the steering group](narr:Expr_2HalyardOpsReadiness20260915_22). A brief [confirmation ties the general framing back to the observed case](narr:Expr_2HalyardOpsReadiness20260915_20). The span covers observed skill transfer, its abstraction into a rollout principle, and the boundary condition under counterfactual staffing.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_19> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_20> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_21> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ;
    narr:keyPhrase [ narr:text "The Dockside crew were visibly better on night two than night one, and that was the same night." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ] ;
    narr:keyPhrase [ narr:text "Learning curve across sites rather than four teams all making the same mistake in parallel." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_19> ] ;
    narr:keyPhrase [ narr:text "If you gave me twenty supervisors tomorrow I'd still say one at a time, for the learning reason. But I'd be saying it less strongly." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:keyPhrase [ narr:text "The staffing argument is the one I'd put in front of the steering group." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:variation [ narr:text "Two arguments for the same sequencing — the learning rationale is the speaker's real conviction, but the staffing rationale is what gets presented upward, a deliberate gap between held position and argued position." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_19> ] ;
    narr:variation [ narr:text "The learning claim rests on a single-site observation (Dockside, one night pair) generalized to all sites — the abstraction outruns its evidence." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_19> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}