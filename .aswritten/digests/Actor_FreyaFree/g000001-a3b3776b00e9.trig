GRAPH <https://aswritten.ai/narrative#Digest_Actor_FreyaFree> {
  <https://aswritten.ai/narrative#Digest_Actor_FreyaFree> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Actor_FreyaFree> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "a3b3776b00e91d42f37e53859ea1cd3275e9dfe7" ;
    narr:narration """Freya Free's voice here spans two working registers. One is [design-token craft](https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_6): she describes an extraction-to-tokenization pipeline where [Claude output is made to look like her initial designs, not a Claude website](https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_8), and she pushes toward a stronger claim — [that the lens itself is the unique, controlling part](https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10). The other register is [video and sales-motion principle](https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_14), where she rules on format — [the hero video as human moment rather than screen recording](https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15). Her style-lane runs antithesis-first with metaphor behind it, and the dimensional pattern is expert-voiced, present-tense, mostly plain-to-technical.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_14> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_6> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_8> ;
    narr:keyPhrase [ narr:text "Don't make people read text in a video." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_14> ] ;
    narr:keyPhrase [ narr:text "The hero video is a human moment, not a screen recording." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ] ;
    narr:keyPhrase [ narr:text "it is the lens that controls all of that." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ] ;
    narr:keyPhrase [ narr:text "It doesn't look anything like a Claude website. It looks like the initial designs." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_8> ] ;
    narr:keyPhrase [ narr:text "I have a process where I extract everything that builds into a design language which gets tokenized." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_6> ] ;
    narr:variation [ narr:text "Her strongest claim — the lens alone controls everything — sits against her own admission that the tokens need input and that she tightens results with visuals." ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_6> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_8> ] ;
    narr:variation [ narr:text "Two registers coexist without bridging: abstract format principles for video versus concrete technical pipeline narration for design tokens." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_14> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_6> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "principle-first when ruling on format, claim-first when describing her own process — she states rather than hedges" ; narr:text "Don't make people read text in a video." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_14> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert footing throughout — she speaks as the authority on her own pipeline, persuading by reasoning" ; narr:text "without my input through my own lens, it breaks, it falls down." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "shifts between authority-ranking pronouncements and communal-sharing when crediting the build" ; narr:text "which I suppose is effectively what you've built there" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "present-tense throughout, sliding from abstract principle to concrete realis when she narrates the pipeline" ; narr:text "The tokens get applied to surfaces... if I build a website, I actually build it from the extraction at the beginning." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_6> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what a thing is by naming what it isn't — with metaphor as her second habit" ; narr:text "The hero video is a human moment, not a screen recording." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "autonomy and competence — the worth at stake is that the system works only through her lens" ; narr:text "without my input through my own lens, it breaks, it falls down." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
