    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_9> ;
    narr:keyPhrase [ narr:text "A cutover night pulls four of my supervisors out of the normal rota — two on the floor, one on the desk, one on the phone to the vendor." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ] ;
    narr:keyPhrase [ narr:text "I can't staff that. It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:keyPhrase [ narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:keyPhrase [ narr:text "The dates, as early as you can give them, and a commitment that a soak doesn't get shortened because a date slipped." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:keyPhrase [ narr:text "Then I'm content." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_30> ] ;
    narr:variation [ narr:text "She hedges her own mainline: with more staff she'd still favor sequencing but less strongly, and would front the staffing case rather than the learning case to the steering group." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:variation [ narr:text "Two reasons coexist under one position — the hard staffing arithmetic and the softer learning benefit she calls 'worth something you won't see in a plan' — and she ranks them differently by audience." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "flat claim-stating that hardens into decision when terms are met — she asserts, then settles" ; narr:text "It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert persuasion with a pressure edge when she names conditions — she argues from her own rota, not authority" ; narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "stratified inside her own hierarchy, equality-matching outward — she bargains peers on even terms" ; narr:text "If you gave me twenty supervisors tomorrow I'd still say one at a time, for the learning reason." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and realis when arguing, irrealis only when setting future conditions — and she cites past nights as evidence" ; narr:text "The Dockside crew were visibly better on night two than night one, and that was the same night." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation first — protecting her people's workload — with competence pride underneath" ; narr:text "If the soak gets eaten, my supervisors are back on the floor at the same time as the next cutover and we're in the same place by another route." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive throughout; satisfaction expressed in short, settled closings" ; narr:text "Happy to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_4> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't before what it is — with rota metaphors doing the explanatory work" ; narr:text "It's the one that doesn't move. The others you can argue with." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_16> ] ;
