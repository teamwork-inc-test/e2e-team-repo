    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_9> ;
    narr:keyPhrase [ narr:text "I can't staff that. It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:keyPhrase [ narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:keyPhrase [ narr:text "If you gave me twenty supervisors tomorrow I'd still say one at a time, for the learning reason. But I'd be saying it less strongly." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:keyPhrase [ narr:text "The dates, as early as you can give them, and a commitment that a soak doesn't get shortened because a date slipped." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:keyPhrase [ narr:text "The Dockside crew were visibly better on night two than night one, and that was the same night." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ] ;
    narr:variation [ narr:text "Her own qualification: the sequencing case would survive abundant staffing, but only on the learning argument and less forcefully — the staffing case is the one she'd take to the steering group." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:variation [ narr:text "The soak-protection condition resurfaces days later as a review comment, suggesting it was not yet secured when the exchange closed settled." ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_18> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_30> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "flat claim-assertion — she states positions as facts of her rota, not arguments" ; narr:text "It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert persuasion shading into pressure — she wins by laying out the constraint, then names what she needs" ; narr:text "The dates, as early as you can give them, and a commitment that a soak doesn't get shortened because a date slipped." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "swaps registers by audience — equality-matching when setting terms, authority-ranking when choosing what to carry upward" ; narr:text "The staffing argument is the one I'd put in front of the steering group." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and realis in the present, shifting to irrealis only when stating future conditions" ; narr:text "Two cutovers in the same week means eight of eleven are on cutover duty, and the other three are covering four sites' worth of normal operations" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation-first — protecting her people's capacity — with a competence streak underneath" ; narr:text "If the soak gets eaten, my supervisors are back on the floor at the same time as the next cutover and we're in the same place by another route." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_18> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive throughout — terse satisfaction markers, no heat even while refusing" ; narr:text "Then I'm content." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_30> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't before what it is — with occasional metaphor" ; narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
