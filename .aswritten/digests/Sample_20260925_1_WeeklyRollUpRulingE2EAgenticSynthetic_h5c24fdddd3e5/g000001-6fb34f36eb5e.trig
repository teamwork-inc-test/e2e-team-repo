GRAPH <https://aswritten.ai/narrative#Digest_Sample_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5> {
  <https://aswritten.ai/narrative#Digest_Sample_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Sample_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "6fb34f36eb5eb8108f7efd3e933975303fe8748a" ;
    narr:narration """This call is a single dated ruling on how weekly reactions reach people. [Tanya opens with the ruling frame](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_1), then [keeps the per-run bundle and adds a Friday roll-up of what moved and what is still open](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2). [Tina's relayed question](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3) tests the scope, and [Tanya answers that the bundle serves the run while the roll-up serves the week](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4). The ruling closes by [rejecting a daily digest as redundant with the bundle](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:keyPhrase [ narr:text "Tina asked whether the roll-up replaces the per-run bundle." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "Tina's relayed question — does the roll-up replace the bundle? — is answered but not signed off by her; the replacement reading stays open." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ] ;
    narr:variation [ narr:text "A daily digest was explicitly rejected as an alternative cadence, not merely left unconsidered." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}