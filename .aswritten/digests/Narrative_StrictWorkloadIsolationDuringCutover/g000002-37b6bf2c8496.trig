    narr:generatedFrom "37b6bf2c84965cc245e031aab2e50ce7a0484a10" ;
    narr:narration """This narrative holds a single, firmly-decided position: during cutover windows, reporting reads come off the replica, never the live system. The arc runs from [the motivating incident — reporting load atop migration and dual-write taking the site down for forty minutes](narr:Expr_1HalyardWeekly20260908_24), corroborated by [a witness who remembers the forty minutes](narr:Expr_1HalyardWeekly20260908_25), through [the rule stated as absolute, not \"where possible\"](narr:Expr_1HalyardWeekly20260908_26), to [the accepted tradeoff — replica lag of thirty seconds to four minutes, staleness judged preferable to outage](narr:Expr_1HalyardWeekly20260908_28), with [the staleness tolerance grounded in nobody deciding off a four-minute-old parcel count at two in the morning](narr:Expr_1HalyardWeekly20260908_29). It lands as [a decision to write the rule into the runbook as a rule, not guidance, because guidance gets negotiated at three a.m.](narr:Expr_1HalyardWeekly20260908_31), carried into [the rollout plan: one site at a time, two-week soak, reporting off the replica, vendor holds reference data until green](narr:Expr_1HalyardWeekly20260908_42). A later session surfaces [the unstated assumption beneath both rules — one cutover window open at a time, which would need rewriting if cutover ever went parallel](narr:Expr_2HalyardOpsReadiness20260915_25), and [that alternative is foreclosed outright](narr:Expr_2HalyardOpsReadiness20260915_26).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_25> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_29> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ;
    narr:keyPhrase [ narr:text "Reporting on top of that is what took Dockside down for forty minutes." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ] ;
    narr:keyPhrase [ narr:text "reporting does not touch the live system during a cutover window, full stop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "Nobody is making a decision off a four-minute-old parcel count at two in the morning." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_29> ] ;
    narr:keyPhrase [ narr:text "guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "one site at a time, two-week soak between sites, reporting off the replica during cutover, vendor holds reference data until Clyde is green." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
    narr:variation [ narr:text "The rules assume one cutover window open at a time — parallel cutover would require rewriting both, and that road is foreclosed rather than explored." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ] ;
    narr:variation [ narr:text "The staleness tradeoff is asserted, not tested — four-minute-stale reporting is judged acceptable by argument, with no counter-voice recorded." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_29> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "moves from expert claim to flat decision once authority ratifies — the claims are argued, the decisions are one-liners" ; narr:text "Then let's not go parallel." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert persuasion when proposing, legitimate authority when closing — the proposal is reasoned, the ruling is bare" ; narr:text "Then that's the rule. Reporting reads come off the replica during cutover." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated when recalling, concrete-irrealis when committing — the past is witnessed, the future is scheduled" ; narr:text "So Thursday I'm telling them: one site at a time, two-week soak between sites" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "plain-spoken at the decision point, technical in the reasoning underneath" ; narr:text "because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking in the closing move — the rule is set, not negotiated" ; narr:text "Xavier, write it into the runbook as a rule and not as guidance" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation — protecting what works over chasing freshness" ; narr:text "a four-minute-stale number is fine and an outage is not." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
