GRAPH <https://aswritten.ai/narrative#Digest_Narrative_StrictWorkloadIsolationDuringCutover> {
  <https://aswritten.ai/narrative#Digest_Narrative_StrictWorkloadIsolationDuringCutover> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_StrictWorkloadIsolationDuringCutover> ;
    narr:childCount "7"^^xsd:integer ;
    narr:generatedFrom "6554c93c5c55a181b729ea30886d1ffe6558631d" ;
    narr:narration """This narrative holds a single, firmly-decided position: during cutover windows, reporting reads must come off the replica, never the live system. The arc runs from [the incident that motivates it — reporting load atop migration and dual-write taking the site down for forty minutes](narr:Expr_1HalyardWeekly20260908_24), through [the proposed rule stated as absolute, not \"where possible\"](narr:Expr_1HalyardWeekly20260908_26), to [the accepted tradeoff — replica lag of thirty seconds to four minutes, with staleness judged preferable to outage](narr:Expr_1HalyardWeekly20260908_28). It lands as [a decision to write the rule into the runbook as a rule, not guidance, because guidance gets negotiated at three a.m.](narr:Expr_1HalyardWeekly20260908_31), and is carried forward into [the rollout plan: one site at a time, two-week soak, reporting off the replica, vendor holds reference data until green](narr:Expr_1HalyardWeekly20260908_42). Supporting voices corroborate the incident ([\"I remember the forty minutes\"](narr:Expr_1HalyardWeekly20260908_25)) and the staleness tolerance ([nobody deciding off a four-minute-old parcel count at two in the morning](narr:Expr_1HalyardWeekly20260908_29)).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_25> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_29> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ;
    narr:keyPhrase [ narr:text "Reporting on top of that is what took Dockside down for forty minutes." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ] ;
    narr:keyPhrase [ narr:text "reporting does not touch the live system during a cutover window, full stop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "one site at a time, two-week soak between sites, reporting off the replica during cutover, vendor holds reference data until Clyde is green." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
    narr:variation [ narr:text "The position is not free: it accepts up to four minutes of reporting staleness during cutover — the tradeoff that had to be argued, not assumed." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:variation [ narr:text "The rule is framed against its own likely erosion — guidance that \"gets negotiated at three a.m.\" — so the binding form (runbook rule) is itself part of the position." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}