    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_18> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_19> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_20> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_6> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_8> ;
