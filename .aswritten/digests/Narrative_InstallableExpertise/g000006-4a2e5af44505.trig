    narr:covers <https://aswritten.ai/narrative#Position_StagedFundraisingProcessMarketplace> ;
    narr:covers <https://aswritten.ai/narrative#Position_SubgraphScopingTemporalityOntology> ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise. Because what we need and the big narrative foundation is not intelligence is capability. And more information does not solve your problem." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:keyPhrase [ narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:keyPhrase [ narr:text "without my input through my own lens, it breaks, it falls down. So that shows that the actual unique part is by [my] lens — is applying the lens, which I suppose is effectively what you've built there... it is the lens that controls all of that." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ] ;
    narr:keyPhrase [ narr:text "One of my operating theses is the telephone company always wins. The telephone company always wins because the telephone company sits in between. And it's impossible to disintermediate because they sit in between." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_12> ] ;
    narr:keyPhrase [ narr:text "90% of what I see people chasing though is structure for context and memory." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_19> ] ;
    narr:variation [ narr:text "Xavier's intermediary thesis pushes back on the graph-as-moat claim: a better version can displace it, as incumbents with beachheads did to Garmin — the graph alone may not be the durable moat." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_111> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_15> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_14> ] ;
    narr:variation [ narr:text "The phone-number tagline keeps re-embedding despite repeated correction attempts — the extraction pipeline cannot yet distinguish experiment claims from product identity, and the fix is deliberately deferred." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_44> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_33> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_5> ] ;
    narr:variation [ narr:text "The deck-replacement thesis is validated in principle but unexecuted: no consulting client has actually received a perspective in place of a deck." ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_26> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_4> ] ;
    narr:variation [ narr:text "Beta feedback cuts against the abstraction ambition: non-technical users find backend vocabulary entirely foreign, and the hardest part is what to say after connecting at all." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:variation [ narr:text "Tina's market observation reframes the category from the buyer's side — most of the field is chasing structure for context and memory, not installable expertise — pressuring the differentiation story." ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_19> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_20> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
