@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Narrative_InstallableExpertise> {
  <https://aswritten.ai/narrative#Digest_Narrative_InstallableExpertise> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_InstallableExpertise> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "91a64595898d7daf51efb7ee046e6c9870fbba0f" ;
    narr:narration """This narrative arc, all voiced on the same date, runs from a renaming to a market thesis. It opens with [the deliberate retirement of the 'memory' framing in favor of installable expertise](narr:Expr_1RealFreyaPodcastSalesMotion20260323_24), grounded in the principle that capability, not more information, is what solves the customer's problem. From there it moves to [the technical-moat claim: extracting perspective from documents and making it citable in the individual task](narr:Expr_1RealFreyaPodcastSalesMotion20260323_26), and then to [the target market defined by rhetorical questions — experts whose work is packaged statically as books, courses, decks](narr:Expr_1RealFreyaPodcastSalesMotion20260323_28). The use case is framed as [delegating expertise-requiring work, with the expert currently the bottleneck](narr:Expr_1RealFreyaPodcastSalesMotion20260323_30), and the product ambition is capped by [the Apple analogy — building the platform for installable expertise rather than handing over a toolbox](narr:Expr_1RealFreyaPodcastSalesMotion20260323_32).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "And more information does not solve your problem." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "And the person, the business owner, the consultant, the expert, is currently the bottleneck." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:variation [ narr:text "The framing itself is in motion: the 'memory' positioning was explicitly dropped for 'installable expertise' — anyone reaching for the memory framing is working from a superseded name." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:variation [ narr:text "Platform-vs-tool tension: the Apple analogy positions the product as an end-to-end capability platform, which sits in tension with the narrower technical-moat claim about citable perspective extraction — two different scopes for what the product is." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:variation [ narr:text "The market definition is framed as open questions about who qualifies (books, blogs, trainings, decks) rather than a settled segment — the target customer is posed, not concluded." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_28> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}