    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:keyPhrase [ narr:text "Everything you said about committing and pulling and all of that is completely foreign to me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ] ;
    narr:keyPhrase [ narr:text "it is the lens that controls all of that." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ] ;
    narr:keyPhrase [ narr:text "I haven't delivered an AI perspective as an alternative to a deck to a consulting client yet." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ] ;
    narr:variation [ narr:text "The thesis is validated from outside, but the flagship move — delivering a perspective in place of a deck to a real client — remains undone, per the owner's own admission." ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_4> ] ;
    narr:variation [ narr:text "Live beta friction (backend jargon, freeze-after-connect) sits in tension with the abstraction-first thesis; the cognitive cost is acknowledged as motivating the abstraction work." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_64> ] ;
    narr:variation [ narr:text "The wrong product-identity claim has been corrected before and re-failed; the fix requires deletion-plus-promotion in one transaction, not a parallel addition." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_44> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_40> ] ;
    narr:variation [ narr:text "The temporality fix exists on paper but was deliberately deferred from the April 9 launch to avoid breaking extraction tests." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_33> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
