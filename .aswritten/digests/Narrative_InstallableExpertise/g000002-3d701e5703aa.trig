    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_35> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_36> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_37> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_38> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_41> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_55> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_56> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_57> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_59> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_60> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_61> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_62> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_64> ;
    narr:covers <https://aswritten.ai/narrative#Position_OnboardingToolPromptGuidance> ;
    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "It's really about the delegation of work that requires expertise to carry it out." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_30> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:keyPhrase [ narr:text "Tess is a Knowledge Packager." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_38> ] ;
    narr:keyPhrase [ narr:text "Everything you said about committing and pulling and all of that is completely foreign to me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ] ;
    narr:keyPhrase [ narr:text "It's almost like once connected, blah, come back and compile. I feel like it's really like, visit this link, install it, come back and say done." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_60> ] ;
    narr:variation [ narr:text "The thesis argues capability over information, but the beta subject got stuck exactly on capability delivery, needing literal step-by-step script language rather than autonomous execution." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_60> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ] ;
    narr:variation [ narr:text "Tess is filed as a Knowledge Packager structurally identical to Pat Quill, yet the two differ on other axes (e.g. compliance requirements) that the packager label doesn't capture." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_37> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_41> ] ;
    narr:variation [ narr:text "Feedback from Tess sat uncaptured in an earlier onboarding transcript because the old 'memory' framing didn't surface it — a gap the renaming doesn't resolve on its own." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_55> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_56> ] ;
    narr:writer "subscription.anthropic/claude-sonnet-5" .
