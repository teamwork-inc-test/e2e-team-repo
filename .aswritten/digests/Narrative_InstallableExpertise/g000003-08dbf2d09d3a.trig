    narr:keyPhrase [ narr:text "I've let go of the memory word sort of entirely and I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The real differentiator and the technical moat is that I take textual documents and I extract perspective from them and then I make that perspective citable in the individual task." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_26> ] ;
    narr:keyPhrase [ narr:text "I'm more interested in developing the Apple to installable expertise than I am in giving you a toolbox." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_32> ] ;
    narr:keyPhrase [ narr:text "Feel like this is actually one of the hardest parts about this thing. Someone's like, what do I say now? And I'm like, I don't know, like, kind of anything." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ] ;
    narr:keyPhrase [ narr:text "Everything you said about committing and pulling and all of that is completely foreign to me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ] ;
    narr:keyPhrase [ narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:keyPhrase [ narr:text "There is currently no structural way to say \"this cluster of claims belongs to the text-for-topic experiment subgraph, not to the root product definition.\"" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_36> ] ;
    narr:variation [ narr:text "The dominant installable-expertise thesis is directly contested at the identity level: the phone-number tagline keeps re-embedding despite repeated correction attempts, and the fix (explicit supersession with same-transaction deletion) has re-failed before." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_3> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_44> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:variation [ narr:text "The beta evidence cuts against the smooth thesis: real users freeze post-install and find backend language foreign — friction the sales-motion framing doesn't narrate." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_58> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ] ;
    narr:variation [ narr:text "The root cause is diagnosed as graph-structural, not messaging: exploratory experiment claims get promoted to current worldview because temporality tagging is deferred and subgraph scoping doesn't exist yet." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_33> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_36> ] ;
    narr:variation [ narr:text "An adjacent fix (review-without-leaving-chat) explicitly does not address the onboarding freeze problem — the two are distinguished rather than merged." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_62> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
