    narr:keyPhrase [ narr:text "I'm now calling it installable expertise." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_24> ] ;
    narr:keyPhrase [ narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:keyPhrase [ narr:text "The product is curated expertise installation" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_9> ] ;
    narr:keyPhrase [ narr:text "it is the lens that controls all of that." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_10> ] ;
    narr:keyPhrase [ narr:text "the telephone company always wins" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_105> ] ;
    narr:keyPhrase [ narr:text "Everything you said about committing and pulling and all of that is completely foreign to me." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ] ;
    narr:keyPhrase [ narr:text "It's almost like once connected, blah, come back and compile." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_60> ] ;
    narr:variation [ narr:text "Tess's prescribed fix for the freeze-after-connect moment sits against her own account of backend concepts landing as entirely foreign — the onboarding gap isn't fully closed by the plain-language prompt alone." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_60> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_63> ] ;
    narr:variation [ narr:text "The phone-number tagline keeps re-embedding despite explicit correction, diagnosed as a structural extraction gap rather than a one-time slip." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_3> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_5> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_44> ] ;
    narr:variation [ narr:text "The designer's convergent validation of the lens-as-core thesis carries an open status note: the perspective-as-deck-alternative move has not actually been delivered to a client yet." ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_4> ; narr:over <https://aswritten.ai/narrative#Expr_4RealFreyaDesignTokens20260702_17> ] ;
    narr:variation [ narr:text "An outside operator's telephone-company/network-effects account of moat pushes against the citable-perspective-graph moat the thesis rests on — he grants the graph compounds in value but argues that alone isn't durable without becoming the intermediary others can't route around." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_110> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_111> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_119> ] ;
    narr:variation [ narr:text "A staged-fundraising frame surfaces from the same conversation, adjacent to but structurally outside the installable-expertise thesis." ; narr:over <https://aswritten.ai/narrative#Position_StagedFundraisingProcessMarketplace> ] ;
    narr:writer "subscription.anthropic/claude-sonnet-5" .
