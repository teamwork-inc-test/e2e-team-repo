@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_CutoverStrategy> {
  <https://aswritten.ai/narrative#Digest_CutoverStrategy> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#CutoverStrategy> ;
    narr:childCount "12"^^xsd:integer ;
    narr:generatedFrom "15f407e18ffc5e9c0ca0aea4e54d4e1ce1679f5c" ;
    narr:narration """This hub holds a single working session, opened under [steering-group pressure to decide the shape now](narr:Expr_1HalyardWeekly20260908_1), that resolves into a cutover doctrine: [a sequential one-site-at-a-time commitment, no parallel cutovers even for the small sites](narr:Expr_1HalyardWeekly20260908_8), defended as [contained pain with a named owner versus unbounded concurrent risk](narr:Expr_1HalyardWeekly20260908_13), and [summed as one at a time, with a soak](narr:Expr_1HalyardWeekly20260908_16). Two isolation rules qualify the sequencing: [reporting reads barred from the live system during cutover windows](narr:Expr_1HalyardWeekly20260908_26), ratified as [a runbook rule rather than negotiable guidance](narr:Expr_1HalyardWeekly20260908_31), and [vendor-held reference data persisting until the final site goes green](narr:Expr_1HalyardWeekly20260908_36). The session closes with [a read-back of the full position for the steering group](narr:Expr_1HalyardWeekly20260908_42). The reasoning generalizes into [bounded-friction-over-unbounded-risk](narr:Narrative_ContainedPainOverUnboundedRisk), [single-source-of-truth retention](narr:Narrative_SingleSourceOfTruthUntilFinalCutover), and [strict workload isolation](narr:Narrative_StrictWorkloadIsolationDuringCutover). An unvoiced question about [cross-site operational learning and skill compounding](narr:Position_CrossSiteOperationalLearning) sits alongside without a claim attached.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_16> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_ContainedPainOverUnboundedRisk> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SingleSourceOfTruthUntilFinalCutover> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_StrictWorkloadIsolationDuringCutover> ;
    narr:covers <https://aswritten.ai/narrative#Position_CrossSiteOperationalLearning> ;
    narr:keyPhrase [ narr:text "No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "Right. So: one at a time, with a soak." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_16> ] ;
    narr:keyPhrase [ narr:text "reporting does not touch the live system during a cutover window, full stop" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "we take ownership on the day Clyde goes green and not a day earlier" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:variation [ narr:text "The sequential doctrine is asserted as settled rather than argued through — the counter-position (parallel cutovers for small sites) is named only to be rejected, never weighed on the record." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:variation [ narr:text "An open question about cross-site operational learning and skill compounding sits unvoiced — a road the sequential choice forecloses without a claim attached." ; narr:over <https://aswritten.ai/narrative#Position_CrossSiteOperationalLearning> ] ;
    narr:variation [ narr:text "The isolation rules are framed as absolutes ('full stop', 'not a day earlier'), leaving no recorded exception path if a cutover window fails under load." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}