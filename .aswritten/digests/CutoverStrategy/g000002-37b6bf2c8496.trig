    narr:childCount "12"^^xsd:integer ;
    narr:generatedFrom "37b6bf2c84965cc245e031aab2e50ce7a0484a10" ;
    narr:narration """This hub holds one working session that resolves into a cutover doctrine. It opens under [steering-group pressure to decide the shape now](narr:Expr_1HalyardWeekly20260908_1), and lands on [a sequential one-site-at-a-time commitment with no parallel cutovers, even for the small sites](narr:Expr_1HalyardWeekly20260908_8), [summed as one at a time, with a soak](narr:Expr_1HalyardWeekly20260908_16). Two isolation rules qualify the sequencing: [reporting reads barred from the live system during cutover windows](narr:Expr_1HalyardWeekly20260908_26), ratified as [a runbook rule rather than negotiable guidance](narr:Expr_1HalyardWeekly20260908_31), and [vendor-held reference data persisting until the final site goes green](narr:Expr_1HalyardWeekly20260908_36). The session closes with [a read-back of the full position](narr:Expr_1HalyardWeekly20260908_42). The reasoning is generalized in [a bounded-friction-over-unbounded-risk justification](narr:Narrative_ContainedPainOverUnboundedRisk), alongside [single-source-of-truth retention](narr:Narrative_SingleSourceOfTruthUntilFinalCutover) and [strict workload isolation](narr:Narrative_StrictWorkloadIsolationDuringCutover). An unvoiced question about [cross-site operational learning and skill compounding](narr:Position_CrossSiteOperationalLearning) sits alongside without a claim attached.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_16> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_ContainedPainOverUnboundedRisk> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_SingleSourceOfTruthUntilFinalCutover> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_StrictWorkloadIsolationDuringCutover> ;
    narr:covers <https://aswritten.ai/narrative#Position_CrossSiteOperationalLearning> ;
    narr:keyPhrase [ narr:text "one at a time, with a soak" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_16> ] ;
    narr:keyPhrase [ narr:text "No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "reporting does not touch the live system during a cutover window, full stop" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "we take ownership on the day Clyde goes green and not a day earlier" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:variation [ narr:text "The trade was contested: the sequential stance was defended as the wrong-but-chosen trade against contained parallel pain, not reached without argument." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:variation [ narr:text "An open question about cross-site learning and skill compounding sits unvoiced — the benefit sequential sequencing might buy that the doctrine never claims." ; narr:over <https://aswritten.ai/narrative#Position_CrossSiteOperationalLearning> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "moves from defended claim to flat decision — the position is stated, then closed" ; narr:text "Right. So: one at a time, with a soak." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_16> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority backed by antithesis — rules drawn as rule-versus-guidance contrasts" ; narr:text "write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking in the open, market-pricing when weighing the trade" ; narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-future and irrealis — commitments framed as what will and won't happen" ; narr:text "we take ownership on the day Clyde goes green and not a day earlier." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual in the open, plain-spoken and technical when ruling" ; narr:text "Morning, both. Let's keep this one tight" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
