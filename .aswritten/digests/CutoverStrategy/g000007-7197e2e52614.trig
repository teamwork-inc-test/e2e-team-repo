    narr:keyPhrase [ narr:text "We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one. No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "reporting does not touch the live system during a cutover window, full stop" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:keyPhrase [ narr:text "we take ownership on the day Clyde goes green and not a day earlier" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "one site at a time, two-week soak between sites, reporting off the replica during cutover, vendor holds reference data until Clyde is green" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
    narr:variation [ narr:text "The sequential doctrine was contested before it settled — the parallel-cutover option was argued and explicitly rejected as the wrong trade, not never considered." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:variation [ narr:text "The isolation rule was framed as a hard rule precisely against the anticipated failure mode of it being softened into negotiable guidance under pressure." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:variation [ narr:text "Three newer frames — gatekeeper separation, data-quality gates, and governance risk disclosure — carry no voiced claim yet, leaving the settled doctrine without answers on enforcement independence and oversight." ; narr:over <https://aswritten.ai/narrative#Position_CutoverGatekeeperRoleSeparation> ; narr:over <https://aswritten.ai/narrative#Position_PreCutoverDataQualityGateEnforcement> ; narr:over <https://aswritten.ai/narrative#Position_ProactiveGovernanceRiskDisclosure> ] ;
    narr:variation [ narr:text "An open question about cross-site learning and skill compounding sits unvoiced — the sequential doctrine's own upside was never argued in the session." ; narr:over <https://aswritten.ai/narrative#Position_CrossSiteOperationalLearning> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-grade — she states positions as landed commitments, not proposals" ; narr:text "Then let me say where I've landed, because I don't think I'm going to move off it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority backed by external pressure — she invokes who is asking, then decides" ; narr:text "the steering group asks again on Thursday and I've given them \"we're still working it\" twice now." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking default, shifting to market-pricing when she argues a trade" ; narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual and plain-spoken, turning technical only when specifying the rule" ; narr:text "Morning, both. Let's keep this one tight" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-future and irrealis — she speaks in what will and must happen, dated to named events" ; narr:text "we take ownership on the day Clyde goes green and not a day earlier" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "activated-negative under deadline pressure — impatience voiced openly" ; narr:text "Let's keep this one tight — I want to come out of it with the cutover shape actually decided" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first with parallelism — the sentence names the two sides of a trade side by side" ; narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
