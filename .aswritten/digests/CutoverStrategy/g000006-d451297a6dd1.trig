    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ;
