GRAPH <https://aswritten.ai/narrative#Digest_Position_CutoverReportingReadIsolation> {
  <https://aswritten.ai/narrative#Digest_Position_CutoverReportingReadIsolation> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Position_CutoverReportingReadIsolation> ;
    narr:childCount "4"^^xsd:integer ;
    narr:generatedFrom "8017be90c4b9d7d74e07ff0e1d5cf6707052232a" ;
    narr:narration """This position holds that [reporting reads must come off the replica during cutover, full stop](narr:Expr_1HalyardWeekly20260908_26), grounded in [the incident where reporting on top of a loaded live system caused an outage](narr:Expr_1HalyardWeekly20260908_24). The supporting tradeoff is explicit: [replica lag of thirty seconds to four minutes is acceptable where an outage is not](narr:Expr_1HalyardWeekly20260908_28). It hardened into [a runbook rule rather than negotiable guidance](narr:Expr_1HalyardWeekly20260908_31).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_24> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ;
    narr:keyPhrase [ narr:text "during cutover, every reporting read comes off the replica" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "reporting does not touch the live system during a cutover window, full stop" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "Somewhere between thirty seconds and four minutes depending on the migration job" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:variation [ narr:text "The accepted cost is real: reporting numbers can be up to four minutes stale during cutover — freshness is traded for availability, not preserved." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:variation [ narr:text "The rule's force comes from its framing as non-negotiable — the explicit rejection of softer 'should / where possible' guidance language." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:run "bf3d5510c624" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}