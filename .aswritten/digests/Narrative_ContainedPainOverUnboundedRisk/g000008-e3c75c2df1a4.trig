    narr:covers <https://aswritten.ai/narrative#Position_SiteCutoverSequencingStrategy> ;
    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "Two cutovers in the same week means eight of eleven are on cutover duty" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ] ;
    narr:keyPhrase [ narr:text "Two weeks was two reconciliation cycles. It was never about the site settling." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:keyPhrase [ narr:text "the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:keyPhrase [ narr:text "the one-week figure is as unmeasured as the two weeks was; nobody has run a soak yet" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_62> ] ;
    narr:keyPhrase [ narr:text "the one-week soak should name who signs off the second site before it starts" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_ReviewCommentTinaTeammemberB4B484EaE94D4912B80BD_h8c260252a0a9_30> ] ;
    narr:keyPhrase [ narr:text "The two that went big-bang both went backwards — not failed, went backwards, six months of unpicking." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_5> ] ;
    narr:variation [ narr:text "The soak-duration basis is contested: the one-week figure is read as as unmeasured as the two weeks was, since nobody has run a soak yet" ; narr:over <https://aswritten.ai/narrative#Position_PostGoLiveSoakDurationBasis> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_2_ReviewCommentTanyaTeamownerAfbbdc56Cd2A440EAd0E0_hb725287d6759_62> ] ;
    narr:variation [ narr:text "A review rejection asserts no single-site pilot was ever agreed and the call settled on two sites in parallel, against the flat refusal of parallel cutovers" ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:variation [ narr:text "The corrected number trades slack for defensibility — tight, not safe, with no margin if a date slips" ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:variation [ narr:text "The soak evidence was always one site, one season — the only soak data the team has" ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:variation [ narr:text "Containment did not settle the sequencing; the desk-friction trade was weighed, not resolved" ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ] ;
    narr:pipelineCondition "review-renarrate:on" ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
