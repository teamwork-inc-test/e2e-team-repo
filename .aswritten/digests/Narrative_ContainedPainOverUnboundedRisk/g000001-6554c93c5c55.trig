    narr:generatedFrom "6554c93c5c55a181b729ea30886d1ffe6558631d" ;
    narr:narration """This narrative holds a rollout-strategy discussion that resolves toward [sequential cutovers with no parallel launches](narr:Expr_1HalyardWeekly20260908_8), grounded in a trade the group names as [contained pain at one desk versus an unbounded double cutover](narr:Expr_1HalyardWeekly20260908_13). The counter-pressure comes from [the shared dispatch desk that makes running two sites together tempting](narr:Expr_1HalyardWeekly20260908_12), which the mainline answers by reframing it as [a solvable rota problem rather than a compound staffing-and-data problem](narr:Expr_1HalyardWeekly20260908_15). The soak interval gets a hard number defended from [a prior pilot's exception curve that didn't flatten until late in the window](narr:Expr_1HalyardWeekly20260908_19), with the caveat that [that curve is the only supporting evidence](narr:Expr_1HalyardWeekly20260908_21) — met by a preference to [lengthen first and shorten with evidence rather than discover the shortfall live](narr:Expr_1HalyardWeekly20260908_22). It closes on [the four-site sequence and the reporting and vendor conditions to be presented upward](narr:Expr_1HalyardWeekly20260908_42).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_14> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_15> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_16> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_19> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_20> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_6> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ;
    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:keyPhrase [ narr:text "We watched the exception queue after go-live and it didn't flatten out until day nine or ten." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_19> ] ;
    narr:keyPhrase [ narr:text "I'll note that the exception curve is the only evidence we have for it. It's one site, one season." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:keyPhrase [ narr:text "one site at a time, two-week soak between sites, reporting off the replica during cutover, vendor holds reference data until Clyde is green" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
    narr:variation [ narr:text "The case for a combined cutover is real, not strawman: the two sites share a dispatch desk, and splitting them forces two systems at one desk — the supervisor's complaint since June." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ] ;
    narr:variation [ narr:text "The two-week soak rests on a single pilot's exception curve — one site, one season — an evidentiary thinness the group accepted rather than resolved." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}