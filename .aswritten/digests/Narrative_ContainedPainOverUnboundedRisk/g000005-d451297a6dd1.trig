    narr:covers <https://aswritten.ai/narrative#Position_SiteCutoverSequencingStrategy> ;
    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "Two cutovers in the same week means eight of eleven are on cutover duty" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ] ;
    narr:keyPhrase [ narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:keyPhrase [ narr:text "The reason the queue took nine days to flatten at Dockside is that the old reconciliation job ran weekly and every run threw a fresh batch of exceptions." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:keyPhrase [ narr:text "the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:keyPhrase [ narr:text "The two that went big-bang both went backwards — not failed, went backwards, six months of unpicking." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_5> ] ;
    narr:keyPhrase [ narr:text "the pressure to collapse the sequence always comes in month four, from someone who wasn't there in month one, and it always arrives dressed as efficiency" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_7> ] ;
    narr:variation [ narr:text "The review record contests the arc's own history: a rejection asserts no single-site pilot was ever agreed and the call settled on two sites in parallel, and a requested-changes note says containment did not settle the sequencing." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
    narr:variation [ narr:text "The one-week soak is defended as defensible but explicitly not safe — the correction costs slack that two weeks carried." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:variation [ narr:text "The staffing argument is held conditionally: even with twenty supervisors the sequencing would stand, but less strongly — the rota case is the one for the steering group, not the whole case." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:variation [ narr:text "The two-week soak's original evidence was challenged as one site, one season before being retracted entirely — the basis question remains open in the position node." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ; narr:over <https://aswritten.ai/narrative#Position_PostGoLiveSoakDurationBasis> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
