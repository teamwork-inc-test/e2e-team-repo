    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "Two cutovers in the same week means eight of eleven are on cutover duty" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ] ;
    narr:keyPhrase [ narr:text "the old reconciliation job ran weekly and every run threw a fresh batch of exceptions" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:keyPhrase [ narr:text "the new number is tight, not safe" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:keyPhrase [ narr:text "we never agreed a single-site pilot — the call settled on two sites in parallel" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ] ;
    narr:keyPhrase [ narr:text "it always arrives dressed as efficiency" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_7> ] ;
    narr:variation [ narr:text "A review rejection disputes the mainline's own record: no single-site pilot was agreed, and the call settled on two sites in parallel." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ] ;
    narr:variation [ narr:text "A requested-changes note qualifies the containment argument: the call weighed it against local site friction and did not settle the sequencing on it." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
    narr:variation [ narr:text "The one-week soak carries a standing caveat — defensible but with no slack — against the corrected analysis that justified it." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:variation [ narr:text "The two-week soak was retracted as measuring a retired job, but the original evidence claim (one site, one season) and its defense remain on record as the superseded road." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:variation [ narr:text "Freya concedes the staffing argument would weaken with more supervisors — the sequencing would then rest on the learning-curve reason, a softer footing than the one put to the steering group." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:variation [ narr:text "The advisor flags future pressure to collapse the sequence in month four, dressed as efficiency — the anticipated challenge to the whole arc." ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_7> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
