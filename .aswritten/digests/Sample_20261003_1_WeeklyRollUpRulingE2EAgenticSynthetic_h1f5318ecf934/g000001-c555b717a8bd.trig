    narr:variation [ narr:text "A reported question probed whether the roll-up replaces the per-run bundle; the ruling held the two distinct rather than substitutable." ; narr:over <https://aswritten.ai/narrative#Expr_20261003_1_WeeklyRollUpRulingE2EAgenticSynthetic_h1f5318ecf934_4> ; narr:over <https://aswritten.ai/narrative#Expr_20261003_1_WeeklyRollUpRulingE2EAgenticSynthetic_h1f5318ecf934_5> ] ;
