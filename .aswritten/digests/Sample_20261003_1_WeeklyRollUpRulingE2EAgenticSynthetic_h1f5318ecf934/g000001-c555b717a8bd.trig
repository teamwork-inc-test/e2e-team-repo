    narr:keyPhrase [ narr:text "the bundle is for the run, the roll-up is for the week" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261003_1_WeeklyRollUpRulingE2EAgenticSynthetic_h1f5318ecf934_5> ] ;
