    narr:generatedFrom "863c4b1a06c4ef62dd67af7a6c4b395ff87225ba" ;
    narr:narration """This hub spans a foundational positioning claim and a Sprint 4 execution report, holding them in proximity without resolving their relationship. The [core differentiator thesis](narr:Position_CoreFeatureDecisionCapture) — stated Mar 2026 — frames the product around capturing the decision artifact at the moment of consensus, not reconstructed after. Against that backdrop, three Jul 2026 delivery claims from TanyaTeamowner report concrete outcomes: [the async decision widget shipped](narr:Expr_1E2ETanyaCollab1784455139410_1), [velocity hit 23 points, highest this quarter](narr:Expr_1E2ETanyaCollab1784455139410_2), and [the Zephyr integration named as the key unlock](narr:Expr_1E2ETanyaCollab1784455139410_3). The [Sprint 4 delivery outcomes frame](narr:Position_Sprint4DeliveryOutcomes) holds the broader question of what was delivered and what enabled it. Whether the sprint results validate the core thesis, merely instantiate it, or sit independently of it is not settled here — the hub surfaces both the claim and the evidence, leaving their relationship open.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_3> ;
    narr:covers <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4DeliveryOutcomes> ;
    narr:keyPhrase [ narr:text "capturing the decision artifact at the moment it's made" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_3> ] ;
    narr:variation [ narr:text "The Zephyr integration is credited as the enabling mechanism for Sprint 4 velocity — a causal claim that sits alongside, but is not derived from, the decision-capture differentiator thesis; the two explanatory frames may compete." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_3> ; narr:over <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:variation [ narr:text "The Sprint 4 delivery frame asks what was delivered and what enabled it — a question the three execution claims only partially answer, leaving scope, quality, and adoption unaddressed." ; narr:over <https://aswritten.ai/narrative#Position_Sprint4DeliveryOutcomes> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_1> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
