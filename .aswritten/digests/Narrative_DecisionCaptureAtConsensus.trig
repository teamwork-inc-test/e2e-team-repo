    narr:covers <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4DeliveryDrivers> ;
    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784282346970_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784282346970_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784282346970_3> ] ;
    narr:variation [ narr:text "Tension exists between viewing the Zephyr integration as a purely technical unlock versus a broader strategic driver of velocity." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784282346970_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784282346970_3> ] ;
