    narr:generatedFrom "b69b88f1086f8a6dd05b81d5914860d63b98cfb4" ;
    narr:narration """This hub concerns the product thesis that [decision capture at the point of consensus](narr:Position_CoreFeatureDecisionCapture) is the primary differentiator — capturing the artifact at the moment it's made, not reconstructed after. Against that framing, a Sprint 4 delivery cluster dated July 2026 reports concrete outcomes: [the async decision widget shipped](narr:Expr_1E2ETanyaCollab1784455139410_1), [velocity reached 23 points, highest this quarter](narr:Expr_1E2ETanyaCollab1784455139410_2), and [the Zephyr integration named as the key unlock](narr:Expr_1E2ETanyaCollab1784455139410_3). The [Sprint 4 delivery outcomes frame](narr:Position_Sprint4DeliveryOutcomes) holds the broader question of what was delivered and what enabled it. The hub thus spans both the foundational positioning claim (Mar 2026) and the execution evidence (Jul 2026), but the relationship between them — whether the sprint results validate, complicate, or simply instantiate the core thesis — is not resolved here.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_3> ;
    narr:covers <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4DeliveryOutcomes> ;
    narr:keyPhrase [ narr:text "decision capture at the point of consensus" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "capturing the decision artifact at the moment it's made" ; narr:phraseSource <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_3> ] ;
    narr:variation [ narr:text "The core differentiator claim is a positional assertion (Mar 2026) without execution evidence attached; the sprint results are attributed to a single actor (TanyaTeamowner) and may reflect one vantage on what the delivery meant, not a shared account." ; narr:over <https://aswritten.ai/narrative#Position_CoreFeatureDecisionCapture> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_1> ] ;
    narr:variation [ narr:text "Zephyr integration is named as the enabling factor, but the Sprint 4 delivery-outcomes node frames the question of enablement as still open — these two children offer competing or at least unresolved accounts of what drove the result." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784455139410_3> ; narr:over <https://aswritten.ai/narrative#Position_Sprint4DeliveryOutcomes> ] ;
    narr:writer "anthropic/claude-sonnet-4.6" .
