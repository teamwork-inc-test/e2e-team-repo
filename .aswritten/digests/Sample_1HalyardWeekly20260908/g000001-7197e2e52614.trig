    narr:keyPhrase [ narr:text "We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:keyPhrase [ narr:text "reporting does not touch the live system during a cutover window, full stop." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "we take ownership on the day Clyde goes green and not a day earlier." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "It's one site, one season." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:variation [ narr:text "Xavier's counter-case for pairing the two sites that share a dispatch desk — the desk supervisor's complaint since June — is answered but not dissolved." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ] ;
    narr:variation [ narr:text "The two-week soak rests on a single pilot's exception curve; Xavier flags the thin evidence, Tina accepts and holds anyway." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ] ;
    narr:variation [ narr:text "Clyde is named as the site nobody wants to touch, left unresolved in the call." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_5> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority exercised through sequencing and pressure, softened by inviting consultation" ; narr:text "Hold those for ten minutes. Sequencing first." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_4> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decisions stated as immovable, defended with claims rather than reopened" ; narr:text "Then let me say where I've landed, because I don't think I'm going to move off it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete future-irrealis framing — rules stated as what will and won't happen" ; narr:text "guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking default, with market-pricing reasoning when trading off risk" ; narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation — containing known pain over accepting unbounded risk" ; narr:text "Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "activated-negative under reporting pressure, controlled in tone" ; narr:text "I've given them \"we're still working it\" twice now." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual open, plain-spoken when ruling" ; narr:text "Morning, both. Let's keep this one tight" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
