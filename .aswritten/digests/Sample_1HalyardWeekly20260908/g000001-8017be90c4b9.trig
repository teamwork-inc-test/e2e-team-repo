    narr:keyPhrase [ narr:text "We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one. No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "The soak is two full weeks. That's the Dockside number, and I'd hold us to it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_17> ] ;
    narr:keyPhrase [ narr:text "during cutover, every reporting read comes off the replica" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_26> ] ;
    narr:keyPhrase [ narr:text "a four-minute-stale number is fine and an outage is not" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:keyPhrase [ narr:text "The vendor stays the system of record for reference data until the last site is live." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "I'll note that the exception curve is the only evidence we have for it. It's one site, one season." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ] ;
    narr:variation [ narr:text "Xavier's pushback on sequencing — the shared dispatch desk argues for pairing two sites, against the one-at-a-time mainline" ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ] ;
    narr:variation [ narr:text "The two-week soak rests on a single site's exception curve — thin evidence, acknowledged but accepted" ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_21> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_22> ] ;
    narr:variation [ narr:text "The replica rule carries a real cost — up to four minutes of stale reporting — explicitly weighed rather than dismissed" ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_28> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first with parallelism — the sentence names what it isn't, then balances the pair" ; narr:text "Running two systems at one desk for a few weeks is a known, contained pain with a named owner. Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claims that harden into decisions once tested — she invites the pushback before firming" ; narr:text "Then let me say where I've landed, because I don't think I'm going to move off it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority exercised through sequencing control and pressure, softened by consultation" ; narr:text "Hold those for ten minutes. Sequencing first." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_4> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking as the default, with market-pricing when she's trading off costs" ; narr:text "Xavier, write it into the runbook as a rule and not as guidance, because guidance gets negotiated at three a.m." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_31> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and future-facing under pressure, abstract when reasoning through trades" ; narr:text "the steering group asks again on Thursday and I've given them \"we're still working it\" twice now" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation — protecting against the unbounded loss over chasing the gain" ; narr:text "Keeping one source of truth through the whole programme is worth more than getting ownership early." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_38> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "activated-negative only at the opening — pressure shows as urgency, not heat" ; narr:text "Let's keep this one tight — I want to come out of it with the cutover shape actually decided" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "casual baseline that turns technical only when the expert material demands it" ; narr:text "Morning, both. Let's keep this one tight" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_1> ] ;
