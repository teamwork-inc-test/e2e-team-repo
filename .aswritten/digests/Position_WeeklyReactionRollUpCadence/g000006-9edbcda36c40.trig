    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_2> ] ;
    narr:keyPhrase [ narr:text "Tina asked whether the roll-up replaces the per-run bundle." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_3> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_4> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_5> ] ;
    narr:variation [ narr:text "The daily digest alternative is rejected again in this pass as it was in every prior one, kept on the graph as the road not taken." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ; narr:over <https://aswritten.ai/narrative#Expr_20261005_1_WeeklyRollUpRulingE2EAgenticSynthetic_h21bf84ec8b35_6> ; narr:over <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_5> ] ;
    narr:variation [ narr:text "Tina's scope question keeps resurfacing pass after pass, as if the clarification it answers never fully settles the ambiguity." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ; narr:over <https://aswritten.ai/narrative#Expr_20261005_1_WeeklyRollUpRulingE2EAgenticSynthetic_h21bf84ec8b35_4> ; narr:over <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_3> ] ;
