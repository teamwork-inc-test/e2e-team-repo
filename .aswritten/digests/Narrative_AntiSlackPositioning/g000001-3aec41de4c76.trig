    narr:generatedFrom "3aec41de4c768e83237662587b1c18839628b473" ;
    narr:narration """This hub tracks the [foundational positioning](narr:Position_ProductCategoryAsyncPlatform) of a product explicitly defined as a structured alternative to real-time chat tools like Slack. Established in March 2026, the [core anti-pattern](narr:Position_AntiPatternRealtimeChat) serves as the anchor for the [target market](narr:Position_TargetMarketRemoteTeams) of remote teams sized 10-50. While the [initial pricing](narr:Position_PricingTwelveDollars) was set at $12/user/month, subsequent internal reviews in late March 2026 introduced a tiered adjustment to $15 for larger teams. Recent performance data from August 2026 shifts the focus toward [tangible shipping outcomes](narr:Expr_1E2ETanyaCollab1787218258797_1), specifically highlighting the [Zephyr integration](narr:Expr_1E2ETanyaCollab1787218258797_3) as a critical driver for [record velocity](narr:Expr_1E2ETanyaCollab1787218258797_2). The current discourse explores the causal relationship between these technical unlocks and the team's [sprint-level productivity](narr:Position_SprintFourVelocityAttribution).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787218258797_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787218258797_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787218258797_3> ;
    narr:covers <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ;
    narr:covers <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ;
    narr:covers <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ;
    narr:covers <https://aswritten.ai/narrative#Position_SprintFourVelocityAttribution> ;
    narr:covers <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ;
    narr:keyPhrase [ narr:text "Structured async decision platform" ; narr:phraseSource <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787218258797_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787218258797_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787218258797_3> ] ;
    narr:keyPhrase [ narr:text "Pricing set at $12/user/month" ; narr:phraseSource <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:variation [ narr:text "Pricing tension exists between the initial $12 flat rate and the later $15 tier for teams over 25." ; narr:over <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:variation [ narr:text "The causal attribution of velocity gains to the Zephyr integration is currently being framed as a question rather than a settled fact." ; narr:over <https://aswritten.ai/narrative#Position_SprintFourVelocityAttribution> ] ;
