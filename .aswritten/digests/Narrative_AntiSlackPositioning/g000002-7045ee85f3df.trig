GRAPH <https://aswritten.ai/narrative#Digest_Narrative_AntiSlackPositioning> {
  <https://aswritten.ai/narrative#Digest_Narrative_AntiSlackPositioning> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_AntiSlackPositioning> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "7045ee85f3df6e95a3654a6b0a78014bfbf728c8" ;
    narr:narration """This hub tracks the [anti-Slack positioning thesis](narr:Position_AntiPatternRealtimeChat), which defines the product against real-time chat tools to establish a [structured async decision platform](narr:Position_ProductCategoryAsyncPlatform). The strategy centers on [remote teams of 10-50](narr:Position_TargetMarketRemoteTeams) as the primary ICP, balancing speed with the friction of decision-loss. While [initial pricing was set at $12/user/month](narr:Position_PricingTwelveDollars), the model quickly introduced a tiered adjustment to $15 for larger teams by late March. By August, the narrative shifted from categorical assertion to empirical validation, where [delivery velocity is now framed as the primary evidence](narr:Narrative_ThesisProvenByVelocity) for the thesis's viability in practice.""" ;
    narr:covers <https://aswritten.ai/narrative#Narrative_ThesisProvenByVelocity> ;
    narr:covers <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ;
    narr:covers <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ;
    narr:covers <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ;
    narr:covers <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ;
    narr:keyPhrase [ narr:text "Structured async decision platform" ; narr:phraseSource <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ] ;
    narr:keyPhrase [ narr:text "remote teams with 10-50 people" ; narr:phraseSource <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ] ;
    narr:keyPhrase [ narr:text "Delivery velocity becomes the thesis's evidence, not just a metric" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_ThesisProvenByVelocity> ] ;
    narr:keyPhrase [ narr:text "pricing update to $15/user for teams over 25" ; narr:phraseSource <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:variation [ narr:text "The shift from flat pricing to tiered pricing suggests a tension between simplicity and revenue capture for larger teams." ; narr:over <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:variation [ narr:text "The move to use velocity as evidence risks conflating product-market fit with internal operational efficiency." ; narr:over <https://aswritten.ai/narrative#Narrative_ThesisProvenByVelocity> ] ;
    narr:writer "google/gemini-3.1-flash-lite" .
}