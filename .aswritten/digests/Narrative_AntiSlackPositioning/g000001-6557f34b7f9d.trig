    narr:generatedFrom "6557f34b7f9d57227c05729882bfdc19ebd3356d" ;
    narr:narration """This hub tracks the [foundational anti-Slack positioning](narr:Position_AntiPatternRealtimeChat) established in March 2026, which defines the product as a [structured async decision platform](narr:Position_ProductCategoryAsyncPlatform). The initial strategy targeted [remote teams of 10-50 people](narr:Position_TargetMarketRemoteTeams) with a [base pricing model of $12/user/month](narr:Position_PricingTwelveDollars), though this was later qualified by a [sprint-based pricing adjustment](narr:Position_PricingTwelveDollars) for larger teams. By August 2026, the narrative shifted toward validating this thesis through operational performance. Recent evidence centers on [shipping the async decision widget](narr:Expr_1E2ETanyaCollab1787304815568_1) and achieving [peak velocity](narr:Expr_1E2ETanyaCollab1787304815568_2), with the [Zephyr integration](narr:Expr_1E2ETanyaCollab1787304815568_3) cited as the critical technical unlock. The current trajectory [frames these delivery outcomes](narr:Position_Sprint4DeliveryAsThesisEvidence) as empirical support for the original decision-capture thesis.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787304815568_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787304815568_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787304815568_3> ;
    narr:covers <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ;
    narr:covers <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ;
    narr:covers <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4DeliveryAsThesisEvidence> ;
    narr:covers <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ;
    narr:keyPhrase [ narr:text "Structured async decision platform" ; narr:phraseSource <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787304815568_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787304815568_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787304815568_3> ] ;
    narr:variation [ narr:text "Pricing is not static; it evolved from a flat $12 rate to a tiered $15 model for larger teams." ; narr:over <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:variation [ narr:text "The focus on velocity and technical integration (Zephyr) may diverge from the purely qualitative 'async-first' product philosophy." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787304815568_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1787304815568_3> ; narr:over <https://aswritten.ai/narrative#Position_Sprint4DeliveryAsThesisEvidence> ] ;
