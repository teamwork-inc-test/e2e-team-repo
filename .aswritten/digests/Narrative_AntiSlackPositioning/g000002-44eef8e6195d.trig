    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786700689257_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786700689257_3> ;
    narr:covers <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ;
    narr:covers <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ;
    narr:covers <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4DeliveryEvidence> ;
    narr:covers <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ;
    narr:keyPhrase [ narr:text "Structured async decision platform" ; narr:phraseSource <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786700689257_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786700689257_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1786700689257_3> ] ;
    narr:variation [ narr:text "Pricing tension: Initial $12/user vision vs. $15/user for teams over 25." ; narr:over <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
