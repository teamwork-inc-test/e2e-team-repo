    narr:childCount "8"^^xsd:integer ;
    narr:generatedFrom "35e59f6ff7e09f75759bfef532cd9b12bbd4299e" ;
    narr:narration """This hub tracks the [foundational anti-Slack positioning](narr:Position_AntiPatternRealtimeChat) established in March 2026, which defines the product as a [structured async decision platform](narr:Position_ProductCategoryAsyncPlatform). The initial strategy targeted [remote teams of 10-50](narr:Position_TargetMarketRemoteTeams), with pricing [initially set at $12/user](narr:Position_PricingTwelveDollars) before a March 2026 revision introduced a $15 tier for larger teams. By August 2026, the narrative shifted toward validating this thesis through [sprint-level delivery milestones](narr:Position_Sprint4SuccessEvidence). Recent updates emphasize technical execution, specifically the [shipment of an async decision widget](narr:Expr_1E2ETanyaCollab1785753518766_1) and the [Zephyr integration](narr:Expr_1E2ETanyaCollab1785753518766_3), which are framed as the primary drivers of [increased team velocity](narr:Expr_1E2ETanyaCollab1785753518766_2).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785753518766_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785753518766_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785753518766_3> ;
    narr:covers <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ;
    narr:covers <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ;
    narr:covers <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4SuccessEvidence> ;
    narr:covers <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ;
    narr:keyPhrase [ narr:text "Real-time chat (Slack, Teams) is the named anti-pattern." ; narr:phraseSource <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ] ;
    narr:keyPhrase [ narr:text "Structured async decision platform" ; narr:phraseSource <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ] ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785753518766_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785753518766_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785753518766_3> ] ;
    narr:variation [ narr:text "Pricing strategy bifurcated from a flat $12 rate to a $15/user tier for teams over 25." ; narr:over <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:variation [ narr:text "The focus on 'velocity' metrics in August contrasts with the earlier, qualitative focus on 'decision-loss pain'." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1785753518766_2> ; narr:over <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ] ;
