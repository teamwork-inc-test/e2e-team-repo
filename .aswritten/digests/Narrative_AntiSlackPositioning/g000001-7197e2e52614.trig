@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_Narrative_AntiSlackPositioning> {
  <https://aswritten.ai/narrative#Digest_Narrative_AntiSlackPositioning> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_AntiSlackPositioning> ;
    narr:childCount "4"^^xsd:integer ;
    narr:generatedFrom "7197e2e5261482e8ab862a8aa0f16ad8ffe0fb2f" ;
    narr:narration """This narrative defines the product by opposition and category creation. The named anti-pattern is [real-time chat tools like Slack and Teams](narr:Position_AntiPatternRealtimeChat), against which the product stakes out a [deliberately created category: structured async decision platform](narr:Position_ProductCategoryAsyncPlatform). The initial go-to-market frame targets [remote teams of 10-50 people as the ICP](narr:Position_TargetMarketRemoteTeams), sized to feel decision-loss pain. Pricing was set at [$12/user/month](narr:Position_PricingTwelveDollars) at the [2026-03-10](narr:Position_PricingTwelveDollars) vision session, with a later retro recording a team-tier update — the trajectory runs from category definition through market sizing to price, all dated to the same vision session.""" ;
    narr:covers <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ;
    narr:covers <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ;
    narr:covers <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ;
    narr:covers <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ;
    narr:keyPhrase [ narr:text "Pricing set at $12/user/month as of 2026-03-10 product vision session" ; narr:phraseSource <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:keyPhrase [ narr:text "Sprint 4 retro (2026-03-22) records a pricing update to $15/user for teams over 25" ; narr:phraseSource <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:keyPhrase [ narr:text "Structured async decision platform" ; narr:phraseSource <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ] ;
    narr:keyPhrase [ narr:text "Target market: remote teams with 10-50 people" ; narr:phraseSource <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ] ;
    narr:keyPhrase [ narr:text "Real-time chat (Slack, Teams) is the named anti-pattern" ; narr:phraseSource <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ] ;
    narr:variation [ narr:text "Pricing is not settled: the $12/user anchor from the vision session was updated twelve days later to $15/user for teams over 25 at the Sprint 4 retro." ; narr:over <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}