    narr:keyPhrase [ narr:text "Four sites off a vendor platform. One site at a time, a soak between each one before the next starts, reporting off a replica during the cutover windows, vendor keeps reference data until the last site is live." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_3> ] ;
    narr:keyPhrase [ narr:text "The two that went big-bang both went backwards — not failed, went backwards, six months of unpicking. The one that went sequentially was boring and finished." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_5> ] ;
    narr:keyPhrase [ narr:text "A validation step tells you the data moved. It doesn't tell you the data was any good before it moved." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_15> ] ;
    narr:keyPhrase [ narr:text "somebody who isn't the programme manager owns the gate, because the programme manager has a date." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_17> ] ;
    narr:keyPhrase [ narr:text "the gate costs you a site's worth of delay at least once, and if it never fires you set the bar too low." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_21> ] ;
    narr:keyPhrase [ narr:text "Bring them a hole you've named. They'll forgive a hole. They won't forgive finding one." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_29> ] ;
    narr:variation [ narr:text "Distinguishing technical transport verification from pre-cutover source data quality thresholds" ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_14> ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_15> ] ;
    narr:variation [ narr:text "Separating gate enforcement authority from programme delivery ownership to prevent schedule-driven compromise" ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_17> ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_19> ] ;
