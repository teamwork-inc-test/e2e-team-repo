    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_6> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_9> ;
    narr:keyPhrase [ narr:text "I'll be blunt where I can be useful and quiet where I can't." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_2> ] ;
    narr:keyPhrase [ narr:text "The two that went big-bang both went backwards — not failed, went backwards, six months of unpicking." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_5> ] ;
    narr:keyPhrase [ narr:text "A validation step tells you the data moved. It doesn't tell you the data was any good before it moved." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_15> ] ;
    narr:keyPhrase [ narr:text "somebody who isn't the programme manager owns the gate, because the programme manager has a date" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_17> ] ;
    narr:keyPhrase [ narr:text "If it never stops anything, it isn't a gate." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_23> ] ;
    narr:keyPhrase [ narr:text "They'll forgive a hole. They won't forgive finding one." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_29> ] ;
    narr:variation [ narr:text "The requester's pushback that [a migration validation step already exists](narr:Expr_6HalyardAdvisorTonyMaley20260929_14) is the one point of resistance, resolved only by the advisor's distinction between movement and quality." ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_14> ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_15> ] ;
    narr:variation [ narr:text "The endorsement is not unconditional: the reference-data support carries an explicit [unseen caveat on the mirror's refresh interval](narr:Expr_6HalyardAdvisorTonyMaley20260929_25)." ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_25> ] ;
    narr:variation [ narr:text "Pressure to collapse the sequence is already live inside the organisation, per the requester's own admission, so the settled sequencing is contested in practice." ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_7> ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_8> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
