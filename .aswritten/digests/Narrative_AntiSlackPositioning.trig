GRAPH <https://aswritten.ai/narrative#Digest_Narrative_AntiSlackPositioning> {
  <https://aswritten.ai/narrative#Digest_Narrative_AntiSlackPositioning> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_AntiSlackPositioning> ;
    narr:childCount "8"^^xsd:integer ;
    narr:generatedFrom "c842ebf2d3d8b5d16fa1389af6575d3b5d960e48" ;
    narr:narration """This hub gathers the product's anti-Slack positioning, rooted in a March 2026 vision session that named [real-time chat as the anti-pattern](narr:Position_AntiPatternRealtimeChat) and defined the product as a [structured async decision platform](narr:Position_ProductCategoryAsyncPlatform) — a deliberate category-creation move against Slack and Teams. The initial go-to-market frame set a [target of remote teams with 10–50 people](narr:Position_TargetMarketRemoteTeams) and [pricing at $12/user/month](narr:Position_PricingTwelveDollars). By July 2026, Sprint 4 delivery evidence is recruited to substantiate the thesis: [Tanya reports shipping the async decision widget](narr:Expr_1E2ETanyaCollab1784543275763_1), [velocity at 23 points — highest that quarter](narr:Expr_1E2ETanyaCollab1784543275763_2), and [the Zephyr integration as the key unlock](narr:Expr_1E2ETanyaCollab1784543275763_3). A [Sprint 4 delivery-proof frame](narr:Position_Sprint4DeliveryProof) explicitly asks what the sprint demonstrates about the anti-Slack thesis, leaving the connection as an open question rather than a settled claim. The pricing note carries an internal update to $15/user for teams over 25, recorded at the Sprint 4 retro, that the positioning children do not yet reflect.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_3> ;
    narr:covers <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ;
    narr:covers <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ;
    narr:covers <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ;
    narr:covers <https://aswritten.ai/narrative#Position_Sprint4DeliveryProof> ;
    narr:covers <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ;
    narr:keyPhrase [ narr:text "We shipped the async decision widget." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_1> ] ;
    narr:keyPhrase [ narr:text "Velocity was 23 points, highest this quarter." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_2> ] ;
    narr:keyPhrase [ narr:text "The Zephyr integration was the key unlock." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_3> ] ;
    narr:keyPhrase [ narr:text "Real-time chat (Slack, Teams) is the named anti-pattern." ; narr:phraseSource <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ] ;
    narr:keyPhrase [ narr:text "Pricing set at $12/user/month" ; narr:phraseSource <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:keyPhrase [ narr:text "Structured async decision platform" ; narr:phraseSource <https://aswritten.ai/narrative#Position_ProductCategoryAsyncPlatform> ] ;
    narr:keyPhrase [ narr:text "remote teams with 10-50 people" ; narr:phraseSource <https://aswritten.ai/narrative#Position_TargetMarketRemoteTeams> ] ;
    narr:variation [ narr:text "Pricing drifted from $12 to $15/user for teams over 25 at the Sprint 4 retro, but no child updates the positioning to absorb the change." ; narr:over <https://aswritten.ai/narrative#Position_PricingTwelveDollars> ] ;
    narr:variation [ narr:text "The Sprint 4 delivery-proof frame poses the anti-Slack connection as an open question rather than asserting it — execution evidence is gathered but the link is not claimed." ; narr:over <https://aswritten.ai/narrative#Position_Sprint4DeliveryProof> ] ;
    narr:variation [ narr:text "The July delivery claims (widget shipped, velocity 23, Zephyr integration) are competence and execution narratives; they support the hub by proving the product exists, not by arguing against chat directly." ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_1> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_2> ; narr:over <https://aswritten.ai/narrative#Expr_1E2ETanyaCollab1784543275763_3> ] ;
    narr:writer "z-ai/glm-5.2" .
