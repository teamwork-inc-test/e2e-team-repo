    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ;
    narr:keyPhrase [ narr:text "We do not keep the legacy platform alive as a read-only system." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:keyPhrase [ narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:keyPhrase [ narr:text "Legal says seven years from the record date for the consignment data." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:keyPhrase [ narr:text "An archive that is obviously an archive kills that." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ] ;
    narr:keyPhrase [ narr:text "Mine is about decay. Yours is about behaviour." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:keyPhrase [ narr:text "Give me until the end of next week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_28> ] ;
    narr:variation [ narr:text "The road not taken — keeping the vendor's platform running as a paid read-only system — was raised and argued against as expensive and fragile, not dismissed unheard." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_6> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ] ;
    narr:variation [ narr:text "Two distinct justifications for the archive coexist: Xavier's decay argument and Tanya's behavioural argument against dual systems of record — both explicitly kept in the note." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:variation [ narr:text "The retention number beyond legal's seven-year baseline is deliberately left open, deferred to legal in writing rather than decided in the room." ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "moves from notion to firm claim to recorded decision within one conversation — positions are held firmly once argued" ; narr:text "Then here's the view I'd take, and I'd take it firmly." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority exercised through consultation and persuasion rather than command" ; narr:text "Xavier, can you scope the extraction enough that I can put a number in front of the vendor?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_27> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated when framing problems, abstract when naming the principle underneath" ; narr:text "Cost and effort now, against a risk that lands years from now on someone who isn't in this room." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_15> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — sentences define by contrast and balance" ; narr:text "It's the only part that matters in year eight. The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and conservation — the durable, readable artefact over the convenient one" ; narr:text "Flat files, an open format, a schema next to them, and a written description of what a \"consignment status of 7\" actually meant in 2017" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_11> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "communal-sharing in the room, market-pricing when weighing the argument, authority-ranking when assigning work" ; narr:text "I'd rather we form a view than have one handed to us." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_1> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
