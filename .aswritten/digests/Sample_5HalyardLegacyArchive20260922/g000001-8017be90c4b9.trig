    narr:keyPhrase [ narr:text "We do not keep the legacy platform alive as a read-only system. We extract the closed history into a flat, self-describing archive" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:keyPhrase [ narr:text "The data is easy to keep. The meaning is what rots." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ] ;
    narr:keyPhrase [ narr:text "a live legacy platform is a thing people will keep using" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ] ;
    narr:keyPhrase [ narr:text "Legal says seven years from the record date for the consignment data" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:keyPhrase [ narr:text "the retention period comes from legal in writing before we sign anything with the vendor about decommissioning" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_22> ] ;
    narr:keyPhrase [ narr:text "Give me until the end of next week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_28> ] ;
    narr:variation [ narr:text "Tina's initial assumption — keep paying the vendor to leave it running — is the road not taken, named and argued against rather than dismissed" ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_6> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ] ;
    narr:variation [ narr:text "Xavier's own counter-argument (cost now vs. deferred risk) is left standing as the reason this never gets done" ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_15> ] ;
    narr:variation [ narr:text "Two different justifications compete: Xavier's decay argument vs. Tanya's behavioural argument, with Xavier conceding hers is stronger" ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_13> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_16> ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:variation [ narr:text "The claims-relevant retention number is deliberately left undecided, deferred to legal in writing" ; narr:over <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_20> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence turns on a contrast, often in matched pairs" ; narr:text "Mine is about decay. Yours is about behaviour." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "moves from notion to claim to firm decision across the arc — positions stated as claims, then ratified as decisions" ; narr:text "Then here's the view I'd take, and I'd take it firmly." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_9> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority exercised through consultation, not command" ; narr:text "Xavier, can you scope the extraction enough that I can put a number in front of the vendor?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_27> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated where it matters, abstract only when naming principles" ; narr:text "you find out the day someone needs a consignment record from 2019 for a claim" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_7> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence and conservation — the argument is about what survives, not what wins" ; narr:text "Flat files, an open format, a schema next to them" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_11> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "shifts by role: communal-sharing in the opening, market-pricing in the cost argument, authority-ranking when assigning work" ; narr:text "I'd rather we form a view than have one handed to us." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_1> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "plain-spoken with technical precision; formal only when stating the final position" ; narr:text "Meaning you can read it in ten years with nothing but the files." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_11> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive throughout — agreement and concession without heat" ; narr:text "That's a better argument than mine, actually." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5HalyardLegacyArchive20260922_17> ] ;
