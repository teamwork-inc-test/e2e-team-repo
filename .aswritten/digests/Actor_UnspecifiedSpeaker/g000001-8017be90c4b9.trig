    narr:covers <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_8> ;
    narr:keyPhrase [ narr:text "how is the minimum soak duration between site cutovers determined and validated?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_3> ] ;
    narr:keyPhrase [ narr:text "One week is defensible but it has no slack in it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_4> ] ;
    narr:keyPhrase [ narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_5> ] ;
    narr:keyPhrase [ narr:text "the new number is tight, not safe" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_6> ] ;
    narr:keyPhrase [ narr:text "That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_8> ] ;
    narr:variation [ narr:text "Agrees with the correction while insisting its cost be on the record — acceptance and reservation held together, not resolved." ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_4> ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_6> ] ;
    narr:variation [ narr:text "The retraction is unqualified self-correction, in tension with the qualified acceptance elsewhere in the same session." ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_8> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "escalates from hedged notion to flat decision within one exchange — the retraction is stated as final" ; narr:text "That was wrong. I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_8> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-realis when fixing the record, abstract-present when reasoning about it" ; narr:text "the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_7> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence over comfort — defensibility preferred to unexamined caution" ; narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_5> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what it isn't" ; narr:text "the new number is tight, not safe." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_6> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "claims legitimate authority to strike and supersede, not to persuade" ; narr:text "I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_8> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "shifts formal for the record-setting moves" ; narr:text "For the record then: the soak between sites is one week, not two" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_7> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "prices the tradeoff in market terms, then ranks it against their own prior authority" ; narr:text "Two weeks was conservative in a place where being conservative was cheap." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_ReviewCommentsTinaTeammember20260924_h1feabda3f4e2_4> ] ;
