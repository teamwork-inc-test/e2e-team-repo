GRAPH <https://aswritten.ai/narrative#Digest_Narrative_ReactionDeliveryBundling> {
  <https://aswritten.ai/narrative#Digest_Narrative_ReactionDeliveryBundling> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_ReactionDeliveryBundling> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "9bef05300088f1f7e37ba41177a383ed5d568268" ;
    narr:narration """This narrative holds a single settled ruling on reaction delivery: [one bundle per run per person rather than one message per skill](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_2), voiced as a person should get one thing to read, not four. The [boundary rule that a bundle closes when the run closes](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_3) was held against pushback on the batching window — a skill missing the close waits for the next run. The [rejected alternative of per-skill delivery with client-side collapsing](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_4) is recorded as moving the ordering problem onto the reader, with [the same rejection rationale stated separately](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_5). The [framing position on where bundling and batching windows should be bounded](narr:Position_ReactionDeliveryBundlingAndBatchingBoundary) anchors the whole arc.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ;
    narr:covers <https://aswritten.ai/narrative#Position_ReactionDeliveryBundlingAndBatchingBoundary> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "The batching window was contested — pushback on the close boundary was voiced and held, not resolved by consensus" ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:variation [ narr:text "A rejected alternative (per-skill delivery with client-side collapsing) remains on record as the road not taken" ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-plus-parallelism — the ruling states what it is by naming what it is not, in matched halves" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "plain-spoken when ruling, technical when dissecting the rejected alternative" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking — pushback is met and held rather than negotiated" ; narr:text "Tina pushed back on the batching window" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
