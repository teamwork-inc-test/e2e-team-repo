    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ;
    narr:covers <https://aswritten.ai/narrative#Position_ReactionDeliveryBundlingAndBatchingBoundary> ;
    narr:covers <https://aswritten.ai/narrative#Position_WeeklyReactionRollUpCadence> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:keyPhrase [ narr:text "the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ] ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "Tina pushed back on the batching window; the held answer is that a late skill waits for the next run rather than sending on its own." ; narr:over <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4> ] ;
    narr:variation [ narr:text "The rejected alternative — per-skill delivery with client-side collapsing — remains recorded as the road not taken, on the grounds that it moves the ordering problem onto the reader." ; narr:over <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "Tina's question of whether the Friday roll-up replaces the per-run bundle was answered as scope-split, not replacement — the bundle is for the run, the roll-up for the week." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:variation [ narr:text "A daily digest was also considered and rejected as redundant with the bundle on most single-run days." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:run "b2c1ddde485c" ;
    narr:moved "true"^^xsd:boolean ;
    narr:previousGeneration ".aswritten/digests/Narrative_ReactionDeliveryBundling/g000016-58cc29f7de68.trig" ;
    narr:sentences (
      [ narr:op "kept" ; narr:text """This narrative records a team-owner ruling on reaction delivery, re-recorded across six dated passes and extended once.""" ]
      [ narr:op "kept" ; narr:text """[The framing of where reaction delivery belongs](narr:Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_1) grounds [the directive that every reaction routes through one bundle per run per person, not one message per skill](narr:Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2), held under [pushback on the batching window, answered by the rule that a bundle closes when the run closes and a late skill waits for the next run](narr:Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3), with [per-skill delivery with client-side collapsing rejected as moving the ordering problem onto the reader](narr:Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4) — [that rejection also stated separately](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_5).""" ]
      [ narr:op "kept" ; narr:text """Earlier passes re-record the same arc as [framing](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_1), [directive](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_2), [pushback exchange](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_3), and [rejected alternative](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_4); a second pass as [framing](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_1), [directive](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2), [pushback](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3), and [alternative](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4); a third as [framing](narr:Expr_20260924_2_DeliveryRoutingRulingE2ESyntheticAttempt2_haec961429483_1), [directive](narr:Expr_20260924_2_DeliveryRoutingRulingE2ESyntheticAttempt2_haec961429483_2), [pushback](narr:Expr_20260924_2_DeliveryRoutingRulingE2ESyntheticAttempt2_haec961429483_3), and [alternative](narr:Expr_20260924_2_DeliveryRoutingRulingE2ESyntheticAttempt2_haec961429483_4); a fourth as [framing](narr:Expr_20260926_1_DeliveryRoutingRulingE2ESynthetic_ha66ee8b3c008_1), [directive](narr:Expr_20260926_1_DeliveryRoutingRulingE2ESynthetic_ha66ee8b3c008_2), [pushback](narr:Expr_20260926_1_DeliveryRoutingRulingE2ESynthetic_ha66ee8b3c008_3), and [alternative](narr:Expr_20260926_1_DeliveryRoutingRulingE2ESynthetic_ha66ee8b3c008_4); and a fifth as [framing](narr:Expr_20260928_1_DeliveryRoutingRulingE2ESynthetic_h801a6165fef3_1), [directive](narr:Expr_20260928_1_DeliveryRoutingRulingE2ESynthetic_h801a6165fef3_2), [pushback](narr:Expr_20260928_1_DeliveryRoutingRulingE2ESynthetic_h801a6165fef3_3), and [alternative](narr:Expr_20260928_1_DeliveryRoutingRulingE2ESynthetic_h801a6165fef3_4).""" ]
      [ narr:op "kept" ; narr:text """A second layer extends it: [the framing of how the week's reactions reach people](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_1) grounds [keeping the per-run bundle and adding one Friday roll-up of the week](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2), with [the reported question on whether the roll-up replaces the bundle](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3) answered by [the scope clarification that the bundle is for the run, the roll-up for the week](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4) and [the rejection of a daily digest as repeating the bundle word for word](narr:Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5); a later pass re-records that layer as [framing](narr:Expr_20260927_1_WeeklyRollUpRulingE2EAgenticSynthetic_hf65a0248bea8_1), [directive](narr:Expr_20260927_1_WeeklyRollUpRulingE2EAgenticSynthetic_hf65a0248bea8_2), [question](narr:Expr_20260927_1_WeeklyRollUpRulingE2EAgenticSynthetic_hf65a0248bea8_3), [clarification](narr:Expr_20260927_1_WeeklyRollUpRulingE2EAgenticSynthetic_hf65a0248bea8_4), and [rejection](narr:Expr_20260927_1_WeeklyRollUpRulingE2EAgenticSynthetic_hf65a0248bea8_5); and a sixth as [framing](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_1), [directive](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_2), [question](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_3), [clarification](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_4), and [rejection](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_5).""" ]
      [ narr:op "kept" ; narr:text """A seventh pass re-records the routing arc as [framing](narr:Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_2), [directive](narr:Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_3), [the reported pushback on the batching window](narr:Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4), [the held rule that the bundle closes when the run closes](narr:Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_5), and [the rejected per-skill alternative](narr:Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_6).""" ]
      [ narr:op "kept" ; narr:text """A further pass re-records the roll-up layer as [framing](narr:Expr_20261001_1_WeeklyRollUpRulingE2EAgenticSynthetic_ha7f40d1c5663_1), [directive](narr:Expr_20261001_1_WeeklyRollUpRulingE2EAgenticSynthetic_ha7f40d1c5663_2), [question](narr:Expr_20261001_1_WeeklyRollUpRulingE2EAgenticSynthetic_ha7f40d1c5663_3), [clarification](narr:Expr_20261001_1_WeeklyRollUpRulingE2EAgenticSynthetic_ha7f40d1c5663_4), and [rejection](narr:Expr_20261001_1_WeeklyRollUpRulingE2EAgenticSynthetic_ha7f40d1c5663_5).""" ]
      [ narr:op "added" ; narr:text """An eighth pass re-records the routing arc as [framing](narr:Expr_20261002_1_DeliveryRoutingRulingE2ESynthetic_h3a7c5d6c9593_1), [directive](narr:Expr_20261002_1_DeliveryRoutingRulingE2ESynthetic_h3a7c5d6c9593_2), [pushback](narr:Expr_20261002_1_DeliveryRoutingRulingE2ESynthetic_h3a7c5d6c9593_3), and [alternative](narr:Expr_20261002_1_DeliveryRoutingRulingE2ESynthetic_h3a7c5d6c9593_4).""" ]
      [ narr:op "kept" ; narr:text """The arc supports [the position on where bundling and batching windows should be bounded](narr:Position_ReactionDeliveryBundlingAndBatchingBoundary) and [the position on scheduling recurring reaction summaries alongside per-run bundles](narr:Position_WeeklyReactionRollUpCadence).""" ]
      [ narr:op "kept" ; narr:text """The register across the ruling quotes runs antithesis and parallelism — one thing to read, not four.""" ]
    ) ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}