    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ] ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:variation [ narr:text "Pushback on the batching window was raised and held against — a late skill waits for the next run rather than sending on its own." ; narr:over <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ] ;
    narr:variation [ narr:text "Per-skill delivery with client-side collapsing was considered and rejected as shifting the ordering problem onto the reader." ; narr:over <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "Whether the weekly roll-up replaces the per-run bundle was asked and answered no — the two operate at different scopes." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:variation [ narr:text "A daily digest was rejected on the ground that most days carry a single run and it would duplicate the bundle." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}