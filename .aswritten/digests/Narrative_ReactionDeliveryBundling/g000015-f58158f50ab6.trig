    narr:covers <https://aswritten.ai/narrative#Position_WeeklyReactionRollUpCadence> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ] ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "Tina's pushback on the batching window is recorded and answered, not resolved by argument — the ruling held by authority, and the pushback is preserved as the road questioned." ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4> ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_5> ] ;
    narr:variation [ narr:text "Two rejected alternatives remain on record — per-skill delivery with client-side collapsing, and a daily digest — either of which could be reached for again." ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_6> ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "The open question of whether the roll-up replaces the bundle was answered by scope-splitting, not by eliminating either channel." ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_4> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-region throughout — every ruling lands as a settled call, never hedged" ; narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority backed by rational-persuasion — she rules, then gives the reason" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking baseline with a communal-sharing note when the rule serves the team's reading load" ; narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "moves from concrete-past framing into abstract, forward-looking rule statements" ; narr:text "the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence names what it is not, then balances what it is" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "self-transcendence — the rationale is always the recipient's burden, never her own convenience" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ] ;
