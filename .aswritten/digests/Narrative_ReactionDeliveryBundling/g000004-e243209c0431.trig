GRAPH <https://aswritten.ai/narrative#Digest_Narrative_ReactionDeliveryBundling> {
  <https://aswritten.ai/narrative#Digest_Narrative_ReactionDeliveryBundling> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_ReactionDeliveryBundling> ;
    narr:childCount "6"^^xsd:integer ;
    narr:generatedFrom "e243209c0431ecc9aaa3e6c2064a4a3943e79c30" ;
    narr:narration """This narrative holds a settled ruling on reaction delivery: [one bundle per run per person rather than one message per skill](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_2), voiced as a person should get one thing to read, not four. The [boundary rule that a bundle closes when the run closes](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_3) was held against pushback on the batching window — a skill missing the close waits for the next run. The [rejected alternative of per-skill delivery with client-side collapsing](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_4) is recorded as moving the ordering problem onto the reader, with [the same rejection rationale stated separately](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_5). The arc opens with [the framing of where reaction delivery belongs](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_1) and is anchored by [the position on where bundling and batching windows should be bounded](narr:Position_ReactionDeliveryBundlingAndBatchingBoundary).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ;
    narr:covers <https://aswritten.ai/narrative#Position_ReactionDeliveryBundlingAndBatchingBoundary> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:keyPhrase [ narr:text "Tanya (team owner) ruled on where reaction delivery belongs:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:variation [ narr:text "Pushback on the batching window — the tension over whether a late skill should send on its own or wait for the next run, held by the ruling." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:variation [ narr:text "The rejected road not taken: per-skill delivery with client-side collapsing, recorded with its rejection rationale rather than erased." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}