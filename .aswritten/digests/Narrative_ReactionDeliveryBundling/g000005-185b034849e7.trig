    narr:generatedFrom "185b034849e7d34e4de901fb011c25159c650d14" ;
    narr:narration """This narrative carries a settled ruling on reaction delivery, issued by the team owner: [the directive that every reaction routes through one bundle per run per person, not one message per skill](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_2), grounded in [the framing of where reaction delivery belongs](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_1). The ruling was held under pressure — [Tina's pushback on the batching window, answered by the rule that a bundle closes when the run closes and a late skill waits for the next run](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_3). The [rejected alternative of per-skill delivery with client-side collapsing](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_4) is recorded with [the same rejection rationale stated separately](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_5). A second pass re-records the arc — [the framing](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_1), [the directive](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2), [the pushback exchange](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3), and [the rejected alternative](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4) — all dated to the same ruling day. The whole arc supports [the position on where bundling and batching windows should be bounded](narr:Position_ReactionDeliveryBundlingAndBatchingBoundary).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ;
    narr:covers <https://aswritten.ai/narrative#Position_ReactionDeliveryBundlingAndBatchingBoundary> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:keyPhrase [ narr:text "Tanya (team owner) ruled on where reaction delivery belongs:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:variation [ narr:text "The batching window was contested — pushback on when a bundle closes, answered by the run-close boundary rather than conceded" ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ; narr:over <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ] ;
    narr:variation [ narr:text "A rejected alternative remains on record: per-skill delivery with client-side collapsing, framed as shifting the ordering burden onto the reader" ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ; narr:over <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ] ;
