    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ;
    narr:covers <https://aswritten.ai/narrative#Position_ReactionDeliveryBundlingAndBatchingBoundary> ;
    narr:covers <https://aswritten.ai/narrative#Position_WeeklyReactionRollUpCadence> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ] ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "Tina's pushback on the batching window is recorded as contested and answered, not withdrawn — the held rule stands beside the objection in every pass." ; narr:over <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4> ] ;
    narr:variation [ narr:text "Two rejected alternatives remain on record as roads not taken: per-skill delivery with client-side collapsing, and a daily digest that would repeat the bundle word for word." ; narr:over <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "The open question of whether the roll-up replaces the bundle recurs in every roll-up pass, answered each time by the run/week scope split rather than resolved by a new ruling." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ; narr:over <https://aswritten.ai/narrative#Expr_20261003_1_WeeklyRollUpRulingE2EAgenticSynthetic_h1f5318ecf934_4> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the ruling sentence names what it is by naming what it is not, then balances the pair in parallel" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-conviction throughout — every load-bearing span is phrased as a settled ruling, never a hedge or a proposal" ; narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority carried plainly, with rational-persuasion as the justification mode when the rule needs a reason" ; narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking baseline, softening toward communal-sharing when the rule is framed as what 'we' do rather than what is decreed" ; narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-past when framing what was ruled, abstract-future when stating the rule itself — the rule always lives ahead of the moment" ; narr:text "Tina asked whether the roll-up replaces the per-run bundle." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ] ;
    narr:run "3e412d9ae345" ;
    narr:moved "true"^^xsd:boolean ;
