    narr:voiceTrait [ narr:dim "value" ; narr:reading "self-transcendence — the rationale centers the recipient's burden, not the system's" ; narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
