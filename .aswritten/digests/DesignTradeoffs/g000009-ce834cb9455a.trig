@prefix narr: <https://aswritten.ai/narrative#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

GRAPH <https://aswritten.ai/narrative#Digest_DesignTradeoffs> {
  <https://aswritten.ai/narrative#Digest_DesignTradeoffs> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#DesignTradeoffs> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "ce834cb9455a1a2763cbc8a410109d52b6381eaa" ;
    narr:narration """This region records a single, fully witnessed delivery-routing trade-off. The chosen approach is [one bundle per run per person rather than one message per skill](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_2), with the bundle's close condition stated as [the run closing, late skills waiting for the next run rather than sending on their own](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_4). The rejected alternative is kept expandable, not erased: [per-skill delivery with client-side collapsing, which moves the ordering problem onto the reader](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_5). The choice was contested in the record itself — [a pushback on the batching window, held against](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_3) — so the dissent is retrievable alongside the verdict. The parent frame states the aim as [shielding recipients from fragmentation](narr:Narrative_ReactionDeliveryBundling). All children date to the same ruling window, so this is one decision point, not an evolving arc.""" ;
    narr:reaction """Nothing moved: the new extraction landed on the same four children the prior digest already held, and the prior narration — the bundling verdict, the held pushback, the rejected client-collapsing alternative — still reads true. The only sharpening is that the dissent and the rejected alternative are now anchored as first-class variation entries rather than narrated asides.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_ReactionDeliveryBundling> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:keyPhrase [ narr:text "Reaction delivery bundles strictly per run per person to shield recipients from fragmentation" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_ReactionDeliveryBundling> ] ;
    narr:variation [ narr:text "The batching window was contested and the pushback stands in the record — the verdict was held against it, not reached by consensus." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:variation [ narr:text "The rejected per-skill-with-client-collapsing alternative remains expandable; it trades server-side simplicity for pushing the ordering burden onto the reader." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}