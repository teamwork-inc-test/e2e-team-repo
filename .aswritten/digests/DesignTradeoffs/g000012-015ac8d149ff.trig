    narr:generatedFrom "015ac8d149ff5357653f9309b2c5caed5c50ac87" ;
    narr:narration """This region holds a delivery-routing trade-off, all dated to a single ruling window, now joined by a newer cadence question. The chosen approach is [one bundle per run per person rather than one message per skill](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_2), with the bundle's close condition fixed as [the run closing, late skills waiting for the next run rather than sending on their own](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_4). The rejected alternative stays expandable: [per-skill delivery with client-side collapsing, which moves the ordering problem onto the reader](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_5). The choice was contested in the record itself — [a pushback on the batching window, held against](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_3) — so the dissent is retrievable beside the verdict. The parent frame states the aim as [shielding recipients from fragmentation](narr:Narrative_ReactionDeliveryBundling). A newer child opens a distinct question — [recurring reaction summaries scheduled across multi-day windows alongside per-run bundles](narr:Position_WeeklyReactionRollUpCadence) — extending the region from one decision point toward a cadence dimension.""" ;
    narr:reaction """Nothing moved for this hub: the children are the same set the prior digest covered, and re-narrating them yields the same arc — the per-run bundle ruling, the held pushback, the rejected alternative, and the open cadence question. The prior narration still holds as written.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ;
    narr:covers <https://aswritten.ai/narrative#Narrative_ReactionDeliveryBundling> ;
    narr:covers <https://aswritten.ai/narrative#Position_WeeklyReactionRollUpCadence> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:keyPhrase [ narr:text "Reaction delivery bundles strictly per run per person to shield recipients from fragmentation" ; narr:phraseSource <https://aswritten.ai/narrative#Narrative_ReactionDeliveryBundling> ] ;
    narr:variation [ narr:text "The batching window was contested in the record — a pushback on when the bundle closes was raised and held against, so the dissent sits beside the verdict." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:variation [ narr:text "The rejected alternative — per-skill delivery with client-side collapsing — remains expandable for anyone who would rather move the ordering problem to the reader." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "A newer cadence question — recurring multi-day reaction summaries alongside per-run bundles — is open, not resolved by the per-run ruling." ; narr:over <https://aswritten.ai/narrative#Position_WeeklyReactionRollUpCadence> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first with parallel phrasing — the sentence names what it is by naming what it is not" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "plain-spoken when ruling, technical when describing the rejected alternative" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "recipient-centered — the justification is framed as what the reader should experience" ; narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "abstract and future-leaning when ruling, concrete and past-tense when recounting the contest" ; narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
