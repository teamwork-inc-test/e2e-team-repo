    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_10> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_11> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_12> ;
    narr:keyPhrase [ narr:text "We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one. No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "Two cutovers in the same week means eight of eleven are on cutover duty" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ] ;
    narr:keyPhrase [ narr:text "I can't staff that. It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:keyPhrase [ narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:keyPhrase [ narr:text "The replica rule and the reference-data rule both assume one cutover window open at a time" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:keyPhrase [ narr:text "we never agreed a single-site pilot — the call settled on two sites in parallel" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ] ;
    narr:keyPhrase [ narr:text "this reads as though containment settled the sequencing; the call weighed it against local site friction and did not settle it" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
    narr:variation [ narr:text "The review record is split: an acceptance into this position sits beside a rejection claiming the original call was two sites in parallel, not a single-site pilot — the settled reading is itself contested." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_2> ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
    narr:variation [ narr:text "The counterweight that started the debate — pairing two sites sharing a dispatch desk — was never withdrawn, only outweighed; it remains the live alternative if staffing ever changes." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:variation [ narr:text "A later review separates the sequencing from a number attached to it: the sequencing is affirmed as unmoved while the soak figure is conceded wrong — the position is stable but not monolithic." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_10> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_11> ] ;
