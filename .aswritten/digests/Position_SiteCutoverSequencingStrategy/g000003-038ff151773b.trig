    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_17> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_6> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_9> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ;
    narr:keyPhrase [ narr:text "We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one. No parallel cutovers, not even for the two small ones." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "I can't staff that. It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:keyPhrase [ narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic. One site at a time is the only sequencing my rota can actually produce people for." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:keyPhrase [ narr:text "The replica rule and the reference-data rule both assume one cutover window open at a time" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:keyPhrase [ narr:text "we never agreed a single-site pilot — the call settled on two sites in parallel" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ] ;
    narr:keyPhrase [ narr:text "this reads as though containment settled the sequencing; the call weighed it against local site friction and did not settle it" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
    narr:variation [ narr:text "Review acts now dispute what the call actually settled: one rejection says the decision was two sites in parallel, never a single-site pilot, directly contradicting the one-at-a-time mainline." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_4> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:variation [ narr:text "A change request argues the digest-side framing overstates closure — containment was weighed against local site friction and the sequencing was not settled." ; narr:over <https://aswritten.ai/narrative#Expr_3ReviewEvents70102_3> ] ;
    narr:variation [ narr:text "The original counterweight — pairing two sites sharing a dispatch desk, on a grievance running since June — remains on record and was argued, not dismissed." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
