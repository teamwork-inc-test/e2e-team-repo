    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_16> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ;
