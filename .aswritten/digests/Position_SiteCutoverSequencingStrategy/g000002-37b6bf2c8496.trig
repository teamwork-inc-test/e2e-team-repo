    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_6> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_9> ;
    narr:keyPhrase [ narr:text "We do this one site at a time. A site goes live, it soaks, and only when that soak is clean do we start the next one." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_8> ] ;
    narr:keyPhrase [ narr:text "The argument for taking Northgate and Ferry Road together is that they share a dispatch desk." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ] ;
    narr:keyPhrase [ narr:text "Two cutovers landing in the same week is an unbounded one, and we've got nobody to hand it to." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_13> ] ;
    narr:keyPhrase [ narr:text "Two cutovers in the same week means eight of eleven are on cutover duty" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ] ;
    narr:keyPhrase [ narr:text "It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:keyPhrase [ narr:text "The replica rule and the reference-data rule both assume one cutover window open at a time" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:variation [ narr:text "The pairing case for the two desk-sharing sites remains live, grounded in a grievance running since June — rebutted but not withdrawn." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_12> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_15> ] ;
    narr:variation [ narr:text "The arguments are ranked, not merged: one participant calls the staffing count a hard constraint that outranks the risk and data-drift arguments — a hierarchy, not a consensus." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_15> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_16> ] ;
    narr:variation [ narr:text "The technical rules don't forbid parallel cutovers — they merely assume against it, and would need rewriting if the pairing case ever won." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
