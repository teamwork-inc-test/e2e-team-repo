GRAPH <https://aswritten.ai/narrative#Digest_Sample_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b> {
  <https://aswritten.ai/narrative#Digest_Sample_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Sample_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b> ;
    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "f58158f50ab61ca1389fbda1692db84740721302" ;
    narr:narration """The exchange opens with [a team owner framing the reaction delivery decision](https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_2) and establishing [a single-bundle routing policy per run](https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_3). Pushback emerges over [the proposed batching window timing](https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4), met by [a ruling that straggling skills hold for subsequent runs](https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_5), alongside [the explicit rejection of client-side message collapsing](https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_6).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_6> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_3> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4> ] ;
    narr:keyPhrase [ narr:text "the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_5> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_6> ] ;
    narr:variation [ narr:text "Dissent on whether late-finishing skills should wait for subsequent runs or send independently" ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4> ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_5> ] ;
    narr:variation [ narr:text "Rejected alternative of per-skill delivery requiring client-side reordering" ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_6> ] ;
    narr:run "07231af2a46e" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
    narr:writer "google/gemini-3.7-flash" .
}