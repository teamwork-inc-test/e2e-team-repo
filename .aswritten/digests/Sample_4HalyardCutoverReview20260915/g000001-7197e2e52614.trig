    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ;
    narr:keyPhrase [ narr:text "On the eighth I said the soak between sites has to be two full weeks, and I said I'd hold us to it. That was wrong." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:keyPhrase [ narr:text "Two weeks was two reconciliation cycles. It was never about the site settling." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:keyPhrase [ narr:text "Strip the reconciliation cycles out of the Dockside curve and the underlying exception rate is flat by day four." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:keyPhrase [ narr:text "the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:keyPhrase [ narr:text "That goes into the Clyde buffer." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_18> ] ;
    narr:variation [ narr:text "The correction is endorsed but costed: the old two weeks was cheap conservatism, the new one week is defensible with no slack in it — put on the record as tight, not safe." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:variation [ narr:text "The chair's counter-principle: defensible with known slack preferred over conservatism for an imaginary reason." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:variation [ narr:text "An open dependency: the sequencing rationale was already voiced externally that morning, backed by a better argument than either speaker had." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_12> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — sentences define positions by what they are not, with parallel clauses carrying the contrast" ; narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence over comfort — accuracy owned publicly even at cost" ; narr:text "Before we start on anything else, I need to correct something I said, and I'd rather do it at the top than bury it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_1> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority used sparingly — short invitations that hand the floor, then firm ratification" ; narr:text "Right. For the record then: the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — claims pinned to specific days and logs, abstractions only when pricing risk" ; narr:text "I quoted the Dockside number — the exception queue not flattening until day nine or ten." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "affect" ; narr:reading "calm-positive — appreciation expressed without drama" ; narr:text "Thank you for bringing it rather than letting it ride." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_23> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
