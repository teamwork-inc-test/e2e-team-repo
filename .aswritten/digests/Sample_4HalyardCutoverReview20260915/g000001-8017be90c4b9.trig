    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ;
    narr:keyPhrase [ narr:text "I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:keyPhrase [ narr:text "It was never about the site settling." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:keyPhrase [ narr:text "One week is the soak, and please don't hold the plan to two weeks on my say-so, because I was wrong on the eighth." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_9> ] ;
    narr:keyPhrase [ narr:text "One week is defensible but it has no slack in it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ] ;
    narr:keyPhrase [ narr:text "the soak between sites is one week, not two, and my note from the eighth about two weeks should be read as superseded by this." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_20> ] ;
    narr:keyPhrase [ narr:text "It would have come out at Northgate either way, and worse." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_24> ] ;
    narr:variation [ narr:text "The expert endorses the correction but registers its cost — the new soak is tight, not safe, with no slack in it." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_13> ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_15> ] ;
    narr:variation [ narr:text "The lead's counter-principle: defensible with known slack beats conservative for an imaginary reason — the trade is accepted, not resolved as costless." ; narr:over <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claims move to decisions through evidence — she retracts her own number and re-commits on corrected analysis" ; narr:text "I was wrong on the eighth and I want it struck from the plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_3> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "rational-persuasion — she argues from logs and mechanism, not position" ; narr:text "The reason the queue took nine days to flatten at Dockside is that the old reconciliation job ran weekly and every run threw a fresh batch of exceptions." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_5> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and dated — she anchors claims to specific past events and present state" ; narr:text "It was retired in July. Nothing in the new platform runs on a weekly cycle — reconciliation is continuous now." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_7> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence over comfort — accuracy outranks saving face" ; narr:text "I'd rather be defensible and know where the slack isn't than conservative for a reason that turned out to be imaginary." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_14> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — sentences name what something is by naming what it isn't" ; narr:text "Before we start on anything else, I need to correct something I said, and I'd rather do it at the top than bury it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_4HalyardCutoverReview20260915_1> ] ;
    narr:run "bf3d5510c624" ;
