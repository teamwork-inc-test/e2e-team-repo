    narr:generatedFrom "08dbf2d09d3a625ffd65c009778ee0a98c8715fd" ;
    narr:narration """This position disambiguates product identity from channel: the graph had deeply embedded the claim that [the product is a phone number](narr:Expr_3RealChannelNotProduct20260428_39), and the children here record its correction. Tanya frames the embedded claim as an artifact of a product experiment that [exposed an issue in the extraction process](narr:Expr_3RealChannelNotProduct20260428_7), then states the corrected principle: [the product is not a phone number; it's the phone number distribution channel](narr:Expr_3RealChannelNotProduct20260428_8). The replacement identity names [curated expertise installation as the product](narr:Expr_3RealChannelNotProduct20260428_9), with the phone number demoted to [one distribution channel among several](narr:Expr_3RealChannelNotProduct20260428_13) — specifically [a channel for contexts where the not-an-AI-chat trust signal justifies its operational cost, primarily enterprise](narr:Expr_3RealChannelNotProduct20260428_41). The correction is scoped as [a channel property, not a product identity](narr:Expr_3RealChannelNotProduct20260428_19). All children support the position; the tension is between the superseded tagline and its replacement, both retained here.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_12> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_19> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_39> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_41> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_7> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_9> ;
    narr:keyPhrase [ narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:keyPhrase [ narr:text "The product is curated expertise installation** — a way to install expertise into your AI and verify where it's coming from." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_9> ] ;
    narr:keyPhrase [ narr:text "The phone number / SMS is a distribution channel." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_12> ] ;
    narr:keyPhrase [ narr:text "The correction is about scope: it's a *channel property*, not a product identity." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_19> ] ;
    narr:keyPhrase [ narr:text "The product is a phone number." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_39> ] ;
    narr:variation [ narr:text "The superseded tagline 'the product is a phone number' remains in the graph's Identity section and is flagged as an extraction artifact — a reader reaching for it should treat it as corrected, not current." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_39> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_7> ] ;
    narr:variation [ narr:text "The channel isn't discarded but conditionally retained: enterprise contexts where the trust signal outweighs operational cost keep the phone number viable, qualifying any read of it as merely demoted." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_41> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — the sentence names what the thing is not before saying what it is" ; narr:text "The product is not a phone number; it's the phone number distribution channel, and it's the right distribution channel for certain contexts." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_8> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "moves from concrete claim to abstract principle — the correction is stated as a standing rule, not a one-off" ; narr:text "The correction is about scope: it's a *channel property*, not a product identity." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_19> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "abstract-present framing for the corrected identity, concrete-past when recounting how the error got embedded" ; narr:text "The phone number / SMS is a distribution channel." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_12> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "competence-valued — the product is defined by what it lets you verify, not by what it promises" ; narr:text "The product is curated expertise installation** — a way to install expertise into your AI and verify where it's coming from." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_9> ] ;
