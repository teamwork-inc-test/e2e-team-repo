    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_222> ;
    narr:keyPhrase [ narr:text "I'm raising 500k at this point to do a bridge round to get me to enough enterprise traction that I can do a true, you know, million seed." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_102> ] ;
    narr:keyPhrase [ narr:text "you are not raising. You're not trying to get someone to give you a check. You are creating a marketplace for as written." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_191> ] ;
    narr:keyPhrase [ narr:text "You use the howitzer when you have the ammunition." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_185> ] ;
    narr:keyPhrase [ narr:text "Hi, I am raising money. It is happening, right?" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_199> ] ;
    narr:keyPhrase [ narr:text "I would wait to do Emery Park." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_179> ] ;
    narr:keyPhrase [ narr:text "I'm doing the YC app this week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_222> ] ;
    narr:variation [ narr:text "The accelerator application is urged as high-value, low-cost optionality alongside — not inside — the staged process, a parallel road the marketplace framing doesn't cover." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_143> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_145> ] ;
    narr:variation [ narr:text "Sequencing tension: the founder is raising a bridge now, while the process advice says hold the big-name investor and documents until a term sheet exists." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_102> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_179> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_209> ] ;
    narr:variation [ narr:text "An aside pulls against single-track commitment: keeping consulting work open as optionality in case the venture doesn't happen." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_145> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
