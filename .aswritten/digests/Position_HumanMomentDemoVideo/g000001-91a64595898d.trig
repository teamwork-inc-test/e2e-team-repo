    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_16> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_18> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_8> ;
    narr:keyPhrase [ narr:text "The hero video is a human moment, not a screen recording." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ] ;
    narr:keyPhrase [ narr:text "Don't make people read text in a video." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_14> ] ;
    narr:keyPhrase [ narr:text "The human moment sells, not the text." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_18> ] ;
    narr:keyPhrase [ narr:text "4. The expert's reaction — \"whoa, that's my methodology\"" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_16> ] ;
    narr:variation [ narr:text "The five-beat format is still irrealis/future — a sketched template, not a produced or validated video; the principle outruns the evidence." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_16> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ] ;
