    narr:keyPhrase [ narr:text "A site goes live, it soaks, and only when the soak is clean do we start the next. No two cutovers running at once." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_7> ] ;
    narr:keyPhrase [ narr:text "It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:keyPhrase [ narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:keyPhrase [ narr:text "The one I gave was about data drift and the one Tanya gave was about unbounded risk. Yours is a hard constraint." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_15> ] ;
    narr:keyPhrase [ narr:text "The Dockside crew were visibly better on night two than night one, and that was the same night." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ] ;
    narr:keyPhrase [ narr:text "a commitment that a soak doesn't get shortened because a date slipped" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:variation [ narr:text "Freya concedes the sequencing would hold even with ample staffing, but less strongly — the learning argument is softer than the staffing one she'd put to the steering group." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:variation [ narr:text "Three distinct grounds for the same decision coexist — staffing arithmetic, learning-curve benefit, and technical rule assumptions — and Xavier flags that going parallel would require rewriting the replica and reference-data rules." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first — she defines a thing by naming what it is not" ; narr:text "It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "moves from decision-framing to hard-claim register when grounding the constraint" ; narr:text "One site at a time is the only sequencing my rota can actually produce people for." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "persuades by laying out operational facts rather than pulling rank" ; narr:text "Two cutovers in the same week means eight of eleven are on cutover duty" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_11> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "weights competence built through experience over plans on paper" ; narr:text "That's worth something you won't see in a plan." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "asks as a peer even when holding a hard line" ; narr:text "The dates, as early as you can give them, and a commitment that a soak doesn't get shortened because a date slipped." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
