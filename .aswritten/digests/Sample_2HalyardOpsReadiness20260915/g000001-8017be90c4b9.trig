    narr:keyPhrase [ narr:text "A site goes live, it soaks, and only when the soak is clean do we start the next. No two cutovers running at once." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_7> ] ;
    narr:keyPhrase [ narr:text "I can't staff that. It isn't that it's hard, it's that the people don't exist." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_12> ] ;
    narr:keyPhrase [ narr:text "Last week you were arguing it as risk. I'm telling you it's arithmetic. One site at a time is the only sequencing my rota can actually produce people for." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ] ;
    narr:keyPhrase [ narr:text "The replica rule and the reference-data rule both assume one cutover window open at a time — I hadn't stated that assumption, and it's worth stating." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:keyPhrase [ narr:text "The dates, as early as you can give them, and a commitment that a soak doesn't get shortened because a date slipped." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ] ;
    narr:variation [ narr:text "Sequencing rationale split between hard supervisory rota capacity and operational learning curves across sites." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_14> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_18> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_22> ] ;
    narr:variation [ narr:text "Underlying cutover architecture assumes serial execution rather than parallel rollout resilience." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ] ;
    narr:variation [ narr:text "Schedule slip risk threatening soak durations versus firm commitments to preserve operational soak windows." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_28> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_29> ] ;
