  <https://aswritten.ai/narrative#Digest_Narrative_DecisionsEvaporate> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Narrative_DecisionsEvaporate> ;
    narr:childCount "2"^^xsd:integer ;
    narr:generatedFrom "3399bcebb6c58381f3ac26d0f981987daa1e78c0" ;
    narr:narration """This narrative is defined by negation and by one forward commitment: [real-time chat as the named anti-pattern](narr:Position_AntiPatternRealtimeChat), against which the product is explicitly positioned, and [context preservation — linking decisions to the threads that produced them](narr:Position_ContextPreservationNextSprint), set as the next sprint's focus on the strength of beta-user demand. The arc runs from what the product is not toward what it will do next.""" ;
    narr:covers <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ;
    narr:covers <https://aswritten.ai/narrative#Position_ContextPreservationNextSprint> ;
    narr:keyPhrase [ narr:text "Real-time chat (Slack, Teams) is the named anti-pattern." ; narr:phraseSource <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ] ;
    narr:keyPhrase [ narr:text "linking decisions to the discussion threads that produced them" ; narr:phraseSource <https://aswritten.ai/narrative#Position_ContextPreservationNextSprint> ] ;
    narr:keyPhrase [ narr:text "Identified as the #1 request from beta users." ; narr:phraseSource <https://aswritten.ai/narrative#Position_ContextPreservationNextSprint> ] ;
    narr:variation [ narr:text "The narrative holds a definitional tension: it is anchored by what it rejects (real-time chat) as much as by what it commits to (context preservation)." ; narr:over <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ; narr:over <https://aswritten.ai/narrative#Position_ContextPreservationNextSprint> ] ;
    narr:moved "true"^^xsd:boolean ;
