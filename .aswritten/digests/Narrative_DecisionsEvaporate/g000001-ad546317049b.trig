    narr:variation [ narr:text "The anti-pattern framing and the thread-linking sprint focus pull in opposite directions — the product defines itself against chat while its top user request reaches into chat's home ground." ; narr:over <https://aswritten.ai/narrative#Position_AntiPatternRealtimeChat> ; narr:over <https://aswritten.ai/narrative#Position_ContextPreservationNextSprint> ] ;
