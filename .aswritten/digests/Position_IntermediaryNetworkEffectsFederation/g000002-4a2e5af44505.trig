    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_113> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_115> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_117> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_119> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_121> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_125> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_127> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_128> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_133> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_157> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_158> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_12> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_13> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_15> ;
    narr:covers <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_16> ;
    narr:keyPhrase [ narr:text "One of my operating theses is the telephone company always wins." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_12> ] ;
    narr:keyPhrase [ narr:text "The marginal cost of software development is asymptotically approaching zero." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_105> ] ;
    narr:keyPhrase [ narr:text "I want to have as written because you have as written and that makes my as written more valuable because you have it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_16> ] ;
    narr:keyPhrase [ narr:text "the question about how do you do federation across different organizations graphs in a way that is secure and managed" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_158> ] ;
    narr:keyPhrase [ narr:text "you are giving the incumbents the idea like of what to make because they already have the network" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_115> ] ;
    narr:variation [ narr:text "The thesis is hedged, not asserted as destiny — the speaker concedes the commodity players 'might' survive and frames the moat question as open ('I don't know')" ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_117> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_109> ] ;
    narr:variation [ narr:text "The incumbent-protection argument cuts both ways: switching costs shield incumbents, yet the same speaker warns incumbents can disintermediate newcomers once they copy the idea" ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_113> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_115> ] ;
    narr:variation [ narr:text "The federation mechanism is explicitly speculative spitballing with unresolved permissioning and access questions, not a settled design" ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_128> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_158> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
}