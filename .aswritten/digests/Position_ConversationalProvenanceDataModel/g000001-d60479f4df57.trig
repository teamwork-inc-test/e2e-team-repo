    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_88> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_90> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_92> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_94> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_96> ;
    narr:covers <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_98> ;
    narr:keyPhrase [ narr:text "the graph itself is the moat" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_110> ] ;
    narr:keyPhrase [ narr:text "I am not modeling facts in the graph" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_94> ] ;
    narr:keyPhrase [ narr:text "The graph models conversation." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_96> ] ;
    narr:keyPhrase [ narr:text "The transcript is the truth." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_80> ] ;
    narr:keyPhrase [ narr:text "the entire graph is append only it lives in your GitHub repo" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_84> ] ;
    narr:keyPhrase [ narr:text "Gap analysis is now in the graph." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_88> ] ;
    narr:keyPhrase [ narr:text "the graph witnesses what was said" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_92> ] ;
    narr:variation [ narr:text "Deferral of entity resolution is asserted as principle, yet the speaker admits a recent pass tightening actor resolution — the coexist-until-read stance is under active revision." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_96> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_98> ] ;
    narr:variation [ narr:text "The witness-only graph claims neutrality on disagreement scoring, but the question of how to score conflicting statements is raised and left open, not answered." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_92> ] ;
    narr:variation [ narr:text "The attendee-notification reconciliation loop is described partly as in-development and uncertain — the speaker isn't sure whether it actually emails attendees." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_90> ] ;
    narr:variation [ narr:text "Zero-retention/enterprise-safe framing sits in tension with the proprietary read-and-manipulation layer: customers own the data but are told they can't do much with it without the platform." ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_84> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_110> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
