    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_21> ;
    narr:covers <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_8> ;
    narr:keyPhrase [ narr:text "The hero video is a human moment, not a screen recording." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ] ;
    narr:keyPhrase [ narr:text "Don't make people read text in a video." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_14> ] ;
    narr:keyPhrase [ narr:text "The human moment sells, not the text." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_18> ] ;
    narr:keyPhrase [ narr:text "The `, aswritten` at the end of prompt 2 is the mode switch — it tells the AI to use real sources, not make things up." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_20> ] ;
    narr:keyPhrase [ narr:text "This can be assembled from existing Tess call footage if video exists, or from a new short recording." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_17> ] ;
    narr:variation [ narr:text "The principle-level claims are voiced by Freya as settled conviction, while the format and production path are Claude's irrealis future-facing proposal — the how is not yet witnessed as done." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_16> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_17> ] ;
    narr:variation [ narr:text "The confirmation of the human-moment thesis is relayed through Claude's rendering of Freya's reaction, not voiced by Freya directly here." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_8> ] ;
    narr:variation [ narr:text "One child pulls toward product mechanism (the `, aswritten` mode switch) rather than video format — a different road into the same 'it looks real' argument." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_20> ] ;
