    narr:keyPhrase [ narr:text "The hero video is a human moment, not a screen recording." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ] ;
    narr:keyPhrase [ narr:text "Don't make people read text in a video." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_14> ] ;
    narr:keyPhrase [ narr:text "The human moment sells, not the text." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_25> ] ;
    narr:keyPhrase [ narr:text "The `, aswritten` at the end of prompt 2 is the mode switch — it tells the AI to use real sources, not make things up." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_20> ] ;
    narr:keyPhrase [ narr:text "The viewer learns what this means by seeing the output change." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_21> ] ;
    narr:keyPhrase [ narr:text "This can be assembled from existing Tess call footage if video exists, or from a new short recording." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_17> ] ;
    narr:variation [ narr:text "The strongest validation is relayed, not held firsthand: the expert's confirming reaction arrives through someone else's rendering, so the case rests on a witnessed retelling rather than the expert's own recorded words." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_8> ] ;
    narr:variation [ narr:text "The principle is voiced in two registers — the abstract antithesis ('human moment, not screen recording') versus the concrete five-beat production spec — and the format itself remains irrealis/future, not yet executed." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_15> ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_16> ] ;
