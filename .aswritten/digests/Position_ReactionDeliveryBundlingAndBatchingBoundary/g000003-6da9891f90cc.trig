    narr:generatedFrom "6da9891f90cce25018457b985bfc79ca59c4b513" ;
    narr:narration """This position holds that [reactions route through one bundle per run per person, not one message per skill](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_2), restated the next day as a [directive establishing reaction delivery policy](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2). The bundling window is bounded by [the bundle closing when the run closes, with a late skill waiting for the next run rather than sending on its own](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_3), narrated again in [Tina's pushback and the ruling on the batching window](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3). The boundary was chosen against a [rejected alternative of per-skill delivery with client-side collapsing](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_4), reported separately on both days in [the rejected architectural alternative](narr:Expr_2DeliveryRoutingRulingE2ESynthetic_5) and [the report of the rejected alternative](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4).""" ;
    narr:reaction """Nothing moved for this hub — the same ruling, pushback, and rejected alternative carry over from both days, and the prior narration still holds. The one new wrinkle: the second-day narration of [Tina's pushback and the ruling on the batching window](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3) carries [Tina's](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3) authority-ranking signal as relayed through [Tanya's](narr:Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3) rendering, so the dissent is witnessed secondhand rather than in her own voice — worth noting, not a shift.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:variation [ narr:text "Tina pushed back on the batching window; the close-at-run-close boundary was contested, not consensual — the ruling held against live dissent." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ; narr:over <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ] ;
    narr:variation [ narr:text "The rejected road not taken: per-skill delivery with client-side collapsing, framed as shifting the ordering problem onto the reader — still the standing alternative if run-close bundling proves too rigid." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ; narr:over <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first with parallel phrasing — the ruling names what it is by naming what it isn't" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "plain-spoken for the ruling itself, turning technical only when describing the rejected alternative" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority backed by rational persuasion — the ruling justifies, it doesn't just command" ; narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking in her own voice; the one dissent she narrates is relayed through her rendering of Tina, not held directly" ; narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ] ;
