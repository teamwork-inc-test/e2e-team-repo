    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "the bundle closes when\nthe run closes" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:keyPhrase [ narr:text "moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260926_1_DeliveryRoutingRulingE2ESynthetic_ha66ee8b3c008_4> ] ;
    narr:variation [ narr:text "the rejected per-skill-with-client-side-collapsing alternative is re-reported in every dated restatement, not dismissed once and dropped — it stays live as the road not taken" ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ; narr:over <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ; narr:over <https://aswritten.ai/narrative#Expr_20260924_2_DeliveryRoutingRulingE2ESyntheticAttempt2_haec961429483_4> ; narr:over <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ; narr:over <https://aswritten.ai/narrative#Expr_20260926_1_DeliveryRoutingRulingE2ESynthetic_ha66ee8b3c008_4> ; narr:over <https://aswritten.ai/narrative#Expr_20260928_1_DeliveryRoutingRulingE2ESynthetic_h801a6165fef3_4> ] ;
    narr:variation [ narr:text "the pushback that prompted the ruling is preserved as its own signed challenge rather than folded silently into the boundary it lost against" ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:variation [ narr:text "several restatements of the held boundary carry the authority relation as relayed rather than asserted firsthand — the hold is reported through someone else's framing, not spoken as the ruler's own stance in those instances" ; narr:over <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260924_2_DeliveryRoutingRulingE2ESyntheticAttempt2_haec961429483_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260926_1_DeliveryRoutingRulingE2ESynthetic_ha66ee8b3c008_3> ] ;
