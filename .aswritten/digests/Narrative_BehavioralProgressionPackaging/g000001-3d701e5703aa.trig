    narr:keyPhrase [ narr:text "1. **Interview → trial with perspective → Free** (you got interviewed, here's your perspective, free forever)" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_10> ] ;
    narr:keyPhrase [ narr:text "Each tier is a natural next step, not a paywall." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_11> ] ;
    narr:keyPhrase [ narr:text "The underlying error: the typology mixed two orthogonal axes — AI-fluency (tinkerer vs consumer) and distribution-motion (packager vs solo-practitioner) — and classified Tess on fluency only." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_39> ] ;
    narr:keyPhrase [ narr:text "Tess's Individual-tier placement is a relational arrangement, not a sales-validated pricing decision." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_45> ] ;
    narr:keyPhrase [ narr:text "The vast majority of her feedback is verbal and I just implement. She's the single most prolific beta tester and has had more feedback than anyone." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_54> ] ;
    narr:keyPhrase [ narr:text "Whether the underlying typology needs fixing (the fluency-vs-distribution axis collision that misclassified Tess may misclassify others too)." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_78> ] ;
    narr:variation [ narr:text "The pricing ladder presents tier placement as sales logic, but Tess's Individual placement is explicitly relational — a beta tester and fiancé, not a prospect — so the ladder's exemplar contradicts its own pricing narrative." ; narr:over <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_10> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_45> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_49> ] ;
    narr:variation [ narr:text "The typology's single-axis classification is challenged head-on: fluency and distribution-motion are orthogonal, and the misclassification may extend beyond Tess." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_34> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_39> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_78> ] ;
    narr:variation [ narr:text "Tess's non-payment is double-edged: it neither validates Individual pricing nor counts as rejected conversion — both readings are explicitly refused." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_49> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_50> ] ;
    narr:variation [ narr:text "The beta cohort record omits Tess despite her being the highest-volume feedback source — the graph's own record contradicts her actual role." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_51> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_52> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
