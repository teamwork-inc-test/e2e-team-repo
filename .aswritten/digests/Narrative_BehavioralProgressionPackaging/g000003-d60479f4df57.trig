    narr:keyPhrase [ narr:text "Each tier is a natural next step, not a paywall." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_11> ] ;
    narr:keyPhrase [ narr:text "The interview seeds the perspective; the user decides how far to take it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_12> ] ;
    narr:keyPhrase [ narr:text "The underlying error: the typology mixed two orthogonal axes — AI-fluency (tinkerer vs consumer) and distribution-motion (packager vs solo-practitioner) — and classified Tess on fluency only." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_39> ] ;
    narr:keyPhrase [ narr:text "The vast majority of her feedback is verbal and I just implement. She's the single most prolific beta tester and has had more feedback than anyone." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_54> ] ;
    narr:keyPhrase [ narr:text "The leaning is recorded; it is not yet a decision." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_50> ] ;
    narr:keyPhrase [ narr:text "they've been paying me $800 a month. And there's currently an MSA out for like, you know, six grand a month. That's in legal review." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_214> ] ;
    narr:variation [ narr:text "The typology's classification of the beta tester was corrected — fluency and distribution-motion were conflated, and the misclassification may extend to others." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_39> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_78> ] ;
    narr:variation [ narr:text "The exemplar's tier placement validates nothing: she is relational, not a paying prospect — but her non-payment also doesn't refute the tier above." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_49> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_50> ] ;
    narr:variation [ narr:text "An enterprise-only channel leaning exists but was explicitly left undecided — the leaning and the epistemic state are held apart." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_50> ] ;
    narr:variation [ narr:text "The beta tester's actual role — highest-volume feedback source — is absent from the perspective's own records, a gap between the ladder and its evidence base." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_51> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_52> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
