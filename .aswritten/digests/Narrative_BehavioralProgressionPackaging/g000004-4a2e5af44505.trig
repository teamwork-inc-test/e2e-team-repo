    narr:keyPhrase [ narr:text "The interview produces a perspective in a trial account." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_9> ] ;
    narr:keyPhrase [ narr:text "Each tier is a natural next step, not a paywall." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_11> ] ;
    narr:keyPhrase [ narr:text "The underlying error: the typology mixed two orthogonal axes — AI-fluency (tinkerer vs consumer) and distribution-motion (packager vs solo-practitioner) — and classified Tess on fluency only." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_39> ] ;
    narr:keyPhrase [ narr:text "The leaning is recorded; it is not yet a decision." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_50> ] ;
    narr:keyPhrase [ narr:text "they've been paying me $800 a month" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_214> ] ;
    narr:keyPhrase [ narr:text "It's not that enterprise isn't a good target. It's that the quote, enterprise plan isn't about enterprise. It's about the shape of the deployment and the needs of the organization." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_21> ] ;
    narr:variation [ narr:text "The typology's axis collision that misclassified Tess may misclassify others too — whether it needs fixing is left open." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_78> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_39> ] ;
    narr:variation [ narr:text "The enterprise-only SMS leaning is recorded but explicitly not a decision — the epistemic state is 'we don't know yet how this maps to tiers.'" ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_50> ] ;
    narr:variation [ narr:text "A B2C turn toward solo builders qualifies the enterprise-heavy ladder — 'more of a B2C product than a B2B product,' held as a notion, not a claim." ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_5> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_3> ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_4> ] ;
    narr:variation [ narr:text "Tess's placement validates nothing and invalidates nothing — her non-payment reflects relationship, not rejected conversion." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_49> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_50> ] ;
    narr:variation [ narr:text "Pricing confidence is unsettled at the top: the founder wonders whether team and enterprise pricing is 'too low' while pitching it." ; narr:over <https://aswritten.ai/narrative#Expr_6RealAdvisorCall20260728_2> ; narr:over <https://aswritten.ai/narrative#Expr_5RealXavierAndTanya60Mins20260720_100> ] ;
