    narr:keyPhrase [ narr:text "Each tier is a natural next step, not a paywall." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_11> ] ;
    narr:keyPhrase [ narr:text "The interview seeds the perspective; the user decides how far to take it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1RealFreyaPodcastSalesMotion20260323_12> ] ;
    narr:keyPhrase [ narr:text "the typology mixed two orthogonal axes — AI-fluency (tinkerer vs consumer) and distribution-motion (packager vs solo-practitioner) — and classified Tess on fluency only." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_39> ] ;
    narr:keyPhrase [ narr:text "She's the single most prolific beta tester and has had more feedback than anyone." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_54> ] ;
    narr:keyPhrase [ narr:text "Tess doesn't invalidate Professional-tier pricing either — her non-payment reflects relationship, not rejected conversion." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_50> ] ;
    narr:keyPhrase [ narr:text "I think SMS is something that we should offer only for the enterprise plan, because we have to provision numbers individually and manage them and so on and so forth." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ] ;
    narr:keyPhrase [ narr:text "The leaning is recorded; it is not yet a decision." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_50> ] ;
    narr:variation [ narr:text "The typology that anchors the pricing ladder misclassified its own exemplar — the fluency-vs-distribution axis collision may misclassify others too, and fixing it is an open question." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_39> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_78> ] ;
    narr:variation [ narr:text "The Individual-tier exemplar is relational, not sales-validated: she neither validates Individual pricing nor invalidates Professional — the ladder's behavioral logic is untested by her case." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_49> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_50> ] ;
    narr:variation [ narr:text "The highest-volume feedback source is absent from the perspective's own beta-cohort record — the narrative's evidence base has a named hole." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_51> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_52> ] ;
    narr:variation [ narr:text "An enterprise-only SMS leaning exists but was explicitly not made a decision — channel-to-tier mapping is deliberately undecided." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_46> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_47> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_50> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
