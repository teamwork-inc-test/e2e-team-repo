    narr:childCount "5"^^xsd:integer ;
    narr:generatedFrom "6f2b393ccafd3c0367c68373020a1780ba9bc4f6" ;
    narr:narration """A dated record of a delivery-routing ruling. It opens with [the reviewers on record](narr:Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_1), then [Tanya's framing of the ruling](narr:Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_2) and [the policy itself, in her words](narr:Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_3). [Tina's pushback on the batching window, and Tanya holding](narr:Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_4) qualifies the arc, and [the rejected per-skill alternative](narr:Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_5) closes it.""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_5> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_3> ] ;
    narr:keyPhrase [ narr:text "the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_4> ] ;
    narr:keyPhrase [ narr:text "per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_5> ] ;
    narr:variation [ narr:text "Tina pushed back on the batching window; Tanya held the ruling rather than revising it." ; narr:over <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_4> ] ;
    narr:variation [ narr:text "The rejected alternative — per-skill delivery with client-side collapsing — remains the road not taken, argued as shifting the ordering burden to the reader." ; narr:over <https://aswritten.ai/narrative#Expr_20261004_1_DeliveryRoutingRulingE2ESynthetic_h88863a36af14_5> ] ;
    narr:run "8f0bc4a74e75" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
