    narr:generatedFrom "ad546317049bec4a37dc2ef52738f037aeed11f4" ;
    narr:narration """This call opens with [Tanya's framing of the ruling](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_1), then [the rule itself: per-run bundles stay, Fridays add one weekly roll-up](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_2). [Tina's relayed question](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_3) — whether the roll-up replaces the bundle — is answered by [Tanya's distinction: bundle for the run, roll-up for the week](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_4). The call closes on [the rejected daily-digest alternative](narr:Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_5).""" ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_4> ;
    narr:covers <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_5> ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_2> ] ;
    narr:keyPhrase [ narr:text "Tina asked whether the roll-up replaces the per-run bundle." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_3> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_4> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_5> ] ;
    narr:variation [ narr:text "Tina's question — does the roll-up replace the bundle — is the live alternative the ruling answers no to; the two-reporting-cadence reading holds, not a replacement." ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_4> ] ;
    narr:variation [ narr:text "A daily digest was explicitly rejected as redundant with the bundle — the road not taken, on record." ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_5> ] ;
    narr:run "1c8cca0793d3" ;
    narr:moved "true"^^xsd:boolean ;
    narr:diffBasis "first" ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
