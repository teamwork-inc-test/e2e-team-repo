  <https://aswritten.ai/narrative#Digest_Sample_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097> a narr:Digest ;
    narr:digestOf <https://aswritten.ai/narrative#Sample_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097> ;
