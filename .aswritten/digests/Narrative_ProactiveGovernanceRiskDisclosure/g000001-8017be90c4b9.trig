    narr:keyPhrase [ narr:text "I'll take that to the board as the open item rather than wait for them to find it." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_28> ] ;
    narr:keyPhrase [ narr:text "They'll forgive a hole. They won't forgive finding one." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_29> ] ;
    narr:variation [ narr:text "One child is a concrete forward commitment; the other is the abstract principle endorsing it — decision versus principle, not tension but differing registers of the same stance." ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_28> ; narr:over <https://aswritten.ai/narrative#Expr_6HalyardAdvisorTonyMaley20260929_29> ] ;
