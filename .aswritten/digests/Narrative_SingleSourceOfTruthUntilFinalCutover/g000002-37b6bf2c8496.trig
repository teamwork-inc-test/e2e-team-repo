    narr:voiceTrait [ narr:dim "value" ; narr:reading "conservation — protecting against loss outweighs early gain" ; narr:text "You find that out from a mis-priced consignment three weeks later." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_38> ] ;
