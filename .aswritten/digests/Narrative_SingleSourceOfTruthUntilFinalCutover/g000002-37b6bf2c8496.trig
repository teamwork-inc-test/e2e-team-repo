    narr:voiceTrait [ narr:dim "power" ; narr:reading "expert rational-persuasion doing the work, with legitimate authority closing the call in one line" ; narr:text "Then let's not go parallel." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ] ;
