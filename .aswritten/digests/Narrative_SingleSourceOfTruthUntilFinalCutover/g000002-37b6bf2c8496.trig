    narr:keyPhrase [ narr:text "The vendor stays the system of record for reference data until the last site is live." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "we take ownership on the day Clyde goes green and not a day earlier" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ] ;
    narr:keyPhrase [ narr:text "Keeping one source of truth through the whole programme is worth more than getting ownership early." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_38> ] ;
    narr:keyPhrase [ narr:text "Their data, their problem, right up until the end." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_39> ] ;
    narr:keyPhrase [ narr:text "If we ever went parallel, both of those would need rewriting." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ] ;
    narr:keyPhrase [ narr:text "Then let's not go parallel." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ] ;
    narr:variation [ narr:text "The rule rests on an unstated assumption — one cutover window at a time — that a parallel rollout would break, and the response was to foreclose parallel rather than rewrite the rule." ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_25> ; narr:over <https://aswritten.ai/narrative#Expr_2HalyardOpsReadiness20260915_26> ] ;
    narr:variation [ narr:text "The vendor's own agreement to remain system of record is nowhere recorded; the position is ratified internally only." ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_36> ; narr:over <https://aswritten.ai/narrative#Expr_1HalyardWeekly20260908_42> ] ;
