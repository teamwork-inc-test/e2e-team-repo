    narr:keyPhrase [ narr:text "Tess is a Knowledge Packager." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_38> ] ;
    narr:keyPhrase [ narr:text "She's on Individual because she's my fiancé and beta tester, not a sales target — although she fits the profile." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_44> ] ;
    narr:keyPhrase [ narr:text "Tess's Individual-tier placement is a relational arrangement, not a sales-validated pricing decision." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_45> ] ;
    narr:keyPhrase [ narr:text "Tess doesn't validate Individual-tier pricing, because she isn't a prospect" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_49> ] ;
    narr:keyPhrase [ narr:text "She's the single most prolific beta tester and has had more feedback than anyone." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_54> ] ;
    narr:keyPhrase [ narr:text "Main barrier is technical (MCP installation, GitHub abstraction), not behavioral." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_29> ] ;
    narr:variation [ narr:text "The work-motion archetype call sits against a separate, differently-labeled cohort naming raised for a channel-suitability question — the two archetype framings aren't reconciled here." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_38> ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_29> ] ;
    narr:variation [ narr:text "Pricing-evidence bound cuts both directions: she can't validate the Individual tier, but her non-payment also can't be read as rejecting the Professional tier." ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_49> ; narr:over <https://aswritten.ai/narrative#Expr_2RealTessChatWidget20260423_50> ] ;
    narr:variation [ narr:text "The channel question is posed and relayed, not settled — an open thread rather than a concluded axis like the other three." ; narr:over <https://aswritten.ai/narrative#Expr_3RealChannelNotProduct20260428_26> ] ;
