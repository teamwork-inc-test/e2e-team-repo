    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "Pushback on the batching window was voiced and held against — the bundle closes when the run closes, no side-channel sending." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_4> ] ;
    narr:variation [ narr:text "Two alternatives were considered and rejected with reasons: per-skill delivery with client-side collapsing, and a daily digest that would repeat the bundle." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "The replacement question — does the weekly roll-up supersede the per-run bundle — was raised repeatedly and answered no each time." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260929_1_WeeklyRollUpRulingE2EAgenticSynthetic_h94add5a10097_4> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claim-level in the daily log, but decision-level when ruling — she speaks holdings, not hedges" ; narr:text "the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority backed by reader-centered reasoning — the rule lands, then the why" ; narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking held under pushback — the boundary restated, not negotiated" ; narr:text "the bundle closes when\nthe run closes" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_3> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete present-tense realis in the daily log; shifts abstract and irrealis when stating the rule's scope" ; narr:text "Testing that omitted ref creates a topic branch." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1788169170042_1> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis with parallelism — the rule named, then named against what it is not" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "self-transcendence — the reader's burden is the stated ground for every ruling" ; narr:text "instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
