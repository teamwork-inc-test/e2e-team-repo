    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first with parallel clauses — the sentence names what it is not" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
