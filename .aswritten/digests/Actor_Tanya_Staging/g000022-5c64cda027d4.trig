    narr:keyPhrase [ narr:text "Testing that omitted ref creates a topic branch." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1788169170042_1> ] ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "The batching window drew pushback — relayed through this hub as another's claim, not held as their own" ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:variation [ narr:text "A rejected alternative — per-skill delivery with client-side collapsing — is recorded with its reason, a road not taken kept on the record" ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "The hub's long spine is verbatim repetition; the ruling cluster is a different register entirely — decision, authority, and value dims the repetition never carried" ; narr:over <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1790069073373_1> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-grade when ruling — states the call as settled policy, not opinion" ; narr:text "we route every reaction through one bundle per run per person" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete present-tense realis on the routine spine; shifts to abstract irrealis when setting policy" ; narr:text "Testing that omitted ref creates a topic branch." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1788169170042_1> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "rules from role authority — names the capacity, then decides" ; narr:text "Tanya (team owner) ruled on where reaction delivery belongs:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking — holds the line against pushback rather than negotiating it" ; narr:text "the bundle closes when\nthe run closes" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "technical and matter-of-fact when explaining a rejected design" ; narr:text "which moves the ordering problem onto the\nreader" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis with parallelism — names what it is not, then balances the pair" ; narr:text "not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "self-transcendence — the reader's load is the stated reason for the call" ; narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
