    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "Pushback within the ruling arc: the batching window was contested and the boundary held rather than negotiated — the dissent is recorded, not resolved by compromise." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ] ;
    narr:variation [ narr:text "A rejected alternative (per-skill delivery with client-side collapsing) remains on record as the road not taken, argued against on reader-burden grounds." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "A second rejected option — a daily digest — was ruled out as redundant with the per-run bundle, keeping the weekly roll-up the only added layer." ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "splits by role: plain claim-level assertion in the daily log, but decision-grade conviction the moment she rules — no hedged middle" ; narr:text "Tanya (team owner) ruled on where reaction delivery belongs:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-present-realis by default; shifts to abstract-future-irrealis exactly when stating a rule that binds forward" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority stated plainly, then argued by persuasion — she rules and then gives the reason" ; narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking when holding a boundary, but the ruling's content leans communal — the rule exists so nobody has to scroll back" ; narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260927_1_WeeklyRollUpRulingE2EAgenticSynthetic_hf65a0248bea8_2> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "plain-spoken for the rule itself, matter-of-fact and technical when recording what was rejected" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first with parallelism — the sentence names what it is by naming what it is not" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260928_1_DeliveryRoutingRulingE2ESynthetic_h801a6165fef3_2> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "self-transcendence throughout — every ruling is justified by what it saves the reader, not what it wins her" ; narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
