    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_1> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_3> ;
    narr:covers <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_4> ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261006_1_DeliveryRoutingRulingE2ESynthetic_h32018bb1d42b_4> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261006_1_DeliveryRoutingRulingE2ESynthetic_h32018bb1d42b_5> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_5> ] ;
    narr:variation [ narr:text "The batching window drew pushback, carried only as reported speech — the boundary was held, but the dissent survives only secondhand" ; narr:over <https://aswritten.ai/narrative#Expr_20261006_1_DeliveryRoutingRulingE2ESynthetic_h32018bb1d42b_4> ; narr:over <https://aswritten.ai/narrative#Expr_20261006_1_DeliveryRoutingRulingE2ESynthetic_h32018bb1d42b_5> ] ;
    narr:variation [ narr:text "An alternative architecture was considered and rejected — per-skill delivery with client-side collapsing — and remains recorded with its reason" ; narr:over <https://aswritten.ai/narrative#Expr_20261006_1_DeliveryRoutingRulingE2ESynthetic_h32018bb1d42b_5> ] ;
    narr:variation [ narr:text "A daily digest was rejected as redundant, a second road not taken alongside the per-skill alternative" ; narr:over <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_5> ] ;
    narr:variation [ narr:text "The scope question — whether the roll-up replaces the per-run bundle — keeps being asked and answered: the two are held apart, run versus week" ; narr:over <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_4> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-grade when ruling, plain claim when testing — the register splits cleanly between the two lanes" ; narr:text "Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260930_1_DeliveryRoutingRulingE2ESynthetic_h8da21f01f22b_5> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority backed by rational persuasion — the rule is stated as hers, then argued on the reader's behalf" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261006_1_DeliveryRoutingRulingE2ESynthetic_h32018bb1d42b_3> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking as the baseline, softening into communal-sharing when the rule serves the whole team" ; narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_2> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first parallelism — the sentence names what it is by naming what it is not" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-present for the test spine; rulings move between past-tense reporting and future-facing rules" ; narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_5> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "self-transcendence throughout — the rejected options are rejected for what they cost the reader" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261006_1_DeliveryRoutingRulingE2ESynthetic_h32018bb1d42b_5> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "formal in the ruling frames, plain-spoken in the rules themselves" ; narr:text "Tanya (team owner) ruled on how the week's reactions reach people:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20261007_1_WeeklyRollUpRulingE2EAgenticSynthetic_hed495c46f84c_1> ] ;
