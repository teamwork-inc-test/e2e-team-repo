    narr:keyPhrase [ narr:text "Testing that omitted ref creates a topic branch." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1788169170042_1> ] ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "Two registers coexist without resolution: the flat repeated test assertion versus a decisive owner ruling with reasoned rejection of an alternative — the hub is not one voice but a cadence plus a decision moment." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1790155536514_1> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:variation [ narr:text "Within the ruling, the held boundary (bundle closes with the run) sits against the recorded rejected alternative (per-skill delivery with client-side collapsing) — the road not taken is preserved, not erased." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "The pushback-and-hold exchange is relayed through another's rendering (signed by the pusher), so the firmness of the boundary is witnessed secondhand, not self-asserted." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "decision-grade when ruling, claim-grade when logging — she separates what she asserts from what she has settled" ; narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and realis by default; shifts to abstract-irrealis only when weighing alternatives" ; narr:text "Tanya (team owner) ruled on where reaction delivery belongs:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority stated plainly, backed by rationale rather than threat" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_4> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking — she holds the line when challenged rather than negotiating it" ; narr:text "Tina pushed back on the batching window" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "reader-serving self-transcendence — the justification is always the recipient's burden" ; narr:text "moves the ordering problem onto the\nreader" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first with parallel clauses — the sentence names what it is not, then what it is" ; narr:text "not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "plain-spoken in rulings, technical when recording rejected options" ; narr:text "per-skill\ndelivery with client-side collapsing" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
