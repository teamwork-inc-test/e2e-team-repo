    narr:keyPhrase [ narr:text "Testing that omitted ref creates a topic branch." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1788169170042_1> ] ;
    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "The daily test assertion is flat repetition with no development; the only substantive content is the late-September delivery-routing ruling, so the hub's weight sits almost entirely in two dated days." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1790155536514_1> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:variation [ narr:text "Within the ruling, the batching window was contested — pushback recorded and held against, with the per-skill alternative explicitly rejected rather than left open." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:variation [ narr:text "The held boundary is witnessed through a relayed rendering (signed by another principal), so the firmest stance in the hub is known secondhand rather than in her own words." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "claim-level assertion as the default habit, stepping up to outright decision only when ruling in an owner capacity" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete and present-tense in the everyday register; shifts to abstract, irrealis framing when weighing alternatives" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority stated plainly, backed by reasoning rather than insistence" ; narr:text "Tanya (team owner) ruled on where reaction delivery belongs:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking that folds into communal framing — the rule is justified by what serves the reader" ; narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "self-transcendence — decisions argued from the recipient's experience, not the system's convenience" ; narr:text "which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis and parallelism — the sentence names what it is not, then balances what it is" ; narr:text "not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
