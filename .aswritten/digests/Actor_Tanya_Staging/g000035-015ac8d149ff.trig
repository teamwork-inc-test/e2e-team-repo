    narr:keyPhrase [ narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:keyPhrase [ narr:text "Tina pushed back on the batching window and Tanya held: the bundle closes when\nthe run closes, and a skill that misses the close waits for the next run rather\nthan sending on its own." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ] ;
    narr:keyPhrase [ narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing, which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ] ;
    narr:keyPhrase [ narr:text "the per-run bundle stays, and on Fridays we add one roll-up of the week —\n> what moved, what is still open — instead of asking anyone to scroll back" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_2> ] ;
    narr:keyPhrase [ narr:text "Tanya held that it\ndoes not: the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:keyPhrase [ narr:text "Rejected: a\ndaily digest, because most days carry a single run and it would repeat the\nbundle word for word." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:variation [ narr:text "The dominant register is the repeated test assertion, but the ruling register argues in the opposite mode — decisions with reasons, pushback held, alternatives rejected — and the two never mix." ; narr:over <https://aswritten.ai/narrative#Expr_1E2EDefaultRef1788169170042_1> ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_2> ] ;
    narr:variation [ narr:text "Tina's pushback on the batching window is recorded only as relayed speech; the held boundary is the ruling's answer, not a resolved agreement." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_3> ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ] ;
    narr:variation [ narr:text "Two rejected alternatives sit alongside the rulings — client-side collapsing and a daily digest — roads not taken that a reader might still reach for." ; narr:over <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_5> ; narr:over <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_5> ] ;
    narr:voiceTrait [ narr:dim "conviction" ; narr:reading "splits cleanly by register — flat claim-level assertion in the daily log, firm decision-level rulings once she speaks as owner" ; narr:text "Tanya (team owner) ruled on where reaction delivery belongs:" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_2DeliveryRoutingRulingE2ESynthetic_1> ] ;
    narr:voiceTrait [ narr:dim "temporal" ; narr:reading "concrete-present for routine statements, but the rulings argue in abstract, forward-looking terms about how delivery should work" ; narr:text "we route every reaction through one bundle per run per person, not one\n> message per skill — a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_3DeliveryRoutingRulingE2ESyntheticAttempt2_2> ] ;
    narr:voiceTrait [ narr:dim "power" ; narr:reading "legitimate authority as the base, softened with rational-persuasion when she gives the reason for a rule" ; narr:text "a person should get one thing to read, not four" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_2> ] ;
    narr:voiceTrait [ narr:dim "relational" ; narr:reading "authority-ranking throughout — and notably, the pushback she answers is witnessed only through her own rendering of it" ; narr:text "Tina asked whether the roll-up replaces the per-run bundle." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_3> ] ;
    narr:voiceTrait [ narr:dim "style" ; narr:reading "antithesis-first with parallelism — the sentence names what it isn't, then balances what it is" ; narr:text "the bundle is for the run, the roll-up is for the week." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260925_1_WeeklyRollUpRulingE2EAgenticSynthetic_h5c24fdddd3e5_4> ] ;
    narr:voiceTrait [ narr:dim "value" ; narr:reading "self-transcendence — the reasons for her rules consistently land on the reader's burden, not her own" ; narr:text "which moves the ordering problem onto the\nreader." ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_2_DeliveryRoutingRulingE2ESyntheticAttempt2_haec961429483_4> ] ;
    narr:voiceTrait [ narr:dim "register" ; narr:reading "plain-spoken when ruling, technical when recording what was rejected, formal in the framing sentences" ; narr:text "The alternative considered and rejected was per-skill\ndelivery with client-side collapsing" ; narr:phraseSource <https://aswritten.ai/narrative#Expr_20260924_1_DeliveryRoutingRulingE2ESynthetic_hf8fb95c0b315_4> ] ;
    narr:writer "z-ai/glm-5.3-flash:nitro" .
